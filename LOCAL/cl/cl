#!/usr/bin/zsh

# Inline ansi
BOLD="\033[1m"
ITALIC="\033[3m"
RESET="\033[m"
REVERSE="\033[7m"
STRIKE="\033[9m"
UNDER="\033[4m"

BLACK_BG="\033[40m"

BLUE_FG="\033[34m"
CYAN_FG="\033[36m"
GREEN_FG="\033[32m"
MAGENTA_FG="\033[35m"
RED_FG="\033[31m"
WHITE_FG="\033[37m"
YELLOW_FG="\033[33m"

WHITE_ON_GREY="\033[0m\033[0;1;37;100m"
RED_ON_WHITE="\033[0m\033[0;1;31;107m"
RED_FG_I="${ITALIC}${RED_FG}"
GREEN_FG_I="${ITALIC}${GREEN_FG}"

# Declarations
typeset -a _LOCAL_FILES
typeset -a _PROD_DIRS=(/usr/local/bin /usr/local/lib ${HOME}/.local/bin ${HOME}/.local/share)

# Constants
_CODEBASE=~/Code
_LOCAL=${_CODEBASE}/LOCAL
_LANG=${_CODEBASE}/LANG
_PYPROJ=${_LANG}/Python/PROJECTS
_LOG=/tmp/cl.log
_SCRIPT=${0:t}

# Functions
get_prod () {
	local FN=${1}
	local EXELIST=("${(f)$(fut findexe ${FN:t})}")
	local F D
	local FX DX
	local PROD_EXE=''

	logit ${_LOG} "${0}: FN:${FN}"

	if [[ -e ${PWD}/.prod_target ]];then
		PROD_EXE="$(< ${PWD}/.prod_target)"
		logit ${_LOG} "${0}: returning PROD_EXE:${PROD_EXE}"
		echo ${PROD_EXE}
		return
	fi

	for F in ${EXELIST};do
		FX=$(tr '/' '_' <<<${F})
		for D in ${_PROD_DIRS};do
			DX=$(tr '/' '_' <<<${D})
			if grep -q ${DX} <<<${FX};then
				echo ${F}
				return
			fi
		done
	done
}

logit () {
	local LOG=''
	local MSG=''
	local STAMP=$(date +'%Y-%m-%d_%H:%M:')

	# Collect args
	[[ ${#} -gt 1 ]] && LOG=${1} && shift
	MSG=${@}

	if [[ -z ${LOG} ]];then # No log passed
		if [[ -n ${_LOG} ]];then
			LOG=${_LOG} # Log is defined
		else
			LOG=/tmp/${0}.log # Define default log
		fi
	fi

	echo "${STAMP} ${MSG}" >> ${LOG}
}

code_status () {
	local -a _LOCAL_FILES=()
	local LONGEST=0
	local PROD=''
	local F

	_LOCAL_FILES=()
	{
		LONGEST=0
		for F in ${PWD}/*;do
			[[ ${F:e} == 'bak' ]] && continue
			if [[ $(file ${F}) =~ 'zsh script' || ${F:e} == 'zsh' || ${F:e} == 'js' || ${F:e} == 'py' ]];then
				_LOCAL_FILES+=${F}
				[[ ${#F} -gt ${LONGEST} ]] && LONGEST=${#F:t}
			fi
		done
	} >/dev/null 2>&1
	(( LONGEST+=5 ))

	PROD=''
	if [[ -n ${_LOCAL_FILES} ]];then
		for F in ${_LOCAL_FILES};do
			logit ${_LOG} "${_SCRIPT}: F:${F}"
			PROD=$(get_prod ${F})
			logit ${_LOG} "${_SCRIPT}: PROD:${PROD}"
			if [[ -n ${PROD} ]];then
				if [[ ${F:t} == ${PROD:t} ]];then
					diff -b ${F} ${PROD} >/dev/null 2>&1
					if [[ ${?} -ne 0 ]];then
						printf "Development:${WHITE_FG}%-*s${RESET} ${BOLD}${RED_FG_I}%15s${RESET} Production:${WHITE_FG}%s${RESET}\n" ${LONGEST} ${F:t} 'does not match' ${PROD:t}
					else
						printf "Development:${WHITE_FG}%-*s${RESET} ${BOLD}${GREEN_FG_I}%8s${RESET} Production:${WHITE_FG}%s${RESET}\n" ${LONGEST} ${F:t} 'matches' ${PROD:t}
					fi
				fi
			fi
		done
	fi
}

usage () {
	tabs 5
	echo "\n${WHITE_FG}Usage${RESET}:${_SCRIPT} [-H] [<dir>]"
	echo "${WHITE_FG} Desc${RESET}:Change to development directory\n"
	echo "Directories searched:\n"
	echo "${_CODEBASE}"
	echo "${_LOCAL}"
	echo "${_LANG}"
	echo "${_PYPROJ}"
	echo
	exit
}

# Usage
[[ ${1} == '-H' ]] && usage

# Execution
# TODO: Inspect modification to always compare ~/Code/LOCAL to ${PROD}
[[ ${#} -gt 1 ]] && echo "${RED_FG}Too many args${RESET}" && usage
[[ ${#} -eq 0 ]] && ARG=${PWD:t} || ARG=${1}
logit ${_LOG} "${_SCRIPT}: PWD:${PWD} ARGS:${ARG}"

#[[ -z ${1} ]] && cd ${_CODEBASE}

if [[ -d ${_LOCAL}/${ARG} ]];then
	cd ${_LOCAL}/${ARG} 
elif [[ -d ${_LOCAL}/${(U)ARG} ]];then
	cd ${_LOCAL}/${(U)ARG} 
elif [[ -d ${_LANG}/${ARG} ]];then
	cd ${_LANG}/${ARG} 
elif [[ -d ${_LANG}/${(U)ARG} ]];then
	cd ${_LANG}/${(U)ARG} 
elif [[ -d ${_CODEBASE}/${ARG} ]];then
	cd ${_CODEBASE}/${ARG} 
elif [[ -d ${_CODEBASE}/${(U)ARG} ]];then
	cd ${_CODEBASE}/${(U)ARG} 
elif [[ -d ${_PYPROJ}/${ARG} ]];then
	cd ${_PYPROJ}/${ARG} 
	[[ -d venv ]] && cd venv
elif [[ -d ${_PYPROJ}/${(U)ARG} ]];then
	cd ${_PYPROJ}/${(U)ARG} 
	[[ -d venv ]] && cd venv
else
	echo "No development directory found:${WHITE_FG}${ARG}${RESET}"
	return
fi

code_status
