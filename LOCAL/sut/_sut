#compdef sut

_sut() {
    local context curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
		'1: :->cmds' \
		'-H[help]' \
		'-D[debug]' \
		'*::arg:->args'
    case "$state" in
        cmds)
		_values 'Commands:' \
		'autostart[List autostart apps in:]' \
		'cam[Enable/Disable onboard cam]' \
		'clearcups[Stop cupsd daemon, clear spool, restart daemon]' \
		'ddimage[Perform a low level (dd) copy of /dev/sda to /dev/sdb]' \
		'fan[Adjust fan settings]' \
		'info[No description]' \
		'last_install[Display details of last dpkg install]' \
		'journal[Show journal of last boot or shutdown]' \
		'kernel_cleaner[Clear any unused kernels]' \
		'log[Monitor or search ${LOG} entries]' \
		'lsdaemons[View current deamon processes]' \
		'lssc[View current systemd services]' \
		'mkinitscript[No description]' \
		'pkg_update[Set update flag for package]' \
		'ppamgr[No description]' \
		'pw_info[Show password and group details]' \
		'tstumask[Test a given/current umask]' \
		'updates[Show all dpkg activity for date range specified (day,month,year) or any grep-able keyword]' \
		'mime_defaults[Display mimetype default apps]' \
		'host_mac[Display mac address of host]' \
		;;
        args)
            case $line[1] in
                autostart) _do_autostart;;
                cam) _do_cam;;
                clearcups) _do_clearcups;;
                ddimage) _do_ddimage;;
                fan) _do_fan;;
                info) _do_info;;
                last_install) _do_last_install;;
                journal) _do_journal;;
                kernel_cleaner) _do_kernel_cleaner;;
                log) _do_log;;
                lsdaemons) _do_lsdaemons;;
                lssc) _do_lssc;;
                mkinitscript) _do_mkinitscript;;
                pkg_update) _do_pkg_update;;
                ppamgr) _do_ppamgr;;
                pw_info) _do_pw_info;;
                tstumask) _do_tstumask;;
                updates) _do_updates;;
                mime_defaults) _do_mime_defaults;;
                host_mac) _do_host_mac;;
            esac
            ;;
    esac
}

