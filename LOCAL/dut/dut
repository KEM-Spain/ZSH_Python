#--Begin GetOpts--
local -a OPTIONS
local OPTION
local K

read -r -d '' DESC<<EOF
Execute Disk Utilities
\t----------------------
$(for K in ${(k)_UTILS_DESC};do
	printf "\t${WHITE_FG}%s${RESET} - %s\n" ${K} ${_UTILS_DESC[${K}]}
done)
EOF

parse_opts () {
  local OPTS=${@}
  local -a OPTSTR
  local LETTER_OPT
  local O

  for O in {1..${#OPTS}};do
    [[ ${OPTS[${O}]} =~ '[A-Za-z]' ]] && LETTER_OPT=${OPTS[${O}]}
    [[ ${O} -eq 1 && ${OPTS[${O}]} == ":" ]] && continue
    [[ ${O} -gt 1 && ${OPTS[${O}]} == ":" ]] && OPTSTR+=$(opt_type ${LETTER_OPT}) && continue
    OPTSTR+="-${OPTS[${O}]}"
  done
  echo ${OPTSTR}
}

opt_exists () {
  local OPT=${1}
  [[ $(( $OPTIONS[(Ie)${OPT}] )) -ne 0 ]] && return 0 || return 1
}

opt_type () {
  local OPT=${1}
  case ${OPT} in
    u) echo "<UTIL>" ;;
  esac
}

usage () {
  local OPTS=$(parse_opts ${OPTSTR})
  local -a PENDING_MSGS=(${@})

  [[ ${_SMCUP} == 'true' ]] && do_rmcup

  (
    tabs 5
    echo -e "\n${WHITE_FG}\nUsage${RESET}: ${_SCRIPT} ${WHITE_FG}[${RESET}${OPTS}${WHITE_FG}]${RESET} $(opt_type u)\n"
    echo -e "${WHITE_FG}-H${RESET} help"
    echo -e "${WHITE_FG}-D${RESET} debug (repeats increase level)"
    echo -e "\n${WHITE_FG}\nDesc${RESET}:${DESC}"
  ) >&2

  exit_leave $(err_msg_exit ${PENDING_MSGS})
}

OPTSTR=":HD"
OPTIND=0

UTIL=''

while getopts ${OPTSTR} OPTION;do
  case $OPTION in
    H) usage ;;
    D) dbg_set_level ;;
    :) print -u2 "${RED_FG}${_SCRIPT}${RESET}: option: -${OPTARG} requires an argument"; usage ;;
    \?) print -u2 "${RED_FG}${_SCRIPT}${RESET}: unknown option -${OPTARG}"; usage ;;
  esac
  [[ ${OPTION} != 'D' ]] && OPTIONS+=${OPTION}
done
shift $(( OPTIND - 1 ))
#--End GetOpts--

# Execution
# This is detection of production mode called from another script (--prod will cancel smcup making it friendly to the caller)
g_PROD=false
g_OPTS="${@}"
[[ ${@} =~ '--prod' ]] && g_PROD=true && g_OPTS=$(sed -e 's/--prod//' <<<${g_OPTS} | str_trim)
[[ ${g_PROD} == 'false' && ${_DEBUG} -eq 0 ]] && do_smcup

[[ ${#} -ne 0 ]] && UTIL=${1}

[[ -n ${UTIL} && ${_UTILS[${UTIL}]} -ne 1 ]] && usage "command:${WHITE_FG}${UTIL}${RESET} not found"

if [[ -n ${UTIL} ]];then
  UTIL=${1}
  _SCRIPT=${UTIL}
  g_OPTS=(${(M)@:#-[a-zA-Z0-9]*}); g_ARGS=(${@:#-[a-zA-Z0-9]*})
  g_ARGS=$(sed "s/${_SCRIPT}//" <<<${g_ARGS} | str_trim)
  if [[ ${_UTILS[${UTIL}]} -eq 1 ]];then
    shift
    ${UTIL} ${g_OPTS} ${g_ARGS}
  fi
else
  sel_set_list ${(v)_UTILS_DESC}
  sel_list -sa -O ${CYAN_FG} -C -F"<w>Show Disk Utilities usage or <h>(q)uit<N>" -H"Disk Utilities"

  _SCRIPT=${(k)_UTILS_DESC[(r)${_SEL_VAL}]}
  do_rmcup
  ${_SCRIPT} -H # Call function help

  exit_leave
fi
