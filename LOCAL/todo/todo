#!/usr/bin/zsh

# Module Constants & Variables (Declarations & Initializations)
typeset _BOLD="\033[1m"
typeset _ITALIC="\033[3m"
typeset _RESET="\033[m"
typeset _REVERSE="\033[7m"
typeset _STRIKE="\033[9m"
typeset _UNDER="\033[4m"

typeset _BLACK_BG="\033[40m"

typeset _BLUE_FG="\033[34m"
typeset _CYAN_FG="\033[36m"
typeset _GREEN_FG="\033[32m"
typeset _MAGENTA_FG="\033[35m"
typeset _RED_FG="\033[31m"
typeset _WHITE_FG="\033[37m"
typeset _YELLOW_FG="\033[33m"

typeset _WHITE_ON_GREY="\033[0m\033[0;1;37;100m"

typeset _REC_DELIM=$'\x1e'
typeset _ITEM_DELIM=$'\x1f'

typeset -A _SOURCES=(
    [${PWD}]=PROD
    [/usr/local/bin]=PROD
    [/usr/local/bin/system]=PROD
    [/usr/local/lib]=PROD
    [${HOME}/Code/LOCAL]=DEV
)
typeset -A _SRC_CLR=(
    [PROD]=${_GREEN_FG}
    [DEV]=${_RED_FG}
    [PWD]=${_WHITE_ON_GREY}
)
typeset -a _ACTIVE_LABELS=()
typeset -A _ACTIVE_FILTERS=()
typeset -a _SORTED_ENTRIES=()
typeset -a _TODOS=()
typeset -a _MATCHES=()
typeset -a _CLEANED=()

typeset -A _OPT_LABELS=(
    [l]=PWD
    [p]=PROD
    [d]=DEV
)

typeset _DESC=""
typeset _ENTRY=""
typeset -i _FILTER_ACTIVE=0
typeset _FN=""
typeset _LABEL=""
typeset _L_LABEL=""
typeset _OUTPUT=""
typeset _PAYLOAD=""
typeset _REPORT_SCOPE=""
typeset _SC=""
typeset _SOURCE_DIR=""
typeset _TODO_ITEM=""
typeset _TRIMMED=""
typeset _TRIMMED_T=""
typeset _LIB_DIR=""
typeset _THIS="${0:t}"
typeset _M=""
typeset _F=""
typeset _JOINED_PAYLOAD=""
typeset _DIR_PATH=""
typeset _FILE_NAME=""
typeset -a _TODO_FILES=()
typeset -a _FIELDS=()
typeset -a _TODOS_ARR=()
typeset _K=""

# Imports
[[ -z "${ZSH_LIB_DIR}" ]] && _LIB_DIR="/usr/local/lib" || _LIB_DIR="${ZSH_LIB_DIR}"
source "${_LIB_DIR}/LIB_INIT.zsh"
_DEPS+=(STR.zsh)
source "${_LIB_DIR}/LIB_DEPS.zsh"

read -r -d '' _DESC<<EOF
Show list of TODO labels embedded in scripts
\tUse option -l to include PWD directories
\tUse option -p to include PROD directories
\tUse option -d to include DEV directories
\t(If no options are specified, all defined sources are included)
EOF

# Functions
usage() {
    typeset -a _PENDING_MSGS=()
    _PENDING_MSGS=(${@})

    [[ "${_SMCUP}" == 'true' ]] && do_rmcup

    tabs 5
    print -- "Usage: ${_SCRIPT} [-l] [-p] [-d] [-H]"
    print -- "${_WHITE_FG}\nDesc${RESET}:${_DESC}"

    exit_leave $(err_msg_exit ${_PENDING_MSGS})
}

# Parse Command Line Options dynamically
while getopts ":lpdaH" _OPT; do
  case "${_OPT}" in
    l|p|d)
      _ACTIVE_FILTERS[${_OPT_LABELS[${_OPT}]}]=1
      _FILTER_ACTIVE=1
      ;;
    H) usage ;;
    \?) usage "Invalid option: -${_OPTARG}" ;;
  esac
done
shift $((OPTIND -1))

clear
print -- "[${_WHITE_FG}${_THIS}${_RESET}] Searching for TODO items...\n"

# Scan sources, filter, find files, and pack with the known LABEL immediately
for _SOURCE_DIR in ${(k)_SOURCES};do
    _LABEL="${_SOURCES[${_SOURCE_DIR}]}"
    
    if (( _FILTER_ACTIVE == 1 ));then
        [[ -z "${_ACTIVE_FILTERS[${_LABEL}]}" ]] && continue
    fi

    # Retrieve file list for this source directory
    _TODO_FILES=("${(f)$(find ${_SOURCE_DIR} -maxdepth 2 ! -name '*.bak' -and ! -name '*.orig' 2>/dev/null)}")

    for _F in ${_TODO_FILES};do
      [[ -f "${_F}" ]] || continue
      
      # Explicitly skip the running script itself by checking absolute realpath equality
      [[ "${_F:A}" -ef "${0:A}" ]] && continue

      # Strict pattern: matches comment lines starting with optional whitespace, hash (#), 
      # optional comment symbols, followed by 'todo:' case-insensitively.
      _OUTPUT="$(grep -nEi '^[[:space:]]*#[[:space:]#]*todo:' "${_F}" 2>/dev/null)"

      if [[ -n "${_OUTPUT}" ]];then
        _MATCHES=("${(@f)_OUTPUT}")
        _CLEANED=()

        for _M in ${_MATCHES};do
          _TRIMMED="${_M## #}"
          _TRIMMED="${_TRIMMED%% #}"
          _CLEANED+=( "${_TRIMMED}" )
        done

        _DIR_PATH="${_F:h}"
        _FILE_NAME="${_F:t}"
        
        # Join multiple TODO lines safely using ITEM_DELIM via IFS expansion
        {
          local IFS="${_ITEM_DELIM}"
          _JOINED_PAYLOAD="${_CLEANED[*]}"
        }

        # Pack into sorting array separated by REC_DELIM:
        # LABEL \x1e DIRECTORY \x1e FILE_NAME \x1e PAYLOAD
        _SORTED_ENTRIES+=( "${_LABEL}${_REC_DELIM}${_DIR_PATH}${_REC_DELIM}${_FILE_NAME}${_REC_DELIM}${_JOINED_PAYLOAD}" )
      fi
    done
done

# Build the scope label for the header
if (( _FILTER_ACTIVE == 0 ));then
  _REPORT_SCOPE="ALL"
else
  for _L in ${(k)_ACTIVE_FILTERS};do
    _ACTIVE_LABELS+=( "${_L}" )
  done
  _REPORT_SCOPE="${(j:, :)_ACTIVE_LABELS}"
fi

[[ -z "${_SORTED_ENTRIES}" ]] && exit_leave "${_SCRIPT_TAG} No TODO items found"

# Generate the clean report with scoped header
print "=== TODO REPORT [Scope: ${_REPORT_SCOPE}] ==="

# Sort alphabetically by label using Zsh
for _LINE in ${(o)_SORTED_ENTRIES};do
  # Split the line using local IFS and Zsh word splitting (${=...})
  {
    local IFS="${_REC_DELIM}"
    _FIELDS=(${=_LINE})
  }
  
  _L_LABEL="${_FIELDS[1]}"
  _K="${_FIELDS[2]}"
  _FN="${_FIELDS[3]}"
  _PAYLOAD="${_FIELDS[4]}"
  
  # Grab the correct color for this label directly
  _SC="${_SRC_CLR[${_L_LABEL}]}"

  print -- "${_SC} ${_K}/${_FN}${_RESET}"

  # Unpack individual TODO items safely using local IFS word splitting
  {
    local IFS="${_ITEM_DELIM}"
    _TODOS_ARR=(${=_PAYLOAD})
  }
  
  for _TODO_ITEM in ${_TODOS_ARR};do
    _TRIMMED_T="${_TODO_ITEM## #}"
    _TRIMMED_T="${_TODO_ITEM## #}" # cleanup formatting
    print -- "   └── ${_TRIMMED_T}"
  done
  print -- ""
done

exit_leave
