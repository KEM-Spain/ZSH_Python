job_cancel () {
	job_kill
	logit ${_YT_DBG_LOG} "${0}: Job was reset"
}

job_kill () {
	local -a PIDS=()
	local PID
	local P

	PIDS=("${(f)$(pgrep -n "yt-dlp")}")
	if [[ ${?} -eq 0 ]];then
		for P in ${PIDS};do
			kill -9 ${P} >/dev/null 2>&1
			find /tmp -maxdepth 1 \( -name '*part' -or -name '*ytdl' -or -name '*.mp4*' \) -exec rm -rf {} \; # Clear any intermediate files
			logit ${_YT_DBG_LOG} "${0}: Killed ${P}"
			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0} killing ${P}"
		done
	fi

	if [[ ! ${functrace[1]} =~ "job_cancel" ]];then # Exit unless cancelled
		trap - INT # Disable trap
		log_clear "job_kill"
		exit_leave $(err_msg_exit "Operation cancelled")
	fi
}

job_retry () {
	local URL=${1}
	local TITLE=${2}

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	job_cancel && sleep .1
	logit ${_YT_DBG_LOG} "${0}: Job retry..."

	g_YTS_SESSION_LOG=$(job_start "${URL}")
}

job_start () {
	local URL=${1}
	local COOKIE_ARG=${2}
	local YTS_LOG="${_YT_DLP_CFG}/yts_${RANDOM}.log"
	local PID=0

	logit ${_YT_DBG_LOG} "Starting download for URL: ${URL} (Cookies: ${COOKIE_ARG:-none})"

	$(yt ${COOKIE_ARG} ${URL} ${YTS_LOG})

	logit ${_YT_DBG_LOG} "Logging to ${YTS_LOG}"

	g_YTS_SESSION_LOG=${YTS_LOG}
}

keyword_strip () {
	local LINE=''
	local W

	read LINE

	for W in ${_STRIP_WORDS};do # Scrub keywords
		LINE=$(sed "s/${W}//I" <<<${LINE})
		LINE=$(str_trim <<<${LINE})
	done

	LINE=$(sed -E "s/(^-|-$)//" <<<${LINE})
	echo ${LINE}
}

last_code_update () {
	local MARKER_ARG=${1}
	local LAST_UPD=0
	local LAST_TIME=0

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	[[ -z ${MARKER_ARG} ]] && exit_leave $(err_msg_exit "Missing argument:<MARKER>")

	if [[ -e ${MARKER_ARG} ]];then
		LAST_UPD="${(z)${(@s/ /)$(/usr/bin/stat -c "%y" ${MARKER_ARG})}[1]}"

		[[ -e ${MARKER_ARG} ]] && LAST_TIME=$(zstat -F "%H:%M" +mtime -- "${MARKER_ARG}")

		echo "$(date_since_today ${_TODAY} ${LAST_UPD}) at ${LAST_TIME}"
	fi
}

last_file_downloaded () {
	local ST=''
	local FN=''
	local IN=''

	ST=$(/usr/bin/stat -c"%W|%i|%n" ${_DOWNLOAD_DIR}/* | sort -t'|' -k1 -r | head -1) # Sort by birth date; grab most recent
	FN="${${(@s/|/)ST}[3]}"
	IN="${${(@s/|/)ST}[2]}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: FN:${FN} INODE:${IN}"

	if [[ -e ${FN} ]];then
		echo "${FN}|${IN}"
		return 0
	else
		return 1
	fi
}

log_add () {
	local NDX=${1}
	local LF=$(last_file_downloaded) # Filename|Inode
	local FN="${${(@s/|/)LF}[1]}"
	local IN="${${(@s/|/)LF}[2]}"
	local TL=$(get_field title ${NDX}) # Title
	local AT=$(get_field agetime ${NDX}) # Age
	local AU=$(get_field author ${NDX}) # Author
	local TM=$(sed -E 's/^.*ago\s+(.*)\)/\1/' <<<${AT}) # Video length

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	[[ ${FN:e} == 'part' || ${FN:e} == 'temp' ]] && return # Prevent partials in log

	echo "${IN}|${TL}|${FN:t}|${TM}|${AU}" >> ${_YTS_DOWNLOAD_LOG}
}

log_clear () {
	local FROM=${1}

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	[[ ! -e ${g_YTS_SESSION_LOG} ]] && return

	if [[ ${g_PRESERVE_LOG} == 'false' && ${_DEBUG} -eq 0 ]];then
		/bin/rm -f ${g_YTS_SESSION_LOG}
		msg_box -t2 "<w>Log was removed<N>"
		logit ${_YT_DBG_LOG} "${0}: Temp log file:${g_YTS_SESSION_LOG} was cleared for:${_QUERY_OPTS[QKEY]} from:${FROM}"
	else
		msg_box -t2 "<w>Log was preserved<N>"
		logit ${_YT_DBG_LOG} "${0}: ${g_YTS_SESSION_LOG} was retained for:${_QUERY_OPTS[QKEY]}"
	fi
}

log_find () { 
	local TOP=${1} # passed from LIST.zsh
	local BOT=${2} # passed from LIST.zsh
	local LINE_NUM=''
	local LIST_AU=''
	local LIST_TITLE=''
	local LIST_TM=''
	local LOG_AU=''
	local LOG_FN=''
	local LOG_LINE=''
	local LOG_TITLE=''
	local LOG_TM=''
	local R=0

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# Page callback - scan list to find downloaded items
	 
	_DOWNLOADS=()
	_PARTIALS=()

	for ((R=${TOP}; R <= ${BOT}; R++));do
		LINE_NUM=''

		LIST_TITLE=$(get_field title ${R}) # Title from list
		LIST_AU=$(get_field author ${R}) # Author from list
		LIST_TM=$(sed -E 's/^.*ago\s+(.*)\)/\1/' <<<$(get_field agetime ${R}) | tr -d '[()]' | sed 's/undefined//') # Video length from list

		[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "LIST_NDX:${R} LIST_TITLE:${LIST_TITLE} LIST_AU:${LIST_AU} LIST_TM:${LIST_TM}"

		if [[ -n ${LIST_TITLE[1,50]} ]];then
			[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Attempting TITLE match on:${LIST_TITLE[1,50]}"
			LOG_TITLE=$(grep -F -n -m1 -i -- ${LIST_TITLE[1,50]} ${_YTS_DOWNLOAD_LOG}) # grep -F option needed to ignore any special chars
			if [[ ${?} -eq 0 ]];then
				LINE_NUM="${${(@s/:/)LOG_TITLE}[1]}" # Fetch line number
				LOG_LINE=$(sed -n "${LINE_NUM}p" ${_YTS_DOWNLOAD_LOG}) # Fetch log line
				LOG_AU=$(grep -i -o -m1 "${LIST_AU}$" <<<${LOG_LINE}) # Match author in log line
				LOG_TM=$(grep -o ${LIST_TM} <<<${LOG_LINE}) # Match time in log line

				if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
					dbg "Matched:TITLE:${LOG_TITLE}"
					dbg "Log line:${LOG_LINE}"
					dbg "Author:${LIST_AU} Time:${LIST_TM}"
				fi

				if [[ -n ${LOG_TM} && -n ${LOG_AU} ]];then
					LOG_FN="${${(@s/|/)LOG_LINE}[3]}"
					_DOWNLOADS[${R}]=true

					if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
						dbg "Confirmed match: Marking NDX:${R} as downloaded for file:${LOG_FN}"
						dbg "LOG_AU:${LOG_AU}"
						dbg "LOG_TM:${LOG_TM}"
					fi
				else
					[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Failed to confirm download: LOG_TM:${LOG_TM} LOG_AU:${LOG_AU}"
				fi
			else
				[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "grep failed title match"
			fi
		else
			[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Skipped title search - blank title"
			logit ${_YT_DBG_LOG} "${0}: Skipped title search - blank title"
		fi
	done
}

