query_youtube () {
	local -A YOUTUBE_MAP=("age" 1 "author" 2 "title" 3 "url" 4 "time" 5)
	local -a FILTER_LIST=()
	local -a QUERY_LIST=()
	local -a WORK_LIST=()
	local AGE AUTHOR TITLE URL TIME AGETIME
	local DATA=false
	local DKEY=''
	local HIT=false
	local LINE=''
	local NDX=0
	local PROXY_CMD=''
	local QKEY=''
	local RETRIES=3
	local STR=''
	local STRICT_ARG=''
	local TRY=0
	local F L

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	ping -w1 www.youtube.com >/dev/null 2>&1
	[[ ${?} -ne 0 ]] && msg_box -p -PK "YouTube is down" && return 1

	if [[ ${_QUERY_OPTS[STRICT]} == 'strict' ]];then
		STR="is strict" && STRICT_ARG='-s'
	else
		STR="is not strict" && STRICT_ARG=''
	fi

	logit ${_YT_DBG_LOG} "${0}: Creating listing for QKEY:${_QUERY_OPTS[QKEY]}, query ${STR}"
	logit ${_YT_DBG_LOG} "${0}:\n_QUERY_OPTS:\n $(for K in ${(ok)_QUERY_OPTS};do printf '\t-> %s:%s\n' ${K} ${_QUERY_OPTS[${K}]};done)"

	g_PROXY_CMD="node ${_JS_SCRIPT} ${STRICT_ARG} -a ${_QUERY_OPTS[RANGE]} ${(qqq)_QUERY_OPTS[QKEY]}" # Quote key
	logit ${_YT_DBG_LOG} "${0}: g_PROXY_CMD:${g_PROXY_CMD}"

	if [[ ${_DEBUG} -ge ${_LOW_DBG} ]];then
		dbg "${0}:${LINENO} YOUTUBE QUERY:${CYAN_FG}_QUERY_OPTS[QKEY]${RESET}:${_QUERY_OPTS[QKEY]}, {CYAN_FG}g_PROXY_CMD${RESET}:${g_PROXY_CMD}"
	fi

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}:${LINENO} ${CYAN_FG}GENERAL SEARCH${RESET}"

	QUERY_LIST=()
	while true;do
		(( TRY++ ))
		QUERY_LIST=("${(f)$(eval ${g_PROXY_CMD} 2>/dev/null)}")
		[[ -n ${QUERY_LIST} && ${#QUERY_LIST} -gt 1 ]] && break
		[[ ${TRY} -gt ${RETRIES} ]] && break
		sleep .5
	done

	# TODO: decide how/when to eliminate videos that don't have authors that match the query key
	
	NDX=0
	FILTER_LIST=()
	for L in ${QUERY_LIST};do # Initial collection
		((NDX++))
		[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: Query line:${L}"

		[[ ${L:l} =~ 'matched' ]] && DATA=true && continue
		[[ ${L:l} =~ 'strict filter' ]] && continue
		[[ ${L:l} =~ 'usage' && ${DATA} != 'true' ]] && exit_leave
		[[ ${L:l} =~ 'error' && ${DATA} != 'true' ]] && exit_leave $(err_msg_exit E "${PROXY_CMD} returned an error")
		if [[ ${L:l} =~ 'strict reject' ]];then
			logit ${_YT_DBG_LOG} "${0}: Video:${TITLE} rejected - strict filter"
			continue
		fi

		STR=$(str_to_ascii <<<${L}) # Scrub non ascii
		STR=${STR:s/Streamed //} # Strip age of excess text

		FILTER_LIST+=${STR}
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}:${LINENO} _LOCAL_LIST count: ${#_LOCAL_LIST}"

	WORK_LIST=()
	for F in ${FILTER_LIST};do # Filter collection
		TITLE="${${(@s/|/)F}[${YOUTUBE_MAP[title]}]}"
		URL="${${(@s/|/)F}[${YOUTUBE_MAP[url]}]}"
		AGE="${${(@s/|/)F}[${YOUTUBE_MAP[age]}]}"
		TIME="${${(@s/|/)F}[${YOUTUBE_MAP[time]}]}"
		AGETIME="(${AGE} ${TIME})"
		AUTHOR="${${(@s/|/)F}[${YOUTUBE_MAP[author]}]}"; AUTHOR=$(keyword_strip <<<${AUTHOR}); AUTHOR=${AUTHOR:gs/\///}

		if [[ ! ${AGE} =~ [0-9] ]];then
			logit ${_YT_DBG_LOG} "${0}: Video:${TITLE} skipped - invalid age"
			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}:${LINENO} Video:${TITLE} skipped - invalid age"
			continue # Skip any videos not having valid age
		fi

		# Title translations
		if $(arr_in_array _TRANSLATED ${_QUERY_OPTS[QKEY]});then # Language problem workaraound - spanish titles
			if is_spanish ${TITLE:l};then
				msg_box -x24 "<w>Translating...<N>"
				TITLE=$(echo ${TITLE} | trans -brief -no-pager -no-ansi -no-theme es:en 2>/dev/null)
				logit ${_YT_DBG_LOG} "${0}: Translated TITLE:${TITLE}"
			fi
		fi

		WORK_LIST+="${AGE}|${AUTHOR}|${TITLE}|${URL}|${TIME}|${AGETIME}"
	done

	_LOCAL_LIST=(${WORK_LIST}) # Final collection

	if ! arr_is_populated "${_LOCAL_LIST}";then
		logit ${_YT_DBG_LOG} "${0}: Listing is empty - aborted"
		return 1 # Search failed
	fi

	logit ${_YT_DBG_LOG} "${0}: Listing for QKEY:${_QUERY_OPTS[QKEY]} contains ${#_LOCAL_LIST} rows"

	return 0
}

set_final_fn () {
	local AUTHOR=${1}
	local FN=${2}
	local NEW_FN=''

	logit ${_YT_DBG_LOG} "${0}: FN IN:${FN}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	NEW_FN=$(clean_title "${AUTHOR} - ${FN:t}") # Strip problematic chars
	NEW_FN=$(perl -pe 's/\.$//g' <<<${NEW_FN}) # Kill any trailing dots
	NEW_FN=$(str_word_clip ${NEW_FN} ${_MAX_FLEN}) # Limit length at word boundary
	NEW_FN="$(str_trim ${FN:h}/${NEW_FN}).${FN:e}" # Restore path and extension

	if [[ ${FN} != ${NEW_FN} ]];then
		[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: Saving changes:${FN:t} -> ${NEW_FN:t}"
		logit ${_YT_DBG_LOG} "${0}: Overwriting file:${FN:t}"
		logit ${_YT_DBG_LOG} "${0}: Clean filename:${NEW_FN:t}"
		mv -f "${FN}" "${NEW_FN}"
		[[ ${?} -ne 0 ]] && logit ${_YT_DBG_LOG} "${0}: Move failed ${FN} to ${NEW_FN}"
	fi

	logit ${_YT_DBG_LOG} "${0}: Directory:${NEW_FN:h}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: Cleaned:${FN:t}"
}

