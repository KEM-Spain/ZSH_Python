# Functions
action_do () {
	local -a ZSEL_REPLY=()
	local AUTHOR=''
	local COOKIE_FLAG=''
	local DEST_AUTHOR=''
	local DEST_TITLE=''
	local DL_CNT=0
	local DL_DIR=''
	local DUP_LINE=''
	local ERROR=''
	local ETA=''
	local FRAME_PAD=8
	local HDR1_TXT=''
	local HDR2_TXT=''
	local HDR_LEN=0
	local HRZ_CTR=0
	local INFO_TAG=''
	local INT_KEY=''
	local LAST_LOG_LINE=''
	local LAST_MSG=''
	local LAST_TRANS_MSG=''
	local LINE_COLOR=''
	local LOG_LINE=''
	local LOG_REPEATS=0
	local MAX_HDR=$(( _CONT_COORDS[W] - 15 ))
	local MSG=''
	local NDX=0
	local FUTURE_BROADCAST_ERR=''
	local RETRIED_COOKIES=false
	local RETRIES=0
	local TEXT=''
	local TITLE=''
	local TRANS_ERR_CNT=0
	local TRANS_ERR_MSG=0
	local URL=''
	local M X Y W

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	stty -echo # Prevent any keypresses from echoing to the term for the entire download action batch
	{
		for M in ${_MARKED};do
			((DL_CNT++))
			_QUICK_DOWNLOAD[${M}]=false
			_CANCELLED[${DL_CNT}]=false
			_DOWNLOADS[${DL_CNT}]=false
			_FAILED[${DL_CNT}]=false
			_FUTURE[${DL_CNT}]=false
			AUTHOR=$(get_field author ${M})
			TITLE=$(get_field title ${M})
			URL=$(get_field url ${M})
			RETRIES=0
			g_PRESERVE_LOG=false
			RETRIED_COOKIES=false
			COOKIE_FLAG=''

			logit ${_YT_URL_LOG} "${AUTHOR}:${TITLE}:${URL}"

			unsetopt localtraps # Initialize CTRL-C trap
			trap job_kill INT

			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: Starting job for:${URL}"
			job_start "${URL}" "${COOKIE_FLAG}"

			msg_box -t${_MSG_DELAY[LONG]} -O${CYAN_FG} -H1 -P"<w><I>Use key:<c>(<w>k<c>)<w> to <B><r>cancel<N><w> download<N>" -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} "<g>Download Requested...<N>"

			# Populate destination header info directly from the query results list
			DEST_AUTHOR=${${(s:|:)_LIST[${M}]}[2]}
			DEST_TITLE=${${(s:|:)_LIST[${M}]}[3]}

			logit ${_YT_DBG_LOG} "${0}: GENERATING HEADER"
			HDR1_TXT="${DEST_AUTHOR} - ${DEST_TITLE}"
			HDR1_TXT="<B><I><h>Downloading<N>: <f><w>$(clean_title ${HDR1_TXT} ${_MAX_HDR})<N>"
			HDR2_TXT="<B><I><h>Destination<N>: $(str_trim ${_DOWNLOAD_DIR})<N> - <w>${DL_CNT} <N>of <w>${#_MARKED}${INFO_TAG}"

			HDR_LEN=$(( ${#$(msg_nomarkup ${HDR2_TXT})} ))
			HDR_LEN=$(( HDR_LEN + FRAME_PAD ))
			HRZ_CTR=$(center -H -w${HDR_LEN})

			[[ ${HDR_LEN} -gt ${_CONT_COORDS[W]} ]] && _CONT_COORDS[W]=${HDR_LEN} && _CONT_COORDS[Y]=${HRZ_CTR}

			msg_box -C -O${CYAN_FG} -I -H3 -jl -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} ${HDR1_TXT}
			msg_box -C -jl ${HDR2_TXT}
			msg_box -C -jl "<c><SEP><N>"
			msg_box -C -jl "<B><c>Download started, waiting for log activity to begin...<N>"

			zmodload zsh/zselect # Live progress monitoring with zselect
			exec 3< <(tail -Fn0 "${g_YTS_SESSION_LOG}")

			# Border clearing coords
			X=$(( _CONT_COORDS[X] - 1 ))
			Y=${_CONT_COORDS[Y]}
			W=${_CONT_COORDS[W]}

			tcup ${X} ${Y};tput ech ${W} # Clear line over cont box
			X=$(( _CONT_COORDS[X] + _CONT_COORDS[H] ))
			tcup ${X} ${Y};tput ech ${W} # Clear line below cont box
			tcup $((++X)) ${Y};tput ech ${W} # Clear additional line 

			spinner start

			while true;do
				zselect -t 10 -a ZSEL_REPLY -r 3

				# Check keyboard input instantly on every loop iteration
				read -s -t0.01 -k1 INT_KEY 2>/dev/null
				if [[ ${INT_KEY} == 'k' ]];then
					spinner stop
					job_cancel
					logit ${_YT_DBG_LOG} "${0}: JOB CANCELLED during download"
					MSG="Cancelling download..."
					msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
					_CANCELLED[${M}]=true
					TRANS_ERR_CNT=0
					break
				fi

				# Early error, duplication, and anomaly detection checks integrated into single loop
				if grep -q -Ei -m1 'already been' ${g_YTS_SESSION_LOG} 2>/dev/null;then
					spinner stop
					logit ${_YT_DBG_LOG} "${0}: No download - video already exists"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>File was already downloaded...<N>"
					_CANCELLED[${M}]=true
					break
				fi

				FUTURE_BROADCAST_ERR=$(grep -Ei -m1 'will begin' ${g_YTS_SESSION_LOG} 2>/dev/null)
				if [[ ${?} -eq 0 ]];then
					spinner stop
					logit ${_YT_DBG_LOG} "${0}: No download - future broadcast"
					[[ ! ${FUTURE_BROADCAST_ERR:l} =~ 'minute*|hour*|day*' ]] && g_WHEN='soon' || g_WHEN=$(perl -pe 's/^(.*) in (\d+\s+\w+)(.*)$/\2/g' <<<${FUTURE_BROADCAST_ERR})
					MSG="<w>${TITLE[1,65]}<N>|<r><B>Not yet available<N> - Airing time:<w>${g_WHEN}<N>"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
					_FUTURE[${M}]=true
					break
				fi

				ERROR=$(grep -Ei -m1 '*http*403*|*http*404*|error' ${g_YTS_SESSION_LOG} 2>/dev/null)
				if [[ ${?} -eq 0 ]];then
					spinner stop && g_PRESERVE_LOG=true
					case ${ERROR} in
						403) if [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' && ${RETRIED_COOKIES} == 'false' ]];then
										RETRIED_COOKIES=true
										COOKIE_FLAG='-c'
										logit ${_YT_DBG_LOG} "${0}: Rumble 403 encountered - retrying with cookies (-c)"
										msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Retrying with cookies...<N>"
										job_cancel
										job_start "${URL}" "${COOKIE_FLAG}"
										continue
									else
										msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Got 403 error...<N>"
										logit ${_YT_DBG_LOG} "${0}: ERROR:${ERROR}"
										_FAILED[${M}]=true
										break
									fi
									;;
						404) msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Got 404 error...<N>"
								 logit ${_YT_DBG_LOG} "${0}: ERROR:${ERROR}"
								_FAILED[${M}]=true
								break
								;;
							*) msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Got download errors...<N>"
								 logit ${_YT_DBG_LOG} "${0}: ERROR:${ERROR}"
								_FAILED[${M}]=true
								break
								;;
					esac
				fi

				# Check log pipe activity (FD 3)
				if (( ${ZSEL_REPLY[(I)3]} ));then
					if read -u3 -r LOG_LINE;then

						MSG=$(str_word_clip ${LOG_LINE} ${_MAX_MSG_LEN})
						MSG="$(str_rpad ${MSG} ${_MAX_MSG_LEN})"

						if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then
							case ${LOG_LINE:l} in
								*merging*|*moving*|*fixing*)
									spinner stop
									logit ${_YT_DBG_LOG} "${0}: COMPLETED"
									_DOWNLOADS[${M}]=true
									log_add ${M}
									post_process ${DEST_AUTHOR}
									MSG="$(str_rpad "Download is complete" ${_MAX_MSG_LEN})"
									msg_box -C -jl "<B><g>${MSG}<N>"
									break
									;;
								*eta*|*cn:*|*mib*|*kib*)
									ETA=${LOG_LINE:l}
									case ${ETA} in
										*mib*) LINE_COLOR='<B><w>';;
										*kib*) LINE_COLOR='<B><y>';;
										*) LINE_COLOR='<B><r>';;
									esac
									msg_box -C -jl "${LINE_COLOR}${MSG}<N>"
									;;
							esac
						elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]];then
							case ${LOG_LINE:l} in
								*moving*|*fixing*)
									spinner stop
									logit ${_YT_DBG_LOG} "${0}: COMPLETED"
									_DOWNLOADS[${M}]='true'
									log_add ${M}
									post_process ${DEST_AUTHOR}
									MSG="$(str_rpad "Download is complete" ${_MAX_MSG_LEN})"
									msg_box -C -jl "<B><g>${MSG}<N>"
									break
									;;
								*size*|*eta*|*mib*|*kib*)
									ETA=${LOG_LINE:l}
									case ${ETA} in
										*mib*) LINE_COLOR='<B><w>';;
										*kib*) LINE_COLOR='<B><y>';;
										*) LINE_COLOR='<B><r>';;
									esac
									msg_box -C -jl "${LINE_COLOR}${MSG}<N>"
									;;
							esac
						fi
					fi
				fi

				# Tick the spinner continuously on every loop iteration
				spinner tick
			done
			exec 3<&-
			log_clear ${0}
			sleep 1 # Job request delay
		done # List complete

		for M in ${_MARKED};do
			[[ ${_DOWNLOADS[${M}]} == 'true' ]] && list_set_selected ${M} ${_STALE_ROW} || list_set_selected ${M} ${_AVAIL_ROW}
		done

		_MARKED=()
		trap - INT # Downloads are finished; cancel trap
	} always {
		stty echo
	}
	return 0
}

action_warn () {
	local M
	
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	msg_box -x$(( _CONT_COORDS[X] )) -H1 -p -PG "<w><I>Please respond<N>|<Z>|${#_MARKED} $(str_pluralize ${_OBJECT} ${#_MARKED}) selected"

	if [[ ${_MSG_KEY} == 'n' ]];then
		for M in ${_MARKED};do
			_MARKED[${M}]=0
			list_set_selected ${M} ${_AVAIL_ROW}
		done
	else
		msg_box_clear
	fi
}

cfg_init () {
	local CFG_STATE=0
	local -A CFG_MSGS=(1 "Missing configuration directory:${_YT_DLP_CFG}" 2 "Missing favorites file:${_YTS_FAVORITES}")

	[[ -d ${_YT_DLP_CFG} ]] && CFG_STATE=0 || CFG_STATE=1 # Dir exists
	[[ -f ${_YTS_FAVORITES} ]] && CFG_STATE=0 || CFG_STATE=2 # Favorites file found
	[[ -e ${_YT_DBG_LOG} ]] && /bin/rm -f ${_YT_DBG_LOG} # Kill old log
	logit ${_YT_DBG_LOG} "Logging started..." # Start fresh log

	echo ${CFG_MSGS[${CFG_STATE}]}

	return ${CFG_STATE}
}

clean_title () {
	local RAW_TITLE=${1}
	local MAX_HDR=${2:=${_MAX_TITLE}}
	local -a PARTS=()
	local HYPHEN_CNT=0
	local STR=''
	local TITLE=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: RAW_TITLE:${RAW_TITLE}"

	logit ${_YT_DBG_LOG} "${0}: RAW_TITLE:${RAW_TITLE}"

	TITLE=$(title_scrubber ${RAW_TITLE})
	logit ${_YT_DBG_LOG} "${0}: TITLE:${TITLE}"
	
	TITLE=$(keyword_strip <<<${TITLE})
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: Stripped keywords:${STR}"

	TITLE=$(str_word_clip ${TITLE} ${MAX_HDR}) # Limit length at word boundary

	logit ${_YT_DBG_LOG} "${0}: COMPLETED TITLE:${TITLE}"
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: TITLE:${TITLE}"

	echo ${TITLE}
}

download_select () {
	local SEARCHTERM=${1}
	local SEARCHTYPE=''
	local TITLE
	local FLST
	local STR
	local L F

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	_SORT_TABLE=(1 1 2 2 3 3) # Age, author, title
	if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then
		[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && SEARCHTYPE="Strict"
		SEARCHTYPE="${SEARCHTYPE}[${_QUERY_OPTS[RANGE]}]"
	else
		SEARCHTYPE=${_QUERY_OPTS[QTYPE]}
	fi

	# Set headings
	list_set_header_init
	list_set_header 'printf "Found:${WHITE_FG}%-d${RESET} $(str_pluralize video ${#_LIST})\tPlatform:${WHITE_FG}%s${RESET}\tQuery Key:${WHITE_FG}%s${RESET}\tQuery Type:${WHITE_FG}%s${RESET}\tSelected:${WHITE_FG}%s${RESET}\t${_PG}" ${#_LIST} ${(C)_QUERY_OPTS[ENGINE]} ${(C)SEARCHTERM} "${SEARCHTYPE}" $(list_get_selected_count)'
	list_set_header 'printf " "'
	list_set_header 'printf "%*s %-*s %-*s %-*s" 5 "" ${_FIELD_LEN[age]} "Age" ${_FIELD_LEN[author]} "Author" ${_FIELD_LEN[title]} "Title"'
	list_set_header 'printf "%*s ${SCOL1_CLR}%-*s${RESET} ${SCOL2_CLR}%*s${RESET} ${SCOL3_CLR}%*s${RESET}" 5 "" ${_FIELD_LEN[age]} "$(str_unicode_line ${_FIELD_LEN[age]})" ${_FIELD_LEN[author]} "$(str_unicode_line ${_FIELD_LEN[author]})" ${_FIELD_LEN[title]} "$(str_unicode_line ${_FIELD_LEN[title]})"'

	# Set line item
	list_set_line_item ' 
	local ITEM_COLOR=$(set_item_color $(item_decorate ${_LIST_NDX}));
	printf "${BOLD}${WHITE_FG}%4s${RESET}${_MARKER} ${SHADE}${BAR}${ITEM_COLOR}%-${_FIELD_LEN[age]}s${RESET}${SHADE}${BAR} %-${_FIELD_LEN[author]}s %-${_FIELD_LEN[title]}s${RESET}\n" ${_LIST_NDX} "$(item_decorate ${_LIST_NDX})"  "$(get_field author ${_LIST_NDX})"  "$(get_field title ${_LIST_NDX})"
	'
	list_set_select_action ${_ACTION}
	list_set_action_msgs video download
	list_set_sortable true
	list_set_searchable false
	list_set_barlines true
	list_set_page_callback log_find 
	list_set_sort_defaults ARRAY "_LIST" COL 1 ORDER "a" DELIM ${_LIST_DELIM} TYPE "flat" TABLE "${(kv)_SORT_TABLE}" MAXCOL 3

	while true;do
		# Generate list for selected title
		list_select ${_LOCAL_LIST}
		[[ ${?} -eq 0 ]] && break

		_MARKED=($(list_get_selected))
		
		if [[ $(list_get_selected_count) -ne 0 ]];then
			action_warn
			if [[ ${_MSG_KEY} == "y" ]];then
				action_do
			fi
			_LIST_SELECTED=()
		fi
	done

	_LOCAL_LIST=()
	_SORT_TABLE=()
	_CANCELLED=()
	_DOWNLOADS=()
	_FAILED=()
	_FUTURE=()
}

fav_add () {
	local FAV_ROW="${@}"

	msg_box -p -PC -H1 "Adding new favorite|KEY:${FAV_ROW:gs/|/\\|/}" # Escape delims
	if [[ ${_MSG_KEY:l} == "y" ]];then
		echo ${FAV_ROW} >> ${_YTS_FAVORITES} # Append new key to file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
		echo "\n${GREEN_FG}Key was added${RESET}"
	else
		echo "\n${RED_FG}Key was not added${RESET}"
	fi

	return 0
}

fav_delete () {
	local DKEY="${1}"
	local QUIET=${2:=false}
	local QKEY=''
	local FAV_ROW=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	FAV_ROW=$(grep -Ei "${DKEY:gs/ /_/:l}" ${_YTS_FAVORITES})
	if [[ ${?} -ne 0 ]];then
		msg_box -p -PK "Unable to locate favorite:${DKEY}"
		return 1
	fi

	if [[ ${QUIET} == 'false' ]];then
		msg_box -p -PC -H1 "<r>Deleting favorite<N>|Removing <w>${DKEY}<N>"
		[[ ${_MSG_KEY:l} != 'y' ]] && return 1
	fi

	QKEY=${${(s:|:)FAV_ROW}[1]}
	sed -i "/${QKEY}/d" ${_YTS_FAVORITES}

	if [[ ${?} -ne 0 ]];then
		[[ ${QUIET} == 'false' ]] && msg_box -p -PK "Unable to delete favorite:${DKEY}"
		return 1
	else
		[[ ${QUIET} == 'false' ]] && msg_box -p -PK "Deleted favorite:${DKEY}"
		return 0
	fi
}

fav_fields () {
	local FIELD=${1}
	local VALUE="${2:-}"

	# Fetch configuration string directly from global lookup array
	local CONFIG=${_FIELD_CONFIG[${FIELD}]}
	local -a CFG_ROW=("${(@s:|:)CONFIG}")
	local ORDER="${CFG_ROW[1]}"
	local F_TYPE="${CFG_ROW[2]}"
	local F_TITLE="${CFG_ROW[3]}"
	local F_TARGET="${CFG_ROW[4]}"
	local F_EXTRA="${CFG_ROW[5]}"
	local PRE_KEY="${CFG_ROW[6]}"
	local PRE_VAL="${CFG_ROW[7]}"
	local MENU_SEL=''
	local REAL_VAL=''
	local INPUT_VAL=''
	local CURRENT_VAL=''
	local REQUIRED_VAL=''
	local RC=0

	# Fixed Gating Check: Reads directly from _QUERY_OPTS associative array
	if [[ -n ${PRE_KEY} ]];then
		CURRENT_VAL="${_QUERY_OPTS[${PRE_KEY}]}"
		REQUIRED_VAL="${PRE_VAL}"
		if [[ ${CURRENT_VAL} != ${REQUIRED_VAL} ]];then
			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}: Gating check failed for ${FIELD}. Required ${PRE_KEY}=${REQUIRED_VAL}, got '${CURRENT_VAL}'"
			return 1
		fi
	fi

	case ${F_TYPE} in
		text) _fav_text_prompt "${F_TITLE}" "${VALUE}" ${_INLINE_BOX[X]} ${_INLINE_BOX[Y]}
					RC=${?}
					;;
		menu) _fav_menu_prompt "<w>${F_TITLE}<N>" "${F_EXTRA}"
					RC=${?}
					;;
	esac
	return ${RC}
}

fav_load () {
	local LINE=''
	local DVAL=''
	local QVAL=''
	local OPTS=''

	_FAV_LIST=()

	[[ ! -f ${_YTS_FAVORITES} ]] && return 1

	while read -r LINE;do
		QVAL=${${(s:|:)LINE}[1]}
		DVAL=${${(s:|:)LINE}[2]}
		OPTS=${${(s:|:)LINE}[3,-1]}
		_FAV_LIST[${QVAL}]="${(C)DVAL:s/_/ /}|${OPTS}"
	done < ${_YTS_FAVORITES}

	[[ -n ${_FAV_LIST} ]] && return 0 || return 1
}

fav_manage () {
	local MODE="${1}" # 'add' or 'edit'
	local -a FIELD_ORDER=()
	local -a OPT_LIST=()
	local -a MSG_LIST=()
	local -A _INLINE_BOX=(X 10 Y 65)
	local FIELD=''
	local RC=0
	local F I K

	if [[ ${MODE} == 'edit' ]]; then
		for F in ${(k)_QUERY_OPTS};do
			OPT_LIST+="<c>${F}<N>:<w>${_QUERY_OPTS[${F}]}<N>"
		done
		MSG_LIST=$(msg_list_bullet ${OPT_LIST})
		msg_box -p -PC -H1 "<c>Editing favorite<N>|Edit <w>${_QUERY_OPTS[DKEY]}<N>|<Z>${MSG_LIST}"
		[[ ${_MSG_KEY:l} != 'y' ]] && return 1
	fi

	# Dynamically sort keys based on the embedded order index
	FIELD_ORDER=(${(f)"$(for K in ${(k)_FIELD_CONFIG};do
	echo "${_FIELD_CONFIG[${K}]%%|*} ${K}"
	done | sort -n | cut -d' ' -f2)"})

	_FAV_KEYS=()
	for (( I = 1; I <= ${#FIELD_ORDER}; I++ )); do
		_INLINE_BOX[X]=$(( _INLINE_BOX[X] + I - 1 ))
		FIELD="${FIELD_ORDER[I]}"

		if [[ ${MODE} == 'edit' ]]; then
			fav_fields "${FIELD}" "${_QUERY_OPTS[${(U)FIELD}]}"
		else
			fav_fields "${FIELD}"
		fi

		RC=${?}
		if [[ ${RC} -ne 0 ]]; then
			break # Immediately stop processing remaining fields on quit/cancel
		fi

		case ${FIELD} in
			qkey)
				if [[ ${MODE} == 'add' ]]; then
					grep -Fiq "${_FAV_VALUE}|" ${_YTS_FAVORITES}
					if [[ ${?} -eq 0 ]]; then
						msg_box -p -PK "Query key must be unique"
						(( I-- ))
						continue
					fi
				fi
				_FAV_KEYS+=("$(str_trim "${_FAV_VALUE}")")
				;;
			dkey) _FAV_KEYS+=("$(str_trim "${_FAV_VALUE}")")
						;;
			list)
				_QUERY_OPTS[LIST]=${_FAV_VALUE}
				if [[ ${_FAV_VALUE} == 'youtube' ]];then
					_QUERY_OPTS[ENGINE]='youtube'
				elif [[ ${_FAV_VALUE} == 'rumble' ]];then
					_QUERY_OPTS[ENGINE]='rumble'
				elif [[ ${_FAV_VALUE} == 'custom' ]];then
					_QUERY_OPTS[ENGINE]=''
				fi
				;;
			engine) _QUERY_OPTS[ENGINE]=${_FAV_VALUE} ;;
			range)  _QUERY_OPTS[RANGE]=${_FAV_VALUE} ;;
			strict) _QUERY_OPTS[STRICT]=${_FAV_VALUE} ;;
			query)  _QUERY_OPTS[QTYPE]=${_FAV_VALUE} ;;
		esac
	done

	if [[ ${RC} -ne 0 ]]; then
		case ${MODE} in
			add) msg_box -t2 "<r>Add cancelled<N>";;
			edit) msg_box -t2 "<r>Edit cancelled<N>";;
		esac
		return 1
	else
		_FAV_ROW=($(fav_set_row "${_FAV_KEYS[1]:l:gs/ /_/}|${_FAV_KEYS[2]:gs/ /_/}"))
		case ${MODE} in
			add) fav_add "${_FAV_ROW}";;
			edit) fav_update "${_FAV_ROW}";;
		esac
		return 0
	fi
}

_fav_menu_prompt () {
	local TITLE="${1}"
	local TARGET_REF="${2}"
	local -a RAW_PAIRS=("${(@Pkv)TARGET_REF}") # Unpack keys and values from array
	local -A TARGET_MAP=("${RAW_PAIRS[@]}")
	local -a FORMATTED_ITEMS=()
	local K

	# Numerically sort keys using (ok) to guarantee rendering order
	for K in ${(ok)TARGET_MAP};do
		FORMATTED_ITEMS+=("${K}) ${(C)TARGET_MAP[${K}]}")
	done

	while true;do
		_MSG_KEY=''
		msg_box -c -H1 -p -PS -jl "${TITLE}|${(j:|:)FORMATTED_ITEMS}|or (Enter q to quit)"
		if [[ ${_MSG_KEY:l} == 'q' ]];then # Abort
			return 1
		fi

		if [[ -n ${_MSG_KEY} && -n ${TARGET_MAP[${_MSG_KEY:l}]} ]];then
			_FAV_VALUE="${TARGET_MAP[${_MSG_KEY:l}]}" # Assign return value
			break
		else
			msg_box -p -PK "No value was selected"
			msg_box_clear
			continue # Loop back to re-display the menu instead of returning 1
		fi
	done
	return 0
}

fav_parse_opts () {
	local FAV_ROW="${@}"
	local -a PARTS=()
	local LIST_TYPE=''
	local ENGINE_TYPE=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	PARTS=("${(@s:|:)FAV_ROW}")

	_QUERY_OPTS=()

	_QUERY_OPTS[QKEY]=${PARTS[1]}
	_QUERY_OPTS[DKEY]=${PARTS[2]}
	_QUERY_OPTS[DKEY]=${(C)_QUERY_OPTS[DKEY]:gs/_/ /}

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: FAV_ROW fields:${#PARTS}, QKEY:${_QUERY_OPTS[QKEY]}, DKEY:${_QUERY_OPTS[DKEY]}"

	LIST_TYPE=${PARTS[3]}
	if [[ ${LIST_TYPE} == 'y' ]];then
		_QUERY_OPTS[LIST]='youtube'
		_QUERY_OPTS[ENGINE]='youtube'
		[[ ${PARTS[4]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
		[[ -n ${PARTS[5]} ]] && _QUERY_OPTS[RANGE]=${PARTS[5]} || _QUERY_OPTS[RANGE]='recent'
	elif [[ ${LIST_TYPE} == 'r' ]];then
		_QUERY_OPTS[LIST]='rumble'
		_QUERY_OPTS[ENGINE]='rumble'
		_QUERY_OPTS[QTYPE]=${PARTS[4]}
	elif [[ ${LIST_TYPE} == 'c' ]];then
		_QUERY_OPTS[LIST]='custom'
		ENGINE_TYPE=${PARTS[4]}
		if [[ ${ENGINE_TYPE} == 'y' ]];then
			_QUERY_OPTS[ENGINE]='youtube'
			[[ ${PARTS[5]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
			[[ -n ${PARTS[6]} ]] && _QUERY_OPTS[RANGE]=${PARTS[6]} || _QUERY_OPTS[RANGE]='recent'
		elif [[ ${ENGINE_TYPE} == 'r' ]];then
			_QUERY_OPTS[ENGINE]='rumble'
			_QUERY_OPTS[QTYPE]=${PARTS[5]}
		fi
	fi
}

fav_select () {
	local -a C_LIST=()
	local -a R_LIST=()
	local -a Y_LIST=()
	local -a APP_KEYS=(a d e r y c w)
	local FTR=''
	local HDR=''
	local HDR_TAG=" <I>(Custom List)<N> "
	local LIST=''
	local MAP="(<w>r<N>)umble, (<w>y<N>)outube, (<w>c<N>)ustom, (<w>a<N>)dd, (<w>e<N>)dit, (<w>d<N>)elete" 
	local MENU_LBL=''
	local MENU_TYPE=''
	local OPTS=''
	local O_COLOR=''
	local QKEY=''
	local TAG=''
	local UNK_TYPE=''
	local L

	fav_load

	for L in ${(k)_FAV_LIST};do
		set_query_opts ${L}
		QKEY=${_QUERY_OPTS[QKEY]}
		case ${_QUERY_OPTS[LIST]} in
			custom) C_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			rumble) R_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			youtube) Y_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			*) UNK_TYPE=${_QUERY_OPTS[LIST]};;
		esac
	done

	if [[ -n ${UNK_TYPE} ]];then
		logit ${_YT_DBG_LOG} "Bad menu type:${MENU_TYPE} in ${_YTS_FAVORITES}"
		return 1
	fi

	while true;do
		case ${g_ACTIVE_FAV_MENU} in
			custom) LIST=(${C_LIST})
							O_COLOR=${GREEN_FG}
							HDR_TAG=" <I>(Custom List)<N> "
							;;
			rumble) LIST=(${R_LIST})
							O_COLOR=${MAGENTA_FG}
							HDR_TAG=''
							;;
			youtube) LIST=(${Y_LIST})
							O_COLOR=${CYAN_FG}
							HDR_TAG=''
							;;
		esac

		TAG="${_QUERY_OPTS[LIST]}.${g_ACTIVE_FAV_MENU}.query"
		HDR="<B><w>${(C)g_ACTIVE_FAV_MENU}${HDR_TAG} <B>Query<N>"
		FTR="Run <w>${(C)g_ACTIVE_FAV_MENU}<N> query, <w>(<N>s<w>)<N>how nav keys<N>, or <w>(<N>q<w>)<N>uit<N>"

		sel_set_app_keys ${APP_KEYS}
		sel_set_list ${LIST}

		msg_line_weight heavy
		sel_list -R -S -T${TAG} -O${O_COLOR} -H${HDR} -M${MAP} -F${FTR}
		msg_line_weight light

		if ! (( ${APP_KEYS[(I)${_SEL_VAL}]} ));then
			set_query_opts ${_SEL_VAL:gs/ /_/}
			QKEY=${_QUERY_OPTS[QKEY]}
		fi

		clear

		case ${_SEL_KEY} in
			w)
				msg_box -t2 "Opening YouTube and Rumble websites"
				open_website y
				open_website r
				_SEL_KEY=''
				return 2
				;;
			a)
				fav_manage add
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			d)
				fav_delete ${_SEL_VAL}
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			e)
				fav_manage edit
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			y) g_ACTIVE_FAV_MENU='youtube';;
			r) g_ACTIVE_FAV_MENU='rumble';;
			c) g_ACTIVE_FAV_MENU='custom';;
			*) break;;
		esac
	done

	return 0
}

fav_set_row () {
	local FAV_KEY="${1}"

	if [[ ${_QUERY_OPTS[LIST]} == 'youtube' ]];then
		FAV_KEY+="|y"
		[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
		FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'rumble' ]];then
		FAV_KEY+="|r"
		FAV_KEY+="|${_QUERY_OPTS[QTYPE]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'custom' ]];then
		FAV_KEY+="|c"
		if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then
			FAV_KEY+="|y"
			[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
			FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
		elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]];then
			FAV_KEY+="|r"
			FAV_KEY+="|${_QUERY_OPTS[QTYPE]}"
		fi
	fi

	echo "${FAV_KEY}"
}

_fav_text_prompt () {
	local TITLE="${1}"
	local VAL="${2}"
	local X_COORD="${3}"
	local Y_COORD="${4}"
	local INPUT_VAL=""

	while true;do
		INPUT_VAL=$(inline_vi_edit "${TITLE}" "${VAL}" ${X_COORD} ${Y_COORD}) # Collect user input
		if [[ -z "${INPUT_VAL}" ]];then # No input
			msg_box -p -PK "${TITLE} must be populated|Enter a value or (q)uit"
			msg_box_clear
			if [[ ${_MSG_KEY:l} == 'q' ]];then # Abort
				return 1
			fi
		else
			_FAV_VALUE="${INPUT_VAL}" # Assign return value
			break
		fi
	done
	return 0
}

fav_update () {
	local FAV_ROW="${@}"
	local K
	local -a LIST=()

	fav_parse_opts "${FAV_ROW}"

	LIST=("${(f)$(for K in ${(k)_QUERY_OPTS};do echo "${K}->${(qqq)_QUERY_OPTS[${K}]}";done)}")
	msg_box -p -PC -H1 "<c>Updating <w>${_QUERY_OPTS[DKEY]}<N>|$(msg_list_bullet ${(o)LIST})"

	if [[ ${_MSG_KEY:l} == "y" ]];then
		fav_delete ${_QUERY_OPTS[QKEY]} true
		echo ${FAV_ROW} >> ${_YTS_FAVORITES} # Update key in file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
		echo "\n${GREEN_FG}Key was updated${RESET}"
	else
		echo "\n${RED_FG}Key was not updated${RESET}"
	fi

	return 0
}

get_field () {
	local FIELD=${1}
	local NDX=${2}
	local -A FIELD_MAP=("age" 1 "author" 2 "title" 3 "url" 4 "time" 5 "agetime" 6)
	local STR=''
	local TSTR=''

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${FIELD} in
		age) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[age]}]}";;
		agetime) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[agetime]}]}";;
		author) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[author]}]}";;
		time) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[time]}]}";;
		title) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[title]}]}";;
		url) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[url]}]}";;
	esac

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${0}: Parsed FIELD:${FIELD} STR:${STR}"

	if [[ ${FIELD} == 'agetime' ]];then
		[[ ${STR:l} =~ 'views' ]] && STR=$(sed -E 's/^(.*views )(.*ago)(.*)/(\2)/' <<<${STR})
		[[ ${STR:l} =~ 'live' ]] && STR=$(sed -E 's/(.*ago)( live)(.*)/\1)/I' <<<${STR})
	fi

#	if [[ ${FIELD} == 'author' ]];then
#		if [[ ${_QUERY_OPTS[QKEY]} =~ ' ' ]];then # Query key contains a space
#			STR=$(str_trim <<<${STR})
#			[[ -z ${STR} ]] && STR=${(C)_QUERY_OPTS[DKEY]} # Ensure not blank
#		else
#			STR=${_QUERY_OPTS[DKEY]}
#		fi
#	fi

	if [[ ${FIELD} == 'title' ]];then
		STR=$(str_word_clip ${STR} ${_FIELD_LEN[${FIELD}]})
	fi

	if [[ -n ${_FIELD_LEN[${FIELD}]} ]];then
		STR=${STR[1,${_FIELD_LEN[${FIELD}]}]}
	fi

	echo -n ${STR}
}

is_spanish () {
  local INPUT="${1}"
  # Matches Spanish diacritics (á, é, í, ó, ú, ü, ñ, ¿, ¡) or top frequent Spanish words
  [[ "${INPUT}" =~ '[áéíóúüñ¿¡]' ]] || [[ "${INPUT}" =~ '\b(el|la|los|las|un|una|y|que|en|de|por|para|es|como)\b' ]] && return 0 || return 1
}

item_decorate () {
	local NDX=${1}
	local STR

	if [[ ${_DOWNLOADS[${NDX}]} == 'true' ]];then
		STR="Downloaded..."
	elif [[ ${_CANCELLED[${NDX}]} == 'true' ]];then
