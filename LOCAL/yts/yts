_parse_rumble () {
	local QRY=${1}
	local -a LIST=()
	local -a QDATA=()
	local -a ROW=()
	local AGE=''
	local AUTHOR=${_QUERY_OPTS[DKEY]}
	local CMD=''
	local DURATION=''
	local ERRS=''
	local LINE=''
	local NDX=0
	local SET=0
	local T3=0
	local TCNT=0
	local TEXT=''
	local TITLE=''
	local TNDX=0
	local U=0
	local URL=''
	local K L

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	{
	# Run query and filter known problem chars
	CMD="wget ${_WGET_OPTS} -q -O - "${(qqq)QRY}" | pup '[type="application/json"]' | grep -vw script | jq | sed -e 's/,$//' -e 's/|/#/g'"
	LIST=("${(f)$(eval ${CMD})}")
	} 2>/dev/null

	if ! arr_is_populated "${LIST}";then
		logit ${_YT_DBG_LOG} "Command failed: ${CMD} ${LIST}"
		return 1
	fi

	if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
		dbg "CREATED: yts.dbg"
		for L in ${LIST};do
			echo ${L}
		done > "$(date +%s)_yts_rumble.dbg"
	fi
	
	grep -q -m1 'locals_community' <<<${LIST}
	[[ ${?} -eq 0 ]] && TNDX=3 || TNDX=2 # Either sets of 3 titles or sets of 2

	for L in "${LIST[@]}";do
    LINE=${L:Q}
    TEXT="${LINE#*:}" # Discard everything before and including the first colon
    case ${LINE} in
      *relative_url:*) continue;;
      *url:*) [[ ${TEXT} =~ "\.html" ]] && QDATA+=${TEXT[2,-1]};; # Skip leading space
      *title:*)
        (( TCNT++ ))
        T3=$(( TCNT % TNDX ))
        # Double quote both the input parameter and the command substitution result
        [[ ${T3} -eq 0 ]] && QDATA+="$(fix_mojibake "${TEXT[2,-1]}")"
        ;;
      *duration:*) DURATION=$(_parse_rumble_duration ${TEXT});QDATA+=${DURATION};;
      *upload_date:*) D="${${(@s/T/)TEXT}[1]}";U=$(date -d "${D}" +%s);QDATA+=$(_parse_rumble_age ${U});;
    esac
  done

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "__DATA__\n$(for K in ${LIST};do echo ${K};done)\n__DATA__"

	SET=0
	for L in ${QDATA};do
		(( SET++ ))
		ROW+=${L}
		if [[ $(( SET % 4 )) -eq 0 ]];then # Groups of 4 rows
			if [[ ! ${ROW[4]} == *ago* ]];then
				logit ${_YT_DBG_LOG} "${0}: parse error (expected ago in ROW 4):${ROW[4]}"
				continue
			fi
			set_rumble_row ${ROW}
			ROW=()
		fi
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: _RUMBLE_ROWS:${#_RUMBLE_ROWS}"

	NDX=0
	for K in ${(onk)_RUMBLE_ROWS};do # Marshall final data
		(( NDX++ ))
		assign_vars 4 ${_RUMBLE_ROWS[${K}]} # URL TITLE DURATION AGE
		_LOCAL_LIST[${NDX}]="${V4}|${AUTHOR}|${V2}|${V1}|${V3}|(${V4} ${V3})"
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: _LOCAL_LIST:${#_LOCAL_LIST}"
}

_parse_rumble_age () {
	local SECS=${1}
	local	DTAG=days
	local	HTAG=hours
	local DAYS=0
	local HOURS=0
	local TODAY=$(date +%s)
	local STAMP=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	DAYS=$(( (TODAY - ${SECS}) / 86400 ))

	if [[ ${DAYS} -eq 0 ]];then
		HOURS=$(( (TODAY - ${SECS}) / 3600 ))
		[[ ${HOURS} -eq 1 ]] && HTAG=hour
		STAMP="${HOURS} ${HTAG} ago"
	else
		[[ ${DAYS} -eq 1 ]] && DTAG=day
		STAMP="${DAYS} ${DTAG} ago"
	fi

	echo ${STAMP}
}

_parse_rumble_duration () {
	local SECS=${1}
	local STAMP=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	STAMP=$(strftime "%H:%M:%S" ${SECS})
	[[ ${STAMP} =~ "^00:" ]] && STAMP="${STAMP#*:}" # Discard everything before and including the first colon

	echo ${STAMP}
}

