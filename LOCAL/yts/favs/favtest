#!/usr/bin/zsh

# Inline ansi
BOLD="\033[1m"
ITALIC="\033[3m"
RESET="\033[m"
REVERSE="\033[7m"
STRIKE="\033[9m"
UNDER="\033[4m"
BLINK="\033[5m"
BLACK_BG="\033[40m"
BLUE_FG="\033[34m"
CYAN_FG="\033[36m"
GREEN_FG="\033[32m"
MAGENTA_FG="\033[35m"
RED_FG="\033[31m"
WHITE_FG="\033[37m"
YELLOW_FG="\033[33m"
CSR_OFF="\033[?25l"
CSR_ON="\033[?25h"

CYAN_ON_GREY="\033[0m\033[0;1;36;100m"
GREEN_ON_GREY="\033[0m\033[0;1;32;100m"
MAGENTA_ON_GREY="\033[0m\033[0;1;35;100m"
RED_ON_GREY="\033[0m\033[0;1;31;100m"
WHITE_ON_GREY="\033[0m\033[0;1;37;100m"
YELLOW_ON_GREY="\033[0m\033[0;1;33;100m"
GREEN_ON_WHITE="\033[0m\033[0;1;31;100m"
RED_ON_WHITE="\033[0m\033[0;1;31;107m"

# Imports
[[ -z ${ZSH_LIB_DIR} ]] && _LIB_DIR=/usr/local/lib || _LIB_DIR=${ZSH_LIB_DIR}
source ${_LIB_DIR}/LIB_INIT.zsh
_DEPS+=(SELECT.zsh CENTER.zsh)
source ${_LIB_DIR}/LIB_DEPS.zsh

typeset -A _FAV_LIST=()
typeset -A _QUERY_OPTS=()
typeset -A _ENG_LIST=(1 youtube 2 rumble)
typeset -A _MENU_LIST=(1 custom 2 youtube 3 rumble)
typeset -A _RM_QRY_LIST=(1 user 2 live 3 channel)
typeset -A _YT_STRICT_LIST=(1 strict 2 non-strict)
typeset -A _YT_RANGE_LIST=(1 all 2 recent 3 min 4 hour 5 day 6 week 7 month 8 year)
typeset -a _FAV_ROW=()
typeset -a _FAV_KEYS=()
typeset -A _FIELD_CONFIG=()
typeset -g _FAV_VALUE=''

# Constants
_FIELD_CONFIG[qkey]="1|text|Enter QUERY key|_QUERY_OPTS[QKEY]|0|"
_FIELD_CONFIG[dkey]="2|text|Enter DISPLAY key|_QUERY_OPTS[DKEY]|1|"
_FIELD_CONFIG[list]="3|menu|Select Favorites List|_QUERY_OPTS[LIST]|_MENU_LIST|"
_FIELD_CONFIG[engine]="4|menu|Select Engine|_QUERY_OPTS[ENGINE]|_ENG_LIST|LIST|custom"
_FIELD_CONFIG[range]="5|menu|Select Video Date Range|_QUERY_OPTS[RANGE]|_YT_RANGE_LIST|ENGINE|youtube"
_FIELD_CONFIG[strict]="6|menu|Select Strict option|_QUERY_OPTS[STRICT]|_YT_STRICT_LIST|ENGINE|youtube"
_FIELD_CONFIG[query]="7|menu|Select Query Type|_QUERY_OPTS[QUERY]|_RM_QRY_LIST|ENGINE|rumble"
_YT_DLP_CFG=~/.local/share/yts
_YTS_FAVORITES=./yts.favorites
_RY=0

# Globals
g_ACTIVE_FAV_MENU=youtube

fav_add () {
	local FAV_ROW="${@}"

	msg_box -p -PC -H1 "Adding new favorite|KEY:${FAV_ROW:gs/|/\\|/}" # Escape delims
	if [[ ${_MSG_KEY:l} == "y" ]];then
		echo ${FAV_ROW} >> ${_YTS_FAVORITES} # Append new key to file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
		echo "\n${GREEN_FG}Key was added${RESET}"
	else
		echo "\n${RED_FG}Key was not added${RESET}"
	fi

	return 0
}

fav_delete () {
	local DKEY="${1}"
	local QUIET=${2:=false}
	local QKEY=''
	local FAV_ROW=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	FAV_ROW=$(grep -Ei "${DKEY:gs/ /_/:l}" ${_YTS_FAVORITES})
	if [[ ${?} -ne 0 ]];then
		msg_box -p -PK "Unable to locate favorite:${DKEY}"
		return 1
	fi

	if [[ ${QUIET} == 'false' ]];then
		msg_box -p -PC -H1 "<r>Deleting favorite<N>|Removing <w>${DKEY}<N>"
		[[ ${_MSG_KEY:l} != 'y' ]] && return 1
	fi

	QKEY=${${(s:|:)FAV_ROW}[1]}
	sed -i "/${QKEY}/d" ${_YTS_FAVORITES}

	if [[ ${?} -ne 0 ]];then
		[[ ${QUIET} == 'false' ]] && msg_box -p -PK "Unable to delete favorite:${DKEY}"
		return 1
	else
		[[ ${QUIET} == 'false' ]] && msg_box -p -PK "Deleted favorite:${DKEY}"
		return 0
	fi
}

fav_manage () {
	local MODE="${1}" # 'add' or 'edit'
	local -a FIELD_ORDER=()
	local -a OPT_LIST=()
	local -a MSG_LIST=()
	local -A _INLINE_BOX=(X 10 Y 65)
	local FIELD=''
	local RC=0
	local F I K

	if [[ ${MODE} == 'edit' ]]; then
		for F in ${(k)_QUERY_OPTS};do
			OPT_LIST+="<c>${F}<N>:<w>${_QUERY_OPTS[${F}]}<N>"
		done
		MSG_LIST=$(msg_list_bullet ${OPT_LIST})
		msg_box -p -PC -H1 "<c>Editing favorite<N>|Edit <w>${_QUERY_OPTS[DKEY]}<N>|<Z>${MSG_LIST}"
		[[ ${_MSG_KEY:l} != 'y' ]] && return 1
	fi

	# Dynamically sort keys based on the embedded order index
	FIELD_ORDER=(${(f)"$(for K in ${(k)_FIELD_CONFIG};do
	echo "${_FIELD_CONFIG[${K}]%%|*} ${K}"
	done | sort -n | cut -d' ' -f2)"})

	_FAV_KEYS=()
	for (( I = 1; I <= ${#FIELD_ORDER}; I++ )); do
		_INLINE_BOX[X]=$(( _INLINE_BOX[X] + I - 1 ))
		FIELD="${FIELD_ORDER[I]}"

		if [[ ${MODE} == 'edit' ]]; then
			fav_fields "${FIELD}" "${_QUERY_OPTS[${(U)FIELD}]}"
		else
			fav_fields "${FIELD}"
		fi

		RC=${?}
		if [[ ${RC} -ne 0 ]]; then
			break # Immediately stop processing remaining fields on quit/cancel
		fi

		case ${FIELD} in
			qkey)
				if [[ ${MODE} == 'add' ]]; then
					grep -Fiq "${_FAV_VALUE}|" ${_YTS_FAVORITES}
					if [[ ${?} -eq 0 ]]; then
						msg_box -p -PK "Query key must be unique"
						(( I-- ))
						continue
					fi
				fi
				_FAV_KEYS+=("$(str_trim "${_FAV_VALUE}")")
				;;
			dkey) _FAV_KEYS+=("$(str_trim "${_FAV_VALUE}")")
						;;
			list)
				_QUERY_OPTS[LIST]=${_FAV_VALUE}
				if [[ ${_FAV_VALUE} == 'youtube' ]];then
					_QUERY_OPTS[ENGINE]='youtube'
				elif [[ ${_FAV_VALUE} == 'rumble' ]];then
					_QUERY_OPTS[ENGINE]='rumble'
				elif [[ ${_FAV_VALUE} == 'custom' ]];then
					_QUERY_OPTS[ENGINE]=''
				fi
				;;
			engine) _QUERY_OPTS[ENGINE]=${_FAV_VALUE} ;;
			range)  _QUERY_OPTS[RANGE]=${_FAV_VALUE} ;;
			strict) _QUERY_OPTS[STRICT]=${_FAV_VALUE} ;;
			query)  _QUERY_OPTS[QUERY]=${_FAV_VALUE} ;;
		esac
	done

	if [[ ${RC} -ne 0 ]]; then
		case ${MODE} in
			add) msg_box -t2 "<r>Add cancelled<N>";;
			edit) msg_box -t2 "<r>Edit cancelled<N>";;
		esac
		return 1
	else
		_FAV_ROW=($(fav_set_row "${_FAV_KEYS[1]:l:gs/ /_/}|${_FAV_KEYS[2]:gs/ /_/}"))
		case ${MODE} in
			add) fav_add "${_FAV_ROW}";;
			edit) fav_update "${_FAV_ROW}";;
		esac
	fi
}

fav_fields () {
	local FIELD=${1}
	local VALUE="${2:-}"

	# Fetch configuration string directly from global lookup array
	local CONFIG=${_FIELD_CONFIG[${FIELD}]}
	local -a CFG_ROW=("${(@s:|:)CONFIG}")
	local ORDER="${CFG_ROW[1]}"
	local F_TYPE="${CFG_ROW[2]}"
	local F_TITLE="${CFG_ROW[3]}"
	local F_TARGET="${CFG_ROW[4]}"
	local F_EXTRA="${CFG_ROW[5]}"
	local PRE_KEY="${CFG_ROW[6]}"
	local PRE_VAL="${CFG_ROW[7]}"
	local MENU_SEL=''
	local REAL_VAL=''
	local INPUT_VAL=''
	local CURRENT_VAL=''
	local REQUIRED_VAL=''
	local RC=0

	# Fixed Gating Check: Reads directly from _QUERY_OPTS associative array
	if [[ -n ${PRE_KEY} ]];then
		CURRENT_VAL="${_QUERY_OPTS[${PRE_KEY}]}"
		REQUIRED_VAL="${PRE_VAL}"
		if [[ ${CURRENT_VAL} != ${REQUIRED_VAL} ]];then
			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}: Gating check failed for ${FIELD}. Required ${PRE_KEY}=${REQUIRED_VAL}, got '${CURRENT_VAL}'"
			return 1
		fi
	fi

	case ${F_TYPE} in
		text) _fav_text_prompt "${F_TITLE}" "${VALUE}" ${_INLINE_BOX[X]} ${_INLINE_BOX[Y]}
					RC=${?}
					;;
		menu) _fav_menu_prompt "<w>${F_TITLE}<N>" "${F_EXTRA}"
					RC=${?}
					;;
	esac
	return ${RC}
}

_fav_text_prompt () {
	local TITLE="${1}"
	local VAL="${2}"
	local X_COORD="${3}"
	local Y_COORD="${4}"
	local INPUT_VAL=""

	while true;do
		INPUT_VAL=$(inline_vi_edit "${TITLE}" "${VAL}" ${X_COORD} ${Y_COORD}) # Collect user input
		if [[ -z "${INPUT_VAL}" ]];then # No input
			msg_box -p -PK "${TITLE} must be populated|Enter a value or (q)uit"
			msg_box_clear
			if [[ ${_MSG_KEY:l} == 'q' ]];then # Abort
				return 1
			fi
		else
			_FAV_VALUE="${INPUT_VAL}" # Assign return value
			break
		fi
	done
	return 0
}

_fav_menu_prompt () {
	local TITLE="${1}"
	local TARGET_REF="${2}"
	local -a RAW_PAIRS=("${(@Pkv)TARGET_REF}") # Unpack keys and values from array
	local -A TARGET_MAP=("${RAW_PAIRS[@]}")
	local -a FORMATTED_ITEMS=()
	local K

	# Numerically sort keys using (ok) to guarantee rendering order
	for K in ${(ok)TARGET_MAP};do
		FORMATTED_ITEMS+=("${K}) ${(C)TARGET_MAP[${K}]}")
	done

	while true;do
		_MSG_KEY=''
		msg_box -c -H1 -p -PS -jl "${TITLE}|${(j:|:)FORMATTED_ITEMS}|or (Enter q to quit)"
		if [[ ${_MSG_KEY:l} == 'q' ]];then # Abort
			return 1
		fi

		if [[ -n ${_MSG_KEY} && -n ${TARGET_MAP[${_MSG_KEY:l}]} ]];then
			_FAV_VALUE="${TARGET_MAP[${_MSG_KEY:l}]}" # Assign return value
			break
		else
			msg_box -p -PK "No value was selected"
			msg_box_clear
			continue # Loop back to re-display the menu instead of returning 1
		fi
	done
	return 0
}

fav_load () {
	local LINE=''
	local DVAL=''
	local QVAL=''
	local OPTS=''

	_FAV_LIST=()

	[[ ! -f ${_YTS_FAVORITES} ]] && return 1

	while read -r LINE;do
		QVAL=${${(s:|:)LINE}[1]}
		DVAL=${${(s:|:)LINE}[2]}
		OPTS=${${(s:|:)LINE}[3,-1]}
		_FAV_LIST[${QVAL}]="${(C)DVAL:s/_/ /}|${OPTS}"
	done < ${_YTS_FAVORITES}

	[[ -n ${_FAV_LIST} ]] && return 0 || return 1
}

fav_parse_opts () {
	local FAV_ROW="${@}"
	local -a PARTS=()
	local LIST_TYPE=''
	local ENGINE_TYPE=''

	PARTS=("${(@s:|:)FAV_ROW}")

	_QUERY_OPTS=()

	_QUERY_OPTS[QKEY]=${PARTS[1]}
	_QUERY_OPTS[DKEY]=${PARTS[2]}
	_QUERY_OPTS[DKEY]=${(C)_QUERY_OPTS[DKEY]:gs/_/ /}

	LIST_TYPE=${PARTS[3]}
	if [[ ${LIST_TYPE} == 'y' ]];then
		_QUERY_OPTS[LIST]='youtube'
		_QUERY_OPTS[ENGINE]='youtube'
		[[ ${PARTS[4]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
		[[ -n ${PARTS[5]} ]] && _QUERY_OPTS[RANGE]=${PARTS[5]} || _QUERY_OPTS[RANGE]='recent'
	elif [[ ${LIST_TYPE} == 'r' ]];then
		_QUERY_OPTS[LIST]='rumble'
		_QUERY_OPTS[ENGINE]='rumble'
		_QUERY_OPTS[QUERY]=${PARTS[4]}
	elif [[ ${LIST_TYPE} == 'c' ]];then
		_QUERY_OPTS[LIST]='custom'
		ENGINE_TYPE=${PARTS[4]}
		if [[ ${ENGINE_TYPE} == 'y' ]];then
			_QUERY_OPTS[ENGINE]='youtube'
			[[ ${PARTS[5]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
			[[ -n ${PARTS[6]} ]] && _QUERY_OPTS[RANGE]=${PARTS[6]} || _QUERY_OPTS[RANGE]='recent'
		elif [[ ${ENGINE_TYPE} == 'r' ]];then
			_QUERY_OPTS[ENGINE]='rumble'
			_QUERY_OPTS[QUERY]=${PARTS[5]}
		fi
	fi
}

fav_select () {
	local -a C_LIST=()
	local -a R_LIST=()
	local -a Y_LIST=()
	local -a APP_KEYS=(a d e r y c w)
	local FTR=''
	local HDR=''
	local HDR_TAG=" <I>(Custom List)<N> "
	local LIST=''
	local MAP="(<w>r<N>)umble, (<w>y<N>)outube, (<w>c<N>)ustom, (<w>a<N>)dd, (<w>e<N>)dit, (<w>d<N>)elete" 
	local MENU_LBL=''
	local MENU_TYPE=''
	local OPTS=''
	local O_COLOR=''
	local QKEY=''
	local TAG=''
	local UNK_TYPE=''
	local L

	fav_load

	for L in ${(k)_FAV_LIST};do
		set_query_opts ${L}
		QKEY=${_QUERY_OPTS[QKEY]}
		case ${_QUERY_OPTS[LIST]} in
			custom) C_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			rumble) R_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			youtube) Y_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			*) UNK_TYPE=${_QUERY_OPTS[LIST]};;
		esac
	done

	if [[ -n ${UNK_TYPE} ]];then
		logit ${_YT_DBG_LOG} "Bad menu type:${MENU_TYPE} in ${_YTS_FAVORITES}"
		return 1
	fi

	while true;do
		case ${g_ACTIVE_FAV_MENU} in
			custom) LIST=(${C_LIST})
							O_COLOR=${GREEN_FG}
							HDR_TAG=" <I>(Custom List)<N> "
							;;
			rumble) LIST=(${R_LIST})
							O_COLOR=${MAGENTA_FG}
							HDR_TAG=''
							;;
			youtube) LIST=(${Y_LIST})
							O_COLOR=${CYAN_FG}
							HDR_TAG=''
							;;
		esac

		TAG="${_QUERY_OPTS[LIST]}.${g_ACTIVE_FAV_MENU}.query"
		HDR="<B><w>${(C)g_ACTIVE_FAV_MENU}${HDR_TAG} <B>Query<N>"
		FTR="Run <w>${(C)g_ACTIVE_FAV_MENU}<N> query, <w>(<N>s<w>)<N>how nav keys<N>, or <w>(<N>q<w>)<N>uit<N>"

		sel_set_app_keys ${APP_KEYS}
		sel_set_list ${LIST}

		msg_line_weight heavy
		sel_list -R -S -T${TAG} -O${O_COLOR} -H${HDR} -M${MAP} -F${FTR}
		msg_line_weight light

		if ! (( ${APP_KEYS[(I)${_SEL_VAL}]} ));then
			set_query_opts ${_SEL_VAL:gs/ /_/}
			QKEY=${_QUERY_OPTS[QKEY]}
		fi

		clear

		case ${_SEL_KEY} in
			w)
				msg_box -t2 "Opening YouTube and Rumble websites"
				open_website y
				open_website r
				_SEL_KEY=''
				return 2
				;;
			a)
				fav_manage add
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			d)
				fav_delete ${_SEL_VAL}
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			e)
				fav_manage edit
				if [[ ${?} -eq 0 ]];then
					fav_load
					return 1 # Reload favorites and refresh menu
				fi
				_SEL_KEY=''
				;;
			y) g_ACTIVE_FAV_MENU='youtube';;
			r) g_ACTIVE_FAV_MENU='rumble';;
			c) g_ACTIVE_FAV_MENU='custom';;
			*) break;;
		esac
	done

	return 0
}

fav_set_row () {
	local FAV_KEY="${1}"

	if [[ ${_QUERY_OPTS[LIST]} == 'youtube' ]];then
		FAV_KEY+="|y"
		[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
		FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'rumble' ]];then
		FAV_KEY+="|r"
		FAV_KEY+="|${_QUERY_OPTS[QUERY]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'custom' ]];then
		FAV_KEY+="|c"
		if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then
			FAV_KEY+="|y"
			[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
			FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
		elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]];then
			FAV_KEY+="|r"
			FAV_KEY+="|${_QUERY_OPTS[QUERY]}"
		fi
	fi

	echo "${FAV_KEY}"
}


fav_update () {
	local FAV_ROW="${@}"
	local K
	local -a LIST=()

	fav_parse_opts "${FAV_ROW}"

	LIST=("${(f)$(for K in ${(k)_QUERY_OPTS};do echo "${K}->${(qqq)_QUERY_OPTS[${K}]}";done)}")
	msg_box -p -PC -H1 "<c>Updating <w>${_QUERY_OPTS[DKEY]}<N>|$(msg_list_bullet ${(o)LIST})"

	if [[ ${_MSG_KEY:l} == "y" ]];then
		fav_delete ${_QUERY_OPTS[QKEY]} true
		echo ${FAV_ROW} >> ${_YTS_FAVORITES} # Update key in file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
		echo "\n${GREEN_FG}Key was updated${RESET}"
	else
		echo "\n${RED_FG}Key was not updated${RESET}"
	fi

	return 0
}

open_website () {
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${1} in
		y) firefox "https://www.youtube.com/feed/subscriptions" >/dev/null 2>&1 &;;
		r) firefox "https://www.rumble.com/subscriptions" >/dev/null 2>&1 &;;
		*) exit_leave $(err_msg_exit E "Invalid $(opt_type w):${1} Enter y for YouTube, r for Rumble")
	esac
}

set_query_opts () {
	local QKEY=${1}
	local FAV_ROW=''

	FAV_ROW="$(grep -Ei "${QKEY}" ${_YTS_FAVORITES})"
	[[ -z ${FAV_ROW} ]] && exit_leave "QKEY:${QKEY} not found"

	fav_parse_opts "${FAV_ROW}"
}

clear
while true;do
	fav_select
done
exit_leave
