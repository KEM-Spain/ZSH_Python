#!/usr/bin/zsh

# Inline ansi
BOLD="\033[1m"
ITALIC="\033[3m"
RESET="\033[m"
REVERSE="\033[7m"
STRIKE="\033[9m"
UNDER="\033[4m"
BLINK="\033[5m"
BLACK_BG="\033[40m"
BLUE_FG="\033[34m"
CYAN_FG="\033[36m"
GREEN_FG="\033[32m"
MAGENTA_FG="\033[35m"
RED_FG="\033[31m"
WHITE_FG="\033[37m"
YELLOW_FG="\033[33m"
CSR_OFF="\033[?25l"
CSR_ON="\033[?25h"

CYAN_ON_GREY="\033[0m\033[0;1;36;100m"
GREEN_ON_GREY="\033[0m\033[0;1;32;100m"
MAGENTA_ON_GREY="\033[0m\033[0;1;35;100m"
RED_ON_GREY="\033[0m\033[0;1;31;100m"
WHITE_ON_GREY="\033[0m\033[0;1;37;100m"
YELLOW_ON_GREY="\033[0m\033[0;1;33;100m"
GREEN_ON_WHITE="\033[0m\033[0;1;31;100m"
RED_ON_WHITE="\033[0m\033[0;1;31;107m"

# Imports
[[ -z ${ZSH_LIB_DIR} ]] && _LIB_DIR=/usr/local/lib || _LIB_DIR=${ZSH_LIB_DIR}
source ${_LIB_DIR}/LIB_INIT.zsh
_DEPS+=(SELECT.zsh CENTER.zsh)
source ${_LIB_DIR}/LIB_DEPS.zsh

typeset -A _FAV_LIST=()
typeset -A _QUERY_OPTS=()
typeset -A _QUERY_OPTS=()
typeset -A _ENG_LIST=(1 youtube 2 rumble)
typeset -A _MENU_LIST=(1 Custom 2 YouTube 3 Rumble)
typeset -A _RM_QRY_LIST=(1 User 2 Live 3 Channel)
typeset -A _YT_STRICT_LIST=(1 Strict 2 'Non Strict')
typeset -A _YT_RANGE_LIST=(1 all 2 recent 3 min 4 hour 5 day 6 week 7 month 8 year)
typeset -a _FAV_ROW=()
typeset -a _FAV_KEYS=()

# Safe method to create a numbered list is with a regular array so numbers are guaranteed to match item
# LIST=('1) Normal Production' '2) Library Module' '3) System Utility')

# Constants
_YT_DLP_CFG=~/.local/share/yts
_YTS_FAVORITES=./yts.favorites
_RY=0

# Globals
g_ACTIVE_FAV_MENU=youtube

open_website () {
	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${1} in
		y) firefox "https://www.youtube.com/feed/subscriptions" >/dev/null 2>&1 &;;
		r) firefox "https://www.rumble.com/subscriptions" >/dev/null 2>&1 &;;
		*) exit_leave $(err_msg_exit E "Invalid $(opt_type w):${1} Enter y for YouTube, r for Rumble")
	esac
}

fav_load () {
	local LINE=''
	local DVAL=''
	local QVAL=''
	local OPTS=''

	_FAV_LIST=()

	[[ ! -f ${_YTS_FAVORITES} ]] && return 1

	while read -r LINE;do
		QVAL=${${(s:|:)LINE}[1]}
		DVAL=${${(s:|:)LINE}[2]}
		OPTS=${${(s:|:)LINE}[3,-1]}
		_FAV_LIST[${QVAL}]="${(C)DVAL:s/_/ /}|${OPTS}"
	done < ${_YTS_FAVORITES}

	[[ -n ${_FAV_LIST} ]] && return 0 || return 1
}

fav_add () {
	local FAV_ROW=${1}

	msg_box -p -PC -H1 "Adding new favorite|KEY:${KEY:gs/|/\\|/}" # Escape delims
	if [[ ${_MSG_KEY:l} == "y" ]];then
		echo ${FAV_ROW} >> ${_YTS_FAVORITES} # Append new key to file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
		echo "\n${GREEN_FG}Key was added${RESET}"
	else
		echo "\n${RED_FG}Key was not added${RESET}"
	fi

	return 0
}

fav_fields () {
	local FIELD=${1}
	local VALUE=${2:=''}
	local -A _INLINE_BOX=(X 10 Y 65)
	local DKEY=''
	local MENU_KEY=''
	local MENU_SEL=''
	local VAL=''
	local MSG=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	while true; do
		case ${FIELD:l} in
		qkey) # 1. Query Key
					while true; do
						QKEY=$(inline_vi_edit "Enter QUERY key" "${VALUE}" ${_INLINE_BOX[X]} ${_INLINE_BOX[Y]})
						if [[ -z "${QKEY}" ]]; then
							MSG="Query key cannot be empty."
							msg_box -p -PK "${MSG}"
							msg_box_clear
							continue
						else
							_FAV_KEYS+=${QKEY}
						fi
						if [[ -n "${QKEY}" ]] && break
					done
					;;

		dkey) # 2. Display Key
					while true; do
						DKEY=$(inline_vi_edit "Enter DISPLAY key" "${VALUE}" $(( _INLINE_BOX[X] + 1 )) ${_INLINE_BOX[Y]})
						if [[ -z "${DKEY}" ]]; then
							MSG="Display key cannot be empty."
							msg_box -p -PK "${MSG}"
							msg_box_clear
							continue
						else
							_FAV_KEYS+=${DKEY}
						fi
						if [[ -n "${DKEY}" ]] && break
					done
					;;

		list) # 3. Favorites List Selection
					while true; do
						_MSG_KEY='' && MENU_SEL=''
						msg_box -v -c -H1 -p -PS -jl "<w>Select Favorites List<N>|$(msg_list_number ${(ov)_MENU_LIST})"
						MENU_SEL=${_MSG_KEY:l}

						if [[ -n ${MENU_SEL} ]]; then
							_QUERY_OPTS[LIST]=${MENU_SEL}
							_QUERY_OPTS[ENGINE]=${MENU_SEL}
							break
						else
							MSG="Favorites list selection is required."
							msg_box -p -PK "${MSG}"
							msg_box_clear
							continue
						fi
					done
					;;

		engine) # 4. Engine Selection (if list is custom)
						if [[ ${_QUERY_OPTS[LIST]:l} == 'custom' ]]; then
							while true; do
								_MSG_KEY='' && MENU_SEL=''
								msg_box -v -c -H1 -p -PS -jl "<w>Select Engine<N>|$(msg_list_number ${(ov)_ENG_LIST})"
								MENU_SEL=${_MSG_KEY:l}

								if [[ -n ${MENU_SEL} ]]; then
									_QUERY_OPTS[ENGINE]=${MENU_SEL}
									break
								else
									MSG="Engine selection is required."
									msg_box -p -PK "${MSG}"
									msg_box_clear
									continue
								fi
							done
						fi
						;;

		range)  # 5. Engine-Specific Options
						if [[ ${_QUERY_OPTS[ENGINE]:l} == 'youtube' ]]; then
							while true; do
								_MSG_KEY='' && MENU_SEL=''
								msg_box -v -c -H1 -p -PS -jl "<w>Select Video Date Range<N>|$(msg_list_number ${(ov)_YT_RANGE_LIST})"
								MENU_SEL=${_MSG_KEY:l}

								if [[ -n ${MENU_SEL} ]]; then
									_QUERY_OPTS[RANGE]=${MENU_SEL}
									break
								else
									MSG="Video date range selection is required."
									msg_box -p -PK "${MSG}"
									msg_box_clear
									continue
								fi
							done
						fi
						;;

		strict) # 6. Engine-Specific Options
						if [[ ${_QUERY_OPTS[ENGINE]:l} == 'youtube' ]]; then
							while true; do
								_MSG_KEY='' && MENU_SEL=''
								msg_box -v -c -H1 -p -PS -jl "<w>Select Strict option<N>|$(msg_list_number ${(ov)_YT_STRICT_LIST})"
								MENU_SEL=${_MSG_KEY:l}

								if [[ -n ${MENU_SEL} ]]; then
									_QUERY_OPTS[STRICT]=${MENU_SEL}
									break
								else
									MSG="Strict option selection is required."
									msg_box -p -PK "${MSG}"
									msg_box_clear
									continue
								fi
							done
						fi
						;;
		query)
			if [[ ${_QUERY_OPTS[ENGINE]:l} == 'rumble' ]]; then
				while true; do
					_MSG_KEY='' && MENU_SEL=''
					msg_box -v -c -H1 -p -PS -jl "<w>Select Query Type<N>|$(msg_list_number ${(ov)_RM_QRY_LIST})"
					MENU_SEL=${_MSG_KEY:l}

					if [[ -n ${MENU_SEL} ]]; then
						_QUERY_OPTS[QUERY]=${MENU_SEL}
						break
					else
						MSG="Query type selection is required."
						msg_box -p -PK "${MSG}"
						msg_box_clear
						continue
					fi
				done
			fi
			;;
		*) return 1;;
		esac
		break
	done

}

set_query_opts () {
	local QKEY=${1}
	local -a PARTS=()
	local FAV_ROW=''
	local LIST_TYPE=''
	local ENGINE_TYPE=''

	_QUERY_OPTS=()

	FAV_ROW="$(grep -Ei "${QKEY}" ${_YTS_FAVORITES})"
	[[ -z ${FAV_ROW} ]] && exit_leave "QKEY:${QKEY} not found"

	PARTS=("${(@s:|:)FAV_ROW}")

	_QUERY_OPTS[QKEY]=${PARTS[1]}
	_QUERY_OPTS[DKEY]=${PARTS[2]}
	_QUERY_OPTS[DKEY]=${(C)_QUERY_OPTS[DKEY]:gs/_/ /}

	LIST_TYPE=${PARTS[3]}
	if [[ ${LIST_TYPE} == 'y' ]]; then
		_QUERY_OPTS[LIST]='youtube'
		_QUERY_OPTS[ENGINE]='youtube'
		[[ ${PARTS[4]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
		[[ -n ${PARTS[5]} ]] && _QUERY_OPTS[RANGE]=${PARTS[5]} || _QUERY_OPTS[RANGE]='recent'
	elif [[ ${LIST_TYPE} == 'r' ]]; then
		_QUERY_OPTS[LIST]='rumble'
		_QUERY_OPTS[ENGINE]='rumble'
		_QUERY_OPTS[QUERY]=${PARTS[4]}
	elif [[ ${LIST_TYPE} == 'c' ]]; then
		_QUERY_OPTS[LIST]='custom'
		ENGINE_TYPE=${PARTS[4]}
		if [[ ${ENGINE_TYPE} == 'y' ]]; then
			_QUERY_OPTS[ENGINE]='youtube'
			[[ ${PARTS[5]} == 's' ]] && _QUERY_OPTS[STRICT]='strict'
			[[ -n ${PARTS[6]} ]] && _QUERY_OPTS[RANGE]=${PARTS[6]} || _QUERY_OPTS[RANGE]='recent'
		elif [[ ${ENGINE_TYPE} == 'r' ]]; then
			_QUERY_OPTS[ENGINE]='rumble'
			_QUERY_OPTS[QUERY]=${PARTS[5]}
		fi
	fi
}

fav_set_opts () {
	local FAV_KEY=${1}

	if [[ ${_QUERY_OPTS[LIST]} == 'youtube' ]];then
		FAV_KEY+="|y"
		[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
		FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'rumble' ]];then
		FAV_KEY+="|r"
		FAV_KEY+="|${_QUERY_OPTS[QUERY]}"
	elif [[ ${_QUERY_OPTS[LIST]} == 'custom' ]];then
		FAV_KEY+="|c"
		if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then
			FAV_KEY+="|y"
			[[ ${_QUERY_OPTS[STRICT]} == 'strict' ]] && FAV_KEY+='|s' || FAV_KEY+='|n'
			FAV_KEY+="|${_QUERY_OPTS[RANGE]}"
		elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]];then
			FAV_KEY+="|r"
			FAV_KEY+="|${_QUERY_OPTS[QUERY]}"
		fi
	fi

	echo "${FAV_KEY}"
}

fav_select () {
	local -a C_LIST=()
	local -a R_LIST=()
	local -a Y_LIST=()
	local -a APP_KEYS=(d e r y c w)
	local FTR=''
	local HDR=''
	local HDR_TAG=" <I>(Custom List)<N> "
	local LIST=''
	local MAP="(<w>r<N>)umble, (<w>y<N>)outube, (<w>c<N>)ustom, (<w>d<N>)elete, (<w>w<N>)eb"
	local MENU_LBL=''
	local MENU_TYPE=''
	local OPTS=''
	local O_COLOR=''
	local QKEY=''
	local TAG=''
	local UNK_TYPE=''
	local L

	fav_load

	for L in ${(k)_FAV_LIST};do
		set_query_opts ${L}
		QKEY=${_QUERY_OPTS[QKEY]}
		case ${_QUERY_OPTS[LIST]} in
			custom) C_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			rumble) R_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			youtube) Y_LIST+="${(C)_QUERY_OPTS[DKEY]:gs/_/ /}";;
			*) UNK_TYPE=${_QUERY_OPTS[LIST]};;
		esac
	done

	if [[ -n ${UNK_TYPE} ]];then
		logit ${_YT_DBG_LOG} "Bad menu type:${MENU_TYPE} in ${_YTS_FAVORITES}"
		return 1
	fi

	while true;do
		case ${g_ACTIVE_FAV_MENU} in
			custom) LIST=(${C_LIST})
							O_COLOR=${GREEN_FG}
							HDR_TAG=" <I>(Custom List)<N> "
							;;
			rumble) LIST=(${R_LIST})
							O_COLOR=${MAGENTA_FG}
							HDR_TAG=''
							;;
			youtube) LIST=(${Y_LIST})
							O_COLOR=${CYAN_FG}
							HDR_TAG=''
							;;
		esac

		TAG="${_QUERY_OPTS[LIST]}.${g_ACTIVE_FAV_MENU}.query"
		HDR="<B><w>${(C)g_ACTIVE_FAV_MENU}${HDR_TAG} <B>Query<N>"
		FTR="Run <w>${(C)g_ACTIVE_FAV_MENU}<N> query, <w>(<N>s<w>)<N>how nav keys<N>, or <w>(<N>q<w>)<N>uit<N>"

		sel_set_app_keys ${APP_KEYS}
		sel_set_list ${LIST}

		msg_line_weight heavy
		sel_list -R -S -T${TAG} -O${O_COLOR} -H${HDR} -M${MAP} -F${FTR}
		msg_line_weight light

		if ! (( ${APP_KEYS[(I)${_SEL_VAL}]} ));then
			set_query_opts ${_SEL_VAL:gs/ /_/}
			QKEY=${_QUERY_OPTS[QKEY]}
		fi

		clear

		if [[ ${_SEL_KEY} == 'w' ]];then
			msg_box -t2 "Opening YouTube and Rumble websites"
			open_website y
			open_website r
			_SEL_KEY=''
			return 2
		fi

		if [[ ${_SEL_KEY} == 'd' ]];then
			fav_delete ${_SEL_VAL} ${g_ACTIVE_FAV_MENU} # Call key delete
			[[ ${?} -eq 0 ]] && fav_load && return 1 # Reload favorites & return
		fi

		if [[ ${_SEL_KEY} == 'e' ]];then
			fav_edit ${_SEL_VAL} ${g_ACTIVE_FAV_MENU} # Call key delete
			[[ ${?} -eq 0 ]] && fav_load && return 1 # Reload favorites & return
		fi

		case ${_SEL_KEY} in
			y) g_ACTIVE_FAV_MENU='youtube';;
			r) g_ACTIVE_FAV_MENU='rumble';;
			c) g_ACTIVE_FAV_MENU='custom';;
			*) break;;
		esac
	done

	return 0
}

fav_delete () {
	local DKEY="${1}"
	local QKEY=''
	local FAV_ROW=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	FAV_ROW=$(grep -Ei "${DKEY:gs/ /_/:l}" ${_YTS_FAVORITES})
	if [[ ${?} -ne 0 ]];then
		msg_box -p -PK "Unable to locate favorite:${DKEY}"
		return 1
	fi

	QKEY=${${(s:|:)FAV_ROW}[1]}
	msg_box -p -PC -H1 "<r>Deleting favorite<N>|Removing <w>${DKEY}<N>"
	[[ ${_MSG_KEY:l} != 'y' ]] && return 1

	sed -i "/${QKEY}/d" ${_YTS_FAVORITES}
	if [[ ${?} -ne 0 ]];then
		msg_box -p -PK "Unable to delete favorite:${DKEY}"
		return 1
	else
		msg_box -p -PK "Deleted favorite:${DKEY}"
		return 0
	fi
}

fav_edit () {
	local QKEY=${_QUERY_OPTS[QKEY]}
	local FAV_ROW=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	msg_box -p -PC -H1 "<c>Editing favorite<N>|Edit <w>${_QUERY_OPTS[DKEY]}<N>"
	[[ ${_MSG_KEY:l} != 'y' ]] && return 1

	fav_fields qkey ${_QUERY_OPTS[QKEY]}
	fav_fields dkey ${_QUERY_OPTS[DKEY]}
	fav_fields list ${_QUERY_OPTS[LIST]}
	fav_fields engine ${_QUERY_OPTS[ENGINE]}
	fav_fields range ${_QUERY_OPTS[RANGE]}
	fav_fields strict ${_QUERY_OPTS[STRICT]}
	fav_fields query ${_QUERY_OPTS[QUERY]}
	_FAV_ROW=($(fav_set_opts "${_FAV_KEYS[1]:l:gs/ /_/}|${_FAV_KEYS[2]:gs/ /_/}"))
	echo "_FAV_ROW:${_FAV_ROW}"
}

fav_build () {
	_FAV_KEYS=()
	fav_fields qkey www
	fav_fields dkey
	fav_fields list
	fav_fields engine
	fav_fields range
	fav_fields strict
	fav_fields query
	_FAV_ROW=($(fav_set_opts "${_FAV_KEYS[1]:l:gs/ /_/}|${_FAV_KEYS[2]:gs/ /_/}"))
	echo "_FAV_ROW:${_FAV_ROW}"
}

clear
fav_select
exit_leave
