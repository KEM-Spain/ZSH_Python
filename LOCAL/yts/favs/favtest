#!/usr/bin/zsh

# Inline ansi
BOLD="\033[1m"
ITALIC="\033[3m"
RESET="\033[m"
REVERSE="\033[7m"
STRIKE="\033[9m"
UNDER="\033[4m"
BLINK="\033[5m"
BLACK_BG="\033[40m"
BLUE_FG="\033[34m"
CYAN_FG="\033[36m"
GREEN_FG="\033[32m"
MAGENTA_FG="\033[35m"
RED_FG="\033[31m"
WHITE_FG="\033[37m"
YELLOW_FG="\033[33m"
CSR_OFF="\033[?25l"
CSR_ON="\033[?25h"

CYAN_ON_GREY="\033[0m\033[0;1;36;100m"
GREEN_ON_GREY="\033[0m\033[0;1;32;100m"
MAGENTA_ON_GREY="\033[0m\033[0;1;35;100m"
RED_ON_GREY="\033[0m\033[0;1;31;100m"
WHITE_ON_GREY="\033[0m\033[0;1;37;100m"
YELLOW_ON_GREY="\033[0m\033[0;1;33;100m"
GREEN_ON_WHITE="\033[0m\033[0;1;31;100m"
RED_ON_WHITE="\033[0m\033[0;1;31;107m"

# Imports
[[ -z ${ZSH_LIB_DIR} ]] && _LIB_DIR=/usr/local/lib || _LIB_DIR=${ZSH_LIB_DIR}
source ${_LIB_DIR}/LIB_INIT.zsh
_DEPS+=()
source ${_LIB_DIR}/LIB_DEPS.zsh

typeset -A _FAV_LIST=()
typeset -A _QUERY_OPTS=()
typeset -A _ENG_LIST=(1 youtube 2 rumble)
typeset -A _MENU_LIST=(1 Custom 2 YouTube 3 Rumble)
typeset -A _RM_QRY_LIST=(1 User 2 Live 3 Channel)
typeset -A _YT_STRICT_LIST=(1 Strict 2 'Non Strict')
typeset -A _YT_RANGE_LIST=(1 all 2 recent 3 min 4 hour 5 day 6 week 7 month 8 year)
typeset -A _BOX=()

_YT_DLP_CFG=~/.local/share/yts
_YTS_FAVORITES=./yts.favorites
_DKEY=''
_RY=0

fav_opts () {
	local FAV="${@}"
	_QUERY_OPTS[DKEY]=${${(s:|:)FAV}[1]}
	_QUERY_OPTS[QKEY]=${${(s:|:)FAV}[2]}
	_QUERY_OPTS[MENU]=${${${(s:|:)FAV}[3]}[1]}
	_QUERY_OPTS[ENGINE]=${${${(s:|:)FAV}[3]}[2]}
	_QUERY_OPTS[ENGOPT]=${${${(s:|:)FAV}[3]}[3]}
}
 
fav_load () {
	local LINE=''
	local DVAL=''
	local QVAL=''
	local OPTS=''

	_FAV_LIST=()

	[[ ! -f ${_YTS_FAVORITES} ]] && return 1

	while read -r LINE;do
		DVAL=${${(s:|:)LINE}[1]}
		QVAL=${${(s:|:)LINE}[2]}
		OPTS=${${(s:|:)LINE}[3]}
		_FAV_LIST[${QVAL}]="${(C)DVAL:s/_/ /}|${OPTS}"
	done < ${_YTS_FAVORITES}

	[[ -n ${_FAV_LIST} ]] && return 0 || return 1
}

fav_add () {
	local QKEY=${1}
	local -A FAV_ADD=()
	local KEY=''
	local MENU_KEY=''
	local MENU_SEL=''
	local MSG=''
	local K

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	clear

	KEY="$(grep -Ei "${QKEY}" ${_YTS_FAVORITES})"

	if [[ -n ${KEY} ]];then
		msg_box -p -PK "Favorite ${QKEY} already exists"
		return 1
	fi

	msg_box -H1 -p -PC "<w><I>Please respond<N>|<Z>|Add \"${QKEY}\" to favorites?"
	[[ ${_MSG_KEY} != 'y' ]] && return

	MSG="Enter display key for \"${QKEY}\""
	_BOX=($(box_coords_get MSG_BOX))
	_RY=$(center -Y -c"${(kv)_BOX}" -w${#MSG})
	tcup $(( _BOX[X] + _BOX[H] + 1 )) ${_RY};_DKEY=$(inline_vi_edit "${MSG}:")

	while true;do
		msg_box -v -c -H1 -p -PS -jl "<w>Select Favorites List<N>|$(msg_list_number ${(ov)_MENU_LIST})"
		[[ ${_MSG_KEY} == "0" ]] && break
		MENU_SEL=${_MSG_KEY:l}
		[[ -z ${MENU_SEL} ]] && msg_box -t.3 "Invalid option" && continue
		FAV_ADD[LIST]=${MENU_SEL:l} 
		FAV_ADD[ENGINE]=${MENU_SEL:l} 

		if [[ ${FAV_ADD[LIST]:l} == 'custom' ]];then
			msg_box -v -c -H1 -p -PS -jl "<w>Select Engine<N>|$(msg_list_number ${(ov)_ENG_LIST})"
			[[ ${_MSG_KEY} == "0" ]] && break
			MENU_SEL=${_MSG_KEY:l}
			[[ -z ${MENU_SEL} ]] && msg_box -t.3 "Invalid option" && continue
			FAV_ADD[ENGINE]=${MENU_SEL} 
		fi

		if [[ ${FAV_ADD[ENGINE]:l} = 'youtube' ]];then
			msg_box -v -c -H1 -p -PS -jl "<w>Select Video Date Range<N>|$(msg_list_number ${(ov)_YT_RANGE_LIST})"
			[[ ${_MSG_KEY} == "0" ]] && break
			MENU_SEL=${_MSG_KEY:l}
			[[ -z ${MENU_SEL} ]] && msg_box -t.3 "Invalid option" && continue
			FAV_ADD[RANGE]=${MENU_SEL} 
			msg_box -v -c -H1 -p -PS -jl "<w>Select Strict option<N>|$(msg_list_number ${(ov)_YT_STRICT_LIST})"
			[[ ${_MSG_KEY} == "0" ]] && break
			MENU_SEL=${_MSG_KEY:l}
			[[ -z ${MENU_SEL} ]] && msg_box -t.3 "Invalid option" && continue
			FAV_ADD[STRICT]=${MENU_SEL} 
			break
		elif [[ ${FAV_ADD[ENGINE]:l} = 'rumble' ]];then
			msg_box -v -c -H1 -p -PS -jl "<w>Select Query Type<N>|$(msg_list_number ${(ov)_RM_QRY_LIST})"
			[[ ${_MSG_KEY} == "0" ]] && break
			MENU_SEL=${_MSG_KEY:l}
			[[ -z ${MENU_SEL} ]] && msg_box -t.3 "Invalid option" && continue
			FAV_ADD[QUERY]=${MENU_SEL} 
			break
		fi
	done

	KEY="${_DKEY:l:gs/ /_/}|${QKEY}"
	if [[ ${FAV_ADD[LIST]} == 'youtube' ]];then
		KEY+="|y"
		[[ ${FAV_ADD[STRICT]} == 'strict' ]] && KEY+='|s' || KEY+='|n'
		KEY+="|${FAV_ADD[RANGE]}"
	elif [[ ${FAV_ADD[LIST]} == 'rumble' ]];then
		KEY+="|r"
		KEY+="|${FAV_ADD[QUERY]}"
	elif [[ ${FAV_ADD[LIST]} == 'custom' ]];then
		KEY+="|c"
		if [[ ${FAV_ADD[ENGINE]} == 'youtube' ]];then
			KEY+="|y"
			[[ ${FAV_ADD[STRICT]} == 'strict' ]] && KEY+='|s' || KEY+='|n'
			KEY+="|${FAV_ADD[RANGE]}"
		elif [[ ${FAV_ADD[ENGINE]} == 'rumble' ]];then
			KEY+="|r"
			KEY+="|${FAV_ADD[QUERY]}"
		fi
	fi

	msg_box -p -PC -s'|' -H1 "Adding new favorite#KEY:${KEY}"
	if [[ ${_MSG_KEY:l} == "y" ]];then
		echo ${KEY} >> ${_YTS_FAVORITES} # Append new key to file
		sort -o ${_YTS_FAVORITES}{,} # In-place sort
	fi

	return 0
}

fav_load
fav_add "new_fav"

