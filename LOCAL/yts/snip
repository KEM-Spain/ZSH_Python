findexe () {
	local -a PROD_LIST=(${HOME}/.zsh/completions ${HOME}/.local/bin ${HOME}/.local/share /usr/local/bin /usr/local/lib ${HOME}/Code/LOCAL)
	local -a WIS=()
	local -a FLIST=()
	local -aU LIST=()
	local FN=''
	local LOCAL=''
	local VERBOSE=''
	local PRODUCTION=''
	local DELETE_CACHE=''
	local L R D
	local CACHE_DIR="${HOME}/.local/share/findexe"
	local CACHE_FILE="${CACHE_DIR}/cache"

	read -r -d '' DESC<<______EOF
Find executable files
______EOF

	#--Begin GetOpts--
	RESET="\033[m"
	RED_FG="\033[31m"
	WHITE_FG="\033[37m"
	CYAN_FG="\033[36m"
	GREEN_FG="\033[32m"

	parse_opts () {
		local OPTS=${@}
		local -a OPTSTR
		local LETTER_OPT
		local O

		for O in {1..${#OPTS}};do
			[[ ${OPTS[${O}]} =~ '[A-Za-z]' ]] && LETTER_OPT=${OPTS[${O}]}
			[[ ${O} -eq 1 && ${OPTS[${O}]} == ":" ]] && continue
			[[ ${O} -gt 1 && ${OPTS[${O}]} == ":" ]] && OPTSTR+=$(opt_type ${LETTER_OPT}) && continue
			OPTSTR+="-${OPTS[${O}]}"
		done
		echo ${OPTSTR}
	}

	opt_type () {
		local OPT=${1}
		case ${OPT} in
			f) echo "<FILE>";;
			t) echo "<FILE_TYPE>";;
		esac
	}

	usage () {
		tabs 5
		[[ ${_SMCUP} == 'true' ]] && do_rmcup

		local OPTS=$(parse_opts ${OPTSTR})
		local -a PENDING_MSGS=(${@})

		(
		echo -e "\n${WHITE_FG}Usage${RESET}: ${_WRAPPER} ${_SCRIPT} ${WHITE_FG}[${RESET}${OPTS}${WHITE_FG}]${RESET} $(opt_type f)\n"
		echo -e "${WHITE_FG}-H${RESET} help"
		echo -e "${WHITE_FG}-D${RESET} debug"
		echo -e "${WHITE_FG}-d${RESET} delete cache entry for search term"
		echo -e "${WHITE_FG}-l${RESET} local files have priority"
		echo -e "${WHITE_FG}-p${RESET} production file"
		echo -e "${WHITE_FG}-v${RESET} verbose output"
		echo -e "\n${WHITE_FG}Desc${RESET}:${DESC}"
		) >&2

		exit_leave $(err_msg_exit ${PENDING_MSGS})
	}

	OPTSTR=":HDlvpd"
	OPTIND=0

	LOCAL=false
	VERBOSE=false
	PRODUCTION=false
	DELETE_CACHE=false

	while getopts ${OPTSTR} OPTION;do
		case $OPTION in
		  H) usage;;
		  D) dbg_set_level;;
		  d) DELETE_CACHE=true;;
		  l) LOCAL=true;;
		  p) PRODUCTION=true;;
		  v) VERBOSE=true;;
		  :) print -u2 "${SCRIPT}: option: -${OPTARG} requires an argument"; usage;;
		 \?) print -u2 "${SCRIPT}: ${BOLD}${RED_FG}Unknown option${RESET} -${OPTARG}"; usage;;
		esac
	done
	shift $(( OPTIND - 1 ))
	#--End GetOpts--
	 
	# Execution
	FN=${1}
	[[ -z ${FN} ]] && return

	[[ ! -d "${CACHE_DIR}" ]] && mkdir -p "${CACHE_DIR}"

	# Handle cache deletion if -d is passed
	if [[ ${DELETE_CACHE} == 'true' ]]; then
		if [[ -f "${CACHE_FILE}" ]]; then
			awk -v target="${FN}" '
				BEGIN {skip=0}
				$0 == "===" target "===" {skip=1; next}
				/^===.*===$/ {if (skip) skip=0}
				!skip {print}
			' "${CACHE_FILE}" > "${CACHE_FILE}.tmp" && mv "${CACHE_FILE}.tmp" "${CACHE_FILE}"
			[[ ${VERBOSE} == 'true' ]] && echo "${GREEN_FG}Deleted cache entry for: ${FN}${RESET}" >&2
		fi
		return 0
	fi

	[[ ${VERBOSE} == 'true' ]] && echo "${CYAN_FG}Searching for:${FN}${RESET}" >&2

	# Try loading from the single cache file if it exists
	if [[ -f "${CACHE_FILE}" ]]; then
		FLIST=("${(f)$(awk -v target="${FN}" '
			$0 == "===" target "===" {flag=1; next}
			/^===.*===$/ {flag=0}
			flag && $0 != "" {print}
		' "${CACHE_FILE}" 2>/dev/null)}")
	fi

	# If not found in cache, run searches and append to the single cache file
	if ! arr_is_populated "${FLIST}"; then
		if [[ ${PRODUCTION} == 'false' ]];then	
			[[ ${VERBOSE} == 'true' ]] && echo "${WHITE_FG}whereis${RESET}: ${FN}" >&2
			WIS=(${(z)"${(f)$(whereis -b -f ${FN})}"})
			if [[ -z ${WIS} ]];then
				[[ ${VERBOSE} == 'true' ]] && echo "${RED_FG}No whereis hits${RESET}" >&2
			else
				for L in ${WIS};do
					[[ ${L} =~ "${FN}:" ]] && continue # Skip whereis header
					FLIST+=${L}
					[[ ${VERBOSE} == 'true' ]] && echo "${GREEN_FG}Found:${L}${RESET}" >&2
				done
			fi
		fi

		for D in ${PROD_LIST};do
			[[ ${VERBOSE} == 'true' ]] && echo "${WHITE_FG}Searching for executables in ${D}${RESET}" >&2
			FLIST+=("${(f)$(find ${D} -type f -name "${FN}" -executable 2>&1)}")
		done

		if arr_is_populated "${FLIST}"; then
			FLIST=(${FLIST:#})
			# Remove any stale entry for this term, then append the new one
			if [[ -f "${CACHE_FILE}" ]]; then
				awk -v target="${FN}" '
					BEGIN {skip=0}
					$0 == "===" target "===" {skip=1; next}
					/^===.*===$/ {if (skip) skip=0}
					!skip {print}
				' "${CACHE_FILE}" > "${CACHE_FILE}.tmp" && mv "${CACHE_FILE}.tmp" "${CACHE_FILE}"
			fi
			print "===${FN}===" >> "${CACHE_FILE}"
			print -l "${FLIST[@]}" >> "${CACHE_FILE}"
		fi
	else
		[[ ${VERBOSE} == 'true' ]] && echo "${CYAN_FG}Loaded from cache: ${CACHE_FILE}${RESET}" >&2
	fi

	if ! arr_is_populated "${FLIST}";then
		set_exit_value 1
		[[ ${VERBOSE} == 'true' ]] && exit_leave $(err_msg_exit E "File not found:${FN}")
	fi

	for L in ${FLIST};do
		if [[ -h ${L} ]];then
			[[ ${VERBOSE} == 'true' ]] && echo "${RED_FG}Eliminating symlink:${L}${RESET}" >&2
			continue
		fi
		if [[ ${LOCAL} == 'true' ]];then
			if [[ ! ${L:h} == ${PWD} ]];then
				[[ ${VERBOSE} == 'true' ]] && echo "${RED_FG}Discarding non local:${L}${RESET}" >&2
				continue
			fi
		fi
		if [[ ${PRODUCTION} == 'true' ]];then
			if [[ ${L:h} == ${PWD} ]];then
				[[ ${VERBOSE} == 'true' ]] && echo "${RED_FG}Discarding local:${L}${RESET}" >&2
				continue
			fi
		fi
		LIST+=${L}
		[[ ${PRODUCTION} == 'true' ]] && break # First file only
	done

	if ! arr_is_populated "${LIST}";then
		set_exit_value 1
		[[ ${VERBOSE} == 'true' ]] && exit_leave $(err_msg_exit E "File not found:${FN}")
	else
		set_exit_value 0
		do_rmcup
		for L in ${LIST};do
			echo ${L}
		done
	fi
}
