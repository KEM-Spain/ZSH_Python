action_do () {
	local AUTHOR=''
	local DEST=''
	local DEST_LINE=''
	local DL_CNT=0
	local DL_DIR=''
	local DUP_LINE=''
	local ETA=''
	local FRAME_PAD=8
	local HDR1_TXT=''
	local HDR2_TXT=''
	local HDRS_OUT=false
	local HDR_LEN=0
	local HRZ_CTR=0
	local INFO_TAG=''
	local INT_KEY=''
	local LAST_LOG_LINE=''
	local LAST_MSG=''
	local LAST_TRANS_MSG=''
	local LINE_COLOR=''
	local LOG_LINE=''
	local LOG_REPEATS=0
	local MAX_HDR=$(( _CONT_COORDS[W] - 15 ))
	local MSG=''
	local NDX=0
	local PRE_HDR_ERR=''
	local RETRIES=0
	local TEXT=''
	local TITLE=''
	local TRANS_ERR_CNT=0
	local TRANS_ERR_MSG=0
	local URL=''
	local M

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# Suppress terminal echo for the entire download action batch
	stty -echo # Prevent any keypresses from echoing on the term
	{
		for M in ${_MARKED};do
			((DL_CNT++))
			_QUICK_DOWNLOAD[${M}]=false
			_CANCELLED[${DL_CNT}]=false
			_DOWNLOADS[${DL_CNT}]=false
			_FAILED[${DL_CNT}]=false
			_FUTURE[${DL_CNT}]=false
			AUTHOR=$(get_field author ${M})
			TITLE=$(get_field title ${M})
			URL=$(get_field url ${M})
			RETRIES=0

			logit ${_YT_URL_LOG} "${AUTHOR}:${TITLE}:${URL}"

			unsetopt localtraps # Initialize CTRL-C trap
			trap job_kill INT

			[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: Starting job for:${URL}"
			job_start "${URL}"

			msg_box -t${_MSG_DELAY[LONG]} -O${CYAN_FG} -H1 -P"<w><I>Use key:<c>(<w>k<c>)<w> to <B><r>cancel<N><w> download<N>" -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} "<g>Download Requested...<N>"

			msg_box -z -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Initializing download...<N>"

			HDRS_OUT=false
			while true;do
				read -s -t0.1 -k1 INT_KEY 2>/dev/null
				if [[ ${INT_KEY} == 'k' ]]; then
					job_cancel
					logit ${_YT_DBG_LOG} "${0}: JOB CANCELLED during initialization"
					MSG="Cancelling download..."
					msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
					_CANCELLED[${M}]=true
					TRANS_ERR_CNT=0
					break
				fi

				if grep -q -Ei -m1 'already been' ${g_YTS_LOG} 2>/dev/null; then
					logit ${_YT_DBG_LOG} "${0}: No download - video already exists"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>File was already downloaded...<N>"
					_CANCELLED[${M}]=true
					break
				fi

				if grep -q -Ei -m1 '403' ${g_YTS_LOG} 2>/dev/null; then
					logit ${_YT_DBG_LOG} "${0}: No download - 403 error"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Got 403 error...<N>"
					_CANCELLED[${M}]=true
					break
				fi

				PRE_HDR_ERR=$(grep -Ei -m1 'will begin' ${g_YTS_LOG} 2>/dev/null)
				if [[ ${?} -eq 0 ]]; then
					logit ${_YT_DBG_LOG} "${0}: No download - future broadcast"
					[[ ! ${PRE_HDR_ERR:l} =~ 'minute*|hour*|day*' ]] && g_WHEN='soon' || g_WHEN=$(perl -pe 's/^(.*) in (\d+\s+\w+)(.*)$/\2/g' <<<${PRE_HDR_ERR})
					MSG="<w>${TITLE[1,65]}<N>|<r><B>Not yet available<N> - Airing time:<w>${g_WHEN}<N>"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
					_FUTURE[${M}]=true
					break
				fi

				DEST_LINE=$(grep -Ei -m1 'Destination:' ${g_YTS_LOG} 2>/dev/null)
				if [[ ${?} -eq 0 ]]; then
					HDRS_OUT=true
					break
				fi

				sleep .5
			done

			[[ ${HDRS_OUT} == 'false' ]] && continue # Job was aborted or completed early

			logit ${_YT_DBG_LOG} "${0}: GENERATING HEADER"
			DEST=("${(f)$(sed -e "s#/tmp/#/tmp|#g" -e 's/ \[.*//g' <<<${DEST_LINE})}") # Delimit path and fn

			HDR1_TXT="${${(@s/|/)${DEST}}[2]}"
			if [[ ${HDR1_TXT} =~ "\.[^.]+\.[^.]+$" ]];then # Double extension
				HDR1_TXT=${HDR1_TXT:r}
			fi

			HDR1_TXT=${HDR1_TXT:r}

			HDR1_TXT="<B><I><h>Downloading<N>: <f><w>$(clean_title ${HDR1_TXT} ${_MAX_HDR})<N>"
			HDR2_TXT="<B><I><h>Destination<N>: $(str_trim ${_DOWNLOAD_DIR})<N> - <w>${DL_CNT} <N>of <w>${#_MARKED}${INFO_TAG}"

			HDR_LEN=$(( ${#$(msg_nomarkup ${HDR2_TXT})} ))
			HDR_LEN=$(( HDR_LEN + FRAME_PAD ))
			HRZ_CTR=$(center -H -w${HDR_LEN})

			[[ ${HDR_LEN} -gt ${_CONT_COORDS[W]} ]] && _CONT_COORDS[W]=${HDR_LEN} && _CONT_COORDS[Y]=${HRZ_CTR}

			msg_box -C -O${CYAN_FG} -I -H3 -jl -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} ${HDR1_TXT}
			msg_box -C -jl ${HDR2_TXT}
			msg_box -C -jl "<c>$(str_unicode_line ${_MAX_MSG_LEN})<N>"
			msg_box -C -jl "<B><c>Download started, waiting for log activity to begin...<N>"

			zmodload zsh/zselect # Live progress monitoring with zselect
			exec 3< <(tail -Fn0 "${g_YTS_LOG}")

			local -a zsel_reply
			spinner start

			while true; do
				zselect -t 10 -a zsel_reply -r 3

				# Check keyboard input instantly on every loop iteration
				read -s -t0.01 -k1 INT_KEY 2>/dev/null
				if [[ ${INT_KEY} == 'k' ]]; then
					spinner stop
					job_cancel
					logit ${_YT_DBG_LOG} "${0}: JOB CANCELLED during download"
					MSG="Cancelling download..."
					msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
					_CANCELLED[${M}]=true
					TRANS_ERR_CNT=0
					break
				fi

				# Check log pipe activity (FD 3)
				if (( ${zsel_reply[(I)3]} )); then
					if read -u3 -r LOG_LINE; then

						MSG=$(str_word_clip ${LOG_LINE} ${_MAX_MSG_LEN})
						MSG="$(str_rpad ${MSG} ${_MAX_MSG_LEN})"

						if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]]; then
							case ${LOG_LINE:l} in
								*merging*)
									spinner stop
									logit ${_YT_DBG_LOG} "${0}: COMPLETED"
									_DOWNLOADS[${M}]=true
									post_process
									log_add ${M}
									MSG="$(str_rpad "Download is complete" ${_MAX_MSG_LEN})"
									msg_box -C -jl "<B><g>${MSG}<N>"
									break
									;;
								*eta*|*cn:*)
									ETA=${LOG_LINE:l}
									case ${ETA} in
										*mib*) LINE_COLOR='<B><w>';;
										*kib*) LINE_COLOR='<B><c>';;
										*) LINE_COLOR='<B><r>';;
									esac
									msg_box -C -jl "${LINE_COLOR}${MSG}<N>"
									;;
								*)
									tcup $(( _CONT_COORDS[X] + _CONT_COORDS[H] )); tput ech 80
									tcup $(( _CONT_COORDS[X] + _CONT_COORDS[H] )) $(( _CONT_COORDS[Y] + 2 )); printf "%s" ${MSG}
									sleep .1
									;;
							esac
						elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]]; then
							case ${LOG_LINE:l} in
								*moving*)
									spinner stop
									logit ${_YT_DBG_LOG} "${0}: COMPLETED"
									_DOWNLOADS[${M}]='true'
									post_process
									log_add ${M}
									MSG="$(str_rpad "Download is complete" ${_MAX_MSG_LEN})"
									msg_box -C -jl "<B><g>${MSG}<N>"
									break
									;;
								*size*|*eta*)
									ETA=${LOG_LINE:l}
									case ${ETA} in
										*mib*) LINE_COLOR='<B><w>';;
										*kib*) LINE_COLOR='<B><c>';;
										*) LINE_COLOR='<B><r>';;
									esac
									msg_box -C -jl "${LINE_COLOR}${MSG}<N>"
									;;
								*)
									tcup 20 45; printf "%s" ${MSG}
									sleep .1
									;;
							esac
						fi
					fi
				fi

				# Tick the spinner continuously on every loop iteration
				spinner tick
			done
			exec 3<&-
			log_clear ${0}
			sleep 1 # Job request delay
		done # List complete

		for M in ${_MARKED};do
			[[ ${_DOWNLOADS[${M}]} == 'true' ]] && list_set_selected ${M} ${_STALE_ROW} || list_set_selected ${M} ${_AVAIL_ROW}
		done

		_MARKED=()
		trap - INT # Downloads are finished; cancel trap
	} always {
		stty echo
	}
	return 0
}
