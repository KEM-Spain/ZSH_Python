#!/usr/bin/zsh
 
# Inline ansi
BOLD="\033[1m"
ITALIC="\033[3m"
RESET="\033[m"
REVERSE="\033[7m"
STRIKE="\033[9m"
UNDER="\033[4m"
BLINK="\033[5m"
BLACK_BG="\033[40m"
BLUE_FG="\033[34m"
CYAN_FG="\033[36m"
GREEN_FG="\033[32m"
MAGENTA_FG="\033[35m"
RED_FG="\033[31m"
WHITE_FG="\033[37m"
YELLOW_FG="\033[33m"
CSR_OFF="\033[?25l"
CSR_ON="\033[?25h"

CYAN_ON_GREY="\033[0m\033[0;1;36;100m"
GREEN_ON_GREY="\033[0m\033[0;1;32;100m"
MAGENTA_ON_GREY="\033[0m\033[0;1;35;100m"
RED_ON_GREY="\033[0m\033[0;1;31;100m"
RED_ON_WHITE="\033[0m\033[0;1;31;107m"
WHITE_ON_GREY="\033[0m\033[0;1;37;100m"
WHITE_ON_RED="\033[0m\033[0;1;31;100m"
YELLOW_ON_GREY="\033[0m\033[0;1;33;100m"

# Imports
[[ -z ${ZSH_LIB_DIR} ]] && _LIB_DIR=/usr/local/lib || _LIB_DIR=${ZSH_LIB_DIR}
source ${_LIB_DIR}/LIB_INIT.zsh
_DEPS+=(VALIDATE.zsh PATH.zsh DATE.zsh UTILS.zsh LIST.zsh SELECT.zsh CENTER.zsh)
source ${_LIB_DIR}/LIB_DEPS.zsh

zmodload zsh/stat
zmodload zsh/datetime

# Declarations
typeset -A _CANCELLED=()
typeset -A _CONT_COORDS=()
typeset -A _DOWNLOADS=()
typeset -A _ENG_CODES=(youtube Y rumble R)
typeset -A _FAILED=()
typeset -A _FAV_LIST=()
typeset -A _FIELD_LEN=()
typeset -A _FUTURE=()
typeset -A _IND_COORDS=()
typeset -A _INFO_COORDS=()
typeset -A _MENU_TYPES=(1 Custom 2 Rumble 3 YouTube)
typeset -A _MSG_DELAY=(SHORT .5 MED 2 LONG 4)
typeset -A _OB=()
typeset -A _PARTIALS=()
typeset -A _QUERY_OPTS=()
typeset -A _QUICK_DOWNLOAD=()
typeset -A _REJECTS=()
typeset -A _RUMBLE_QTYPES=(l live g general u user c channel)
typeset -A _RUMBLE_ROWS=()
typeset -A _SEEN=()
typeset -A _SORT_TABLE=()
typeset -A _STATUS_MSGS=()
typeset -a _QUERY_REJECTS=()
typeset -a _RUMBLE_PAGE=()
typeset -a _RUMBLE_QRY_OPTS=(l c u g)
typeset -a _STERMS=()
typeset -a _STRIP_WORDS=()
typeset -aU _LOCAL_LIST=()

# Display Constants
_CONT_WIDTH=86
_IND_W=25 # Offsets X=2, Y=30
_INFO_W=$((_CONT_WIDTH - 6 ))

_CONT_COORDS=(X 10 Y $(center -H -w${_CONT_WIDTH}) H 10 W ${_CONT_WIDTH}) # Continuous box coords
_IND_COORDS=(X $(center -X -c"${(kv)_CONT_COORDS}" -h4 -x1) Y $(center -Y -c"${(kv)_CONT_COORDS}" -w${_IND_W} -y30) H 4 W ${_IND_W}) # Indicator display coords
_INFO_COORDS=(X $(center -X -c"${(kv)_CONT_COORDS}" -h4) Y $(center -Y -c"${(kv)_CONT_COORDS}" -w${_INFO_W}) H 5 W ${_INFO_W}) # Info display coords

# Constants
_CFG_DIR=~/.local/share/yts
_ACTION=download
_DOWNLOAD_DIR=~/Downloads/Torrents/Library/Web
_FIELD_LEN[age]=30
_FIELD_LEN[agetime]=40
_FIELD_LEN[author]=26
_FIELD_LEN[title]=80
_JS_SCRIPT=${_CFG_DIR}/yts.js
_MAX_DL_TITLE=74
_MAX_FLEN=120
_MAX_LS_TITLE=80
_MSG_BOX_DISPLAY_AREA=60 # Limit continuous box clearing on Y axis to preserve alert space
_OBJECT="video"
_SORT_DEFAULT=(youtube 1:a rumble 1:a)
_STRIP_WORDS=("judge napolitano" "official" "^the " " show" "youtube" "channel" "deep dive" "deep focus podcast")
_TRANS_ERR_LIMIT=6
_YTS_DOWNLOAD_LOG=${_CFG_DIR}/yts.downloads
_YTS_FAVORITES=${_CFG_DIR}/yts.favorites
_YTS_FAV_NEW=${_CFG_DIR}/yts.favorites.new
_YTS_UPD_MARKER=${_CFG_DIR}/yts-upd.lastrun
_YTS_URL_LOG=${_CFG_DIR}/yts.url.log
_YT_DBG_LOG=${_CFG_DIR}/yt.dbg.log

# Globals
g_CMDLINE_ARGS=false
g_INDICATOR_FLIP=false
g_LAST_CODE_UPD=?
g_LAST_FAV_TYPE=y
g_LAST_SPEED=0
g_LAST_STYPE=0
g_MASK_NDX=1
g_PID=?
g_PREFER_LIVE=''
g_PRESERVE_LOG=false
g_PROXY_CMD=''
g_WHEN=''
g_YTS_LOG=''
g_SNDX=0

# Functions
action_do () {
	local AUTHOR=''
	local DEST=''
	local DEST_1=''
	local DEST_2=''
	local DEST_LINE=''
	local DL_CNT=0
	local DUP_LINE=''
	local ETA=''
	local FRAME_PAD=8
	local HDR1_TXT=0
	local HDR2_TXT=0
	local HDRS_OUT=false
	local HDR_LEN=0
	local HRZ_CTR=0
	local INFO_TAG=''
	local INT_KEY=''
	local LAST_MSG=''
	local LAST_TRANS_MSG=''
	local LINE_COLOR=''
	local LOG_LINE=''
	local MSG=''
	local MAX_HDR=$(( _CONT_COORDS[W] - 15 ))
	local NDX=0
	local RETRIES=0
	local SPEED=0
	local TEXT=''
	local TITLE=''
	local TRANS_ERR_CNT=0
	local TRANS_ERR_MSG=0
	local URL=''
	local M

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	for M in ${_MARKED};do
		((DL_CNT++))
		_QUICK_DOWNLOAD[${M}]=false
		_CANCELLED[${DL_CNT}]=false
		_DOWNLOADS[${DL_CNT}]=false
		_FAILED[${DL_CNT}]=false
		_FUTURE[${DL_CNT}]=false
		AUTHOR=$(get_field author ${M})
		TITLE=$(get_field title ${M})
		URL=$(get_field url ${M})
		RETRIES=0
		HDRS_OUT=false

		logit ${_YTS_URL_LOG} "${AUTHOR}:${TITLE}:${URL}"

		unsetopt localtraps # Initialize CTRL-C trap
		trap job_kill INT

		job_start ${URL} ${TITLE}
		msg_box -t${_MSG_DELAY[LONG]} -O${CYAN_FG} -H1 -P"<w><I>Use key:<c>(<w>k<c>)<w> to <B><r>cancel<N><w> download<N>" -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} "<g>Download Requested...<N>"

		while true;do
			((NDX++))

			# Handle job reset
			INT_KEY=''
			read -s -t0.1 -k1 INT_KEY
			if [[ ${INT_KEY} == 'k' ]];then 
				job_reset
				logit ${_YT_DBG_LOG} "${0}: JOB CANCELLED"
				MSG="Cancelling download..."
				msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
				_CANCELLED[${M}]=true
				break
			fi
			
			if [[ ${_QUICK_DOWNLOAD[${M}]} == 'false' ]];then
				_QUICK_DOWNLOAD[${M}]=true
				if grep -Eiq '100%' ${g_YTS_LOG};then # Capture very small/quick file download - whole file grep
					logit ${_YT_DBG_LOG} "${0}: COMPLETED (very small file) NDX:${NDX}"
					MSG="<w>Small Download <g>is complete...<N>"
					msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|${MSG}"
					_DOWNLOADS[${M}]=true
					logit ${_YT_DBG_LOG} "${0}: POST-PROCESSING"
					post_process
					log_add ${M}
					break
				fi
			fi

			LOG_LINE=$(tail -1 ${g_YTS_LOG}) # Get last log line
			if grep -Eq '' <<<${LOG_LINE};then # Progress section
				LOG_LINE=$(sed "s//\n/g" <<<${LOG_LINE} | tail -1 | str_trim) 2>/dev/null # Convert linefeeds to newlines - get last trimmed
			fi

			if [[ ${HDRS_OUT} == 'false' ]];then 
				case ${LOG_LINE:l} in
					*sleeping*|*hlsnative*|*^\[info\]*)
						MSG="Pre-Processing: ${LOG_LINE[1,60]}"
						logit ${_YT_DBG_LOG} "${0}: PRE-PROCESSING"
						msg_box -z -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
						continue
						;;
					*'already been'*|*100%*)
						logit ${_YT_DBG_LOG} "${0}: ALREADY DOWNLOADED"
						MSG=$(sed -E "s#^(.*/)(.*)( has.*)#\2#" <<<${LOG_LINE})
						MSG=${MSG[1,60]}
						msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>|<B>Has already been downloaded<N>"
						_DOWNLOADS[${M}]=true
						break
						;;
					*'will begin'*|*premieres*|*upcoming*)
						logit ${_YT_DBG_LOG} "${0}: FUTURE"
						[[ ! ${LOG_LINE:l} =~ 'minute*|hour*|day*' ]] && g_WHEN='soon' || g_WHEN=$(perl -pe 's/^(.*) in (\d+\s+\w+)(.*)$/\2/g' <<<${LOG_LINE})
						MSG="<w>${TITLE[1,65]}<N>|<r><B>Not yet available<N> - Airing time:<w>${g_WHEN}<N>"
						msg_box -z -t${_MSG_DELAY[LONG]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>${MSG}<N>"
						_FUTURE[${M}]=true
						_DOWNLOADS[${M}]=false
						break
						;;
					*yt_live_broadcast*)
						MSG="Live broadcast - unable to download"
						msg_box -c -z -A"${(kv)_INFO_COORDS}" "|<Z>|<r>${MSG}<N>"
						logit ${_YT_DBG_LOG} "${0}: LIVE BROADCAST"
						_FAILED[${M}]=true
						_DOWNLOADS[${M}]=false
						/bin/rm -f ${_DOWNLOAD_DIR}/*part # Clear any intermediate files
						break
						;;
					*error*|*warning*)
						((TRANS_ERR_CNT++))
						TRANS_ERR_MSG=$(parse_err_msg ${LOG_LINE})
						logit ${_YT_DBG_LOG} "${0}: PRE TRANSMISSION ERROR ${TRANS_ERR_CNT} of ${_TRANS_ERR_LIMIT}"
						if [[ ${TRANS_ERR_CNT} -ge ${_TRANS_ERR_LIMIT} ]];then
							_FAILED[${M}]=true
							_DOWNLOADS[${M}]=false
							g_PRESERVE_LOG=true
							break
						else
							msg_box -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "<w>Retrying...<r>Error<N>:${TRANS_ERR_CNT} <w>${TRANS_ERR_MSG}<N>"
							job_retry ${URL} ${TITLE}
						fi
						;;
					*)
						DEST_LINE=$(grep -Ei 'destination' ${g_YTS_LOG}) # Capture destination - whole file grep
						if [[ ${?} -eq 0 ]];then
							logit ${_YT_DBG_LOG} "${0}: GENERATING HEADER"
							DEST=("${(f)$(sed -e "s#${_DOWNLOAD_DIR}/#${_DOWNLOAD_DIR}|#g" -e 's/ \[.*//g' <<<${DEST_LINE})}") # Delimit file and path
							DEST_1="${${(@s/|/)DEST}[1]}" # Isolate path
							DEST_1="${(z)${(@s/]/)DEST_1}[2,-1]}" # Remove leading log tag
							EG_ON;DEST_1=${DEST_1/(#b)(Destination)/<w>${match[1]}<N>:<w>};EG_OFF # Add color codes

							HDR1_TXT="${${(@s/|/)${DEST:r}}[2]//_/ }" # Clear file name
							HDR1_TXT=$(trim_title ${HDR1_TXT})
							HDR1_TXT="<w>Downloading<N>: <f><w>$(clean_title ${HDR1_TXT} ${_MAX_HDR})<N>"
							HDR2_TXT="$(str_trim ${DEST_1})<N> - <w>${DL_CNT} <N>of <w>${#_MARKED}<N>${INFO_TAG}"
							HDR_LEN=$(( ${#$(msg_nomarkup ${HDR2_TXT})} ))
							HDR_LEN=$(( HDR_LEN + FRAME_PAD ))
							HRZ_CTR=$(center -H -w${HDR_LEN}) # Horiz center

							[[ ${HDR_LEN} -gt ${_CONT_COORDS[W]} ]] && _CONT_COORDS[W]=${HDR_LEN} && _CONT_COORDS[Y]=${HRZ_CTR} # Adjust frame width/center

							msg_box -C -O${CYAN_FG} -I -H3 -jl -x${_CONT_COORDS[X]} -y${_CONT_COORDS[Y]} -h${_CONT_COORDS[H]} -w${_CONT_COORDS[W]} ${HDR1_TXT}
							msg_box -C -jl ${HDR2_TXT}
							msg_box -C -jl "<c>$(str_unicode_line $(( _CONT_COORDS[W] - 2 )))<N>" # Divider line
							HDRS_OUT=true
							continue
						fi
						;;
				esac
			else # HDRS_OUT == true
				case ${LOG_LINE:l} in
					*100%*|*fix*|*remux*)
						logit ${_YT_DBG_LOG} "${0}: COMPLETED"
						msg_box -C -jl "<B><g>Download is complete<N>" # Show completed message
						_DOWNLOADS[${M}]=true
						logit ${_YT_DBG_LOG} "${0}: POST-PROCESSING"
						post_process
						log_add ${M}
						break
						;;
					*error*|*warning*)
						TRANS_ERR_MSG=$(parse_err_msg ${LOG_LINE})
						if [[ ${TRANS_ERR_MSG} != ${LAST_TRANS_MSG} ]];then
							((TRANS_ERR_CNT++))
							logit ${_YT_DBG_LOG} "${0}: TRANSMISSION ERROR ${TRANS_ERR_CNT} of ${_TRANS_ERR_LIMIT}"
							LAST_TRANS_MSG=${TRANS_ERR_MSG}
							if [[ ${TRANS_ERR_CNT} -ge ${_TRANS_ERR_LIMIT} ]];then
								_FAILED[${M}]=true
								_DOWNLOADS[${M}]=false
								g_PRESERVE_LOG=true
								break
							else
								msg_box -t${_MSG_DELAY[MED]} -A"${(kv)_INFO_COORDS}" "|<Z>|<w>Retrying...<N> ${TRANS_ERR_CNT}:${TRANS_ERR_MSG}"
								job_retry ${URL} ${TITLE}
							fi
						fi
						;;
					*eta*)
						SPEED=$(get_speed ${LOG_LINE}) && download_indicator ${SPEED}
						ETA=${LOG_LINE}
						case ${LOG_LINE:l} in
							*100*%) LINE_COLOR='<B><g>';;
							*mib/s*) LINE_COLOR='<w>';;
							*kib/s*) LINE_COLOR='<B><y>';;
						esac
						msg_box -C -jl "${LINE_COLOR}${ETA[1,59]}<N>"
						continue
						;;
				esac
			fi
			sleep .2 # Log fetch delay
		done
		NDX=0
		log_clear "action_do"
		sleep 1 # Job request delay
	done # List complete

	for M in ${_MARKED};do
		[[ ${_DOWNLOADS[${M}]} == 'true' ]] && list_set_selected ${M} ${_STALE_ROW} || list_set_selected ${M} ${_AVAIL_ROW}
	done

	_MARKED=()
	trap - INT # Downloads are finished; cancel trap
	return 0
}

action_warn () {
	local M
	
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	msg_box -x$(( _CONT_COORDS[X] )) -H1 -p -PG "<w><I>Please respond<N>|<Z>|${#_MARKED} $(str_pluralize ${_OBJECT} ${#_MARKED}) selected"

	if [[ ${_MSG_KEY} == 'n' ]];then
		for M in ${_MARKED};do
			_MARKED[${M}]=0
			list_set_selected ${M} ${_AVAIL_ROW}
		done
	fi
}

cfg_init () {
	local CFG_STATE=0
	local -A CFG_MSGS=(1 "Missing configuration directory:${_CFG_DIR}" 2 "Missing favorites file:${_YTS_FAVORITES}")

	[[ -e ${_YT_DBG_LOG} ]] && /bin/rm -f ${_YT_DBG_LOG} # Clear any existing log
	[[ -d ${_CFG_DIR} ]] && CFG_STATE=0 || CFG_STATE=1 # Dir exists
	[[ -f ${_YTS_FAVORITES} ]] && CFG_STATE=0 || CFG_STATE=2 # Favorites file found

	echo ${CFG_MSGS[${CFG_STATE}]}

	return ${CFG_STATE}
}

clean_title () {
	local TITLE=${1}
	local MAX_HDR=${2:=${_MAX_DL_TITLE}}
	local STR=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	STR=$(title_scrubber ${TITLE} ${_YT_DBG_LOG})
	STR=$(keyword_strip <<<${STR})
	STR=$(sed "s/${_QUERY_OPTS[QKEY]:l}/${_QUERY_OPTS[DKEY]}/I" <<<${STR}) # Use DKEY

	[[ -n ${STR} ]] && TITLE=$(str_word_clip ${STR} ${MAX_HDR}) # Limit length at word boundary

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "RETURNING TITLE:${TITLE}"

	echo ${TITLE}
}

dashed_line () {
	local CNT=10
	local LEN=5
	local X=0
	local STR=''

	for ((X=0; X<=CNT; X++));do
		STR+="$(str_unicode_line ${LEN}) "
	done
	
	echo "${STR}"
}

download_indicator () {
	local SPEED="${${(@s/./)${1}}[1]}"
	local STYPE="${${(@s/|/)${1}}[2]}"
	local L_OBJ="\\u23FA"
	local M_OBJ="\\u25CF"
	local R_OBJ="\\u2B24"
	local -A OBJS=()
	local -A OBJS_1=(1 ${L_OBJ} 2 ${M_OBJ} 3 ${R_OBJ})
	local -A OBJS_2=(1 ${R_OBJ} 2 ${M_OBJ} 3 ${L_OBJ})
	local BORDER_COLOR=''
	local DELAY=.3
	local IND_X=$(( _IND_COORDS[X] + 1 ))
	local IND_Y=$(( _IND_COORDS[Y] + 7 ))
	local L_SIDE="\\u2770"
	local R_SIDE="\\u2771"
	local MASK=""
	local OBJ_COLOR="${BOLD}${WHITE_FG}" # Default
	local SP_DIR=I

	[[ -z ${SPEED} ]] && SPEED=0
	[[ -z ${g_LAST_SPEED} ]] && g_LAST_SPEED=0

	if [[ ( ${STYPE} == 'M' && ${g_LAST_STYPE} == 'K' ) || ${SPEED} -ge ${g_LAST_SPEED} ]];then 
		SP_DIR=I # Stable or Increasing
	elif [[ ( ${STYPE} == 'K' && ${g_LAST_STYPE} == 'M' ) || ${SPEED} -lt ${g_LAST_SPEED} ]];then 
		SP_DIR=D # Decreasing
	fi

	#logit ${_YT_DBG_LOG} "${0}: SPEED:${SPEED}"

	case ${SPEED} in
		<1-2>) OBJ_COLOR="${BOLD}${RED_FG}";; # YouTube
		<3-4>) OBJ_COLOR="${BOLD}${MAGENTA_FG}";;
		<5-6>) OBJ_COLOR="${BOLD}${CYAN_FG}";;
		<7-10>) OBJ_COLOR="${BOLD}${GREEN_FG}";;
		<11-20>) OBJ_COLOR="${BOLD}${WHITE_FG}";;
		<21-30>) OBJ_COLOR="${BOLD}${CYAN_FG}";;
		<31-40>) OBJ_COLOR="${BOLD}${WHITE_FG}";;
		*) OBJ_COLOR="${BOLD}${GREEN_FG}";;
	esac

	case ${SP_DIR} in
		I) BORDER_COLOR="${BOLD}${GREEN_FG}";;
		D) BORDER_COLOR="${BOLD}${YELLOW_FG}";;
	esac

	OBJS=(${(kv)OBJS_1}) # Init

	if [[ ${g_INDICATOR_FLIP} == 'true' ]];then
		OBJS=(${(kv)OBJS_2})
	fi

	case ${g_MASK_NDX} in
		1) MASK="${BORDER_COLOR}${L_SIDE}${RESET} ${OBJ_COLOR}${OBJS[1]}    ${RESET} ${BORDER_COLOR}${R_SIDE}${RESET}";;
		2) MASK="${BORDER_COLOR}${L_SIDE}${RESET} ${OBJ_COLOR}  ${OBJS[2]}  ${RESET} ${BORDER_COLOR}${R_SIDE}${RESET}";;
		3) MASK="${BORDER_COLOR}${L_SIDE}${RESET} ${OBJ_COLOR}    ${OBJS[3]}${RESET} ${BORDER_COLOR}${R_SIDE}${RESET}";;
	esac

	if [[ ${g_MASK_NDX} -eq 3 ]];then
		[[ ${g_INDICATOR_FLIP} == 'true' ]] && g_INDICATOR_FLIP=false || g_INDICATOR_FLIP=true
	fi

	(( g_MASK_NDX++))
	[[ ${g_MASK_NDX} -gt 3 ]] && g_MASK_NDX=1

 	tcup ${IND_X} ${IND_Y} && echo -n "${MASK}" && sleep ${DELAY}

	g_LAST_SPEED=${SPEED}
	g_LAST_STYPE=${STYPE}
}

download_select () {
	local SEARCHTERM=${1}
	local SEARCHTYPE=''
	local TITLE
	local FLST
	local STR
	local L F

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	SEARCHTYPE=Videos

	_SORT_TABLE=(1 1 2 2 3 3) # Age, author, title

	if [[ ${_QUERY_OPTS[ENGINE]:l} == 'youtube' ]];then
		[[ ${_QUERY_OPTS[EOPT]:l} == 's' ]] && SEARCHTYPE="Strict (${_QUERY_OPTS[SMSG]} rejected)"
	fi

	# Set headings
	list_set_header_init
	list_set_header 'printf "Found:${WHITE_FG}%-d${RESET} $(str_pluralize video ${#_LIST})\tPlatform:${WHITE_FG}%s${RESET}\tQuery Key:${WHITE_FG}%s${RESET}\tQuery Type:${WHITE_FG}%s${RESET}\tSelected:${WHITE_FG}%s${RESET}\t${_PG}" ${#_LIST} ${(C)_QUERY_OPTS[ENGINE]} ${(C)SEARCHTERM} ${(C)_QUERY_OPTS[TYPE]} $(list_get_selected_count)'
	list_set_header 'printf " "'
	list_set_header 'printf "%*s %-*s %-*s %-*s" 5 "" ${_FIELD_LEN[age]} "Age" ${_FIELD_LEN[author]} "Author" ${_FIELD_LEN[title]} "Title"'
	list_set_header 'printf "%*s ${SCOL1_CLR}%-*s${RESET} ${SCOL2_CLR}%*s${RESET} ${SCOL3_CLR}%*s${RESET}" 5 "" ${_FIELD_LEN[age]} "$(str_unicode_line ${_FIELD_LEN[age]})" ${_FIELD_LEN[author]} "$(str_unicode_line ${_FIELD_LEN[author]})" ${_FIELD_LEN[title]} "$(str_unicode_line ${_FIELD_LEN[title]})"'

	# Set line item
	list_set_line_item ' 
	local ITEM_COLOR=$(set_item_color $(item_decorate ${_LIST_NDX}));
	printf "${BOLD}${WHITE_FG}%4s${RESET}${_MARKER} ${SHADE}${BAR}${ITEM_COLOR}%-${_FIELD_LEN[age]}s${RESET}${SHADE}${BAR} %-${_FIELD_LEN[author]}s %-${_FIELD_LEN[title]}s${RESET}\n" ${_LIST_NDX} "$(item_decorate ${_LIST_NDX})"  "$(get_field author ${_LIST_NDX})"  "$(get_field title ${_LIST_NDX})"
	'
	list_set_select_action ${_ACTION}
	list_set_action_msgs video download
	list_set_sortable true
	list_set_searchable false
	list_set_barlines true
	list_set_page_callback log_find 
	list_set_sort_defaults ARRAY "_LIST" COL 1 ORDER "a" DELIM ${_LIST_DELIM} TYPE "flat" TABLE "${(kv)_SORT_TABLE}" MAXCOL 3

	while true;do
		# Generate list for selected title
		list_select ${_LOCAL_LIST}
		[[ ${?} -eq 0 ]] && break

		_MARKED=($(list_get_selected))
		
		if [[ $(list_get_selected_count) -ne 0 ]];then
			action_warn
			if [[ ${_MSG_KEY} == "y" ]];then
				action_do
			fi
			_LIST_SELECTED=()
		fi
	done

	_LOCAL_LIST=()
	_SORT_TABLE=()
	_CANCELLED=()
	_DOWNLOADS=()
	_FAILED=()
	_FUTURE=()
}

fav_add () {
	local -a EXISTING_KEYS=()
	local -aU HISTORY
	local CNT=0
	local FAV=''
	local LNUM=''
	local MENU_KEY=''
	local MENU_SEL=''
	local MK=''
	local NEW_KEY=''
	local UPD_KEY=false
	local KEY_MATCH=''
	local DK=''
	local STRICT_VAL=''
	local K

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	clear

	[[ ${_QUERY_OPTS[EOPT]:l} == 's' ]] && STRICT_VAL="S" || STRICT_VAL=""

	msg_box -H1 -p -PC "<w><I>Please respond<N>|<Z>|Add \"${_QUERY_OPTS[QKEY]}\" to favorites?"
	[[ ${_MSG_KEY} != 'y' ]] && return

	while true;do
		msg_box -c -H1 -p -PS -jl "<w>Select Favorites List<N>|$(msg_list_number ${(ov)_MENU_TYPES})"
		[[ ${_MSG_KEY} -eq 0 ]] && break
		MENU_SEL=${_MENU_TYPES[${_MSG_KEY}]}
		[[ -z ${MENU_SEL} ]] && msg_box -p -PK "Invalid option" && continue
		MENU_SEL=${MENU_SEL[1]:u} 
		break
	done
	[[ -z ${MENU_SEL} ]] && return 1

	EXISTING_KEYS=("${(f)$(grep -Ei "${_QUERY_OPTS[QKEY]}|${_QUERY_OPTS[DKEY]:gs/ /_/}" ${_YTS_FAVORITES})}")

	for K in ${EXISTING_KEYS};do
		DK="${${(@s/|/)K}[1]}"
		MK="${${(@s/|/)K}[3]}"
		MENU_KEY=${MK[1]}
		if [[ ${MENU_KEY:l} == ${MENU_SEL:l} ]];then
			UPD_KEY=true
			_QUERY_OPTS[DKEY]="${${(@s/|/)K}[1]}"
			KEY_MATCH=${K} # Key for selected menu exists
		fi
	done

	[[ -n ${DK} ]] && _QUERY_OPTS[DKEY]=${DK} # Retain display key if match was QKEY

	case ${MENU_SEL:l} in
		c) if [[ ${_QUERY_OPTS[ENGINE]} == 'youtube' ]];then # Custom requires ECODE
				NEW_KEY="${_QUERY_OPTS[DKEY]:gs/ /_/}|${_QUERY_OPTS[QKEY]}|${MENU_SEL}${_QUERY_OPTS[ECODE]}${STRICT_VAL}"
			elif [[ ${_QUERY_OPTS[ENGINE]} == 'rumble' ]];then
				NEW_KEY="${_QUERY_OPTS[DKEY]:gs/ /_/}|${_QUERY_OPTS[QKEY]}|${MENU_SEL}${_QUERY_OPTS[ECODE]}${_QUERY_OPTS[EOPT]}"
			fi;;
		r) NEW_KEY="${_QUERY_OPTS[DKEY]:gs/ /_/}|${_QUERY_OPTS[QKEY]}|${MENU_SEL}${_QUERY_OPTS[EOPT]}";;
		y) NEW_KEY="${_QUERY_OPTS[DKEY]:gs/ /_/}|${_QUERY_OPTS[QKEY]}|${MENU_SEL}${STRICT_VAL}";;
	esac

	msg_box -c -t${_MSG_DELAY[MED]} "<w>Adding<N>: \"${_QUERY_OPTS[DKEY]}\"|<w>to<N> ${MENU_TYPES[${_MSG_KEY}]} <w>list<N>"

	if [[ ${UPD_KEY} == 'true' ]];then
		if [[ ${KEY_MATCH:l} == ${NEW_KEY:l} ]];then
			msg_box -c -t${_MSG_DELAY[LONG]} -s# "Key:<w>${KEY_MATCH}<N>#<r>Matching key already exists<N>#Nothing to do!"
			return 2
		fi
		msg_box -c -p -PK -H1 -s# "<r>Duplicate Menu Key<N>#${KEY_MATCH}#<r>already exists<N>#<Z>#Replace with:#${NEW_KEY}#(Y/N)"
		[[ ${_MSG_KEY} != 'y' ]] && return 1
		LNUM="${${(@s/:/)$(grep -ni ${KEY_MATCH} ${_YTS_FAVORITES})}[1]}" # Get line number of existing key
		if [[ -n ${LNUM} ]];then
			sed -i "${LNUM}d" ${_YTS_FAVORITES} # Delete line number
			sed -i "${LNUM}i ${NEW_KEY}" ${_YTS_FAVORITES} # Insert replacement
		else
			msg_box "${0}: grep error - unable to locate line for key"
		fi
	else
		echo ${NEW_KEY:l} >> ${_YTS_FAVORITES} # Append new key to file
	fi

	sort -o ${_YTS_FAVORITES}{,} # In-place sort
	return 0
}

fav_delete () {
	local DKEY=${1:gs/ /_/}
	local MKEY=${2:u}
	local -a FAV_KEYS=()
	local F3=''
	local MK=''
	local KEY_MATCH=''
	local K

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	FAV_KEYS=("${(f)$(grep -Ei ${DKEY} ${_YTS_FAVORITES})}") # Locate via display key

	for K in ${FAV_KEYS};do
		F3="${${(@s/|/)K}[3]}"
		MK=${F3[1]} # First char
		[[ ${MK:l} == ${MKEY:l} ]] && KEY_MATCH=${K} # Ensure corresponding menu matches
	done

	if [[ -n ${KEY_MATCH} ]];then
		msg_box -c -p -PD -H1 "<B><r>Deleting Menu Key<N>|${KEY_MATCH:gs/|/#/}"
		if [[ ${_MSG_KEY} == 'y' ]];then
			cp ${_YTS_FAVORITES} ${_YTS_FAVORITES}.bak
			sed -i "/${KEY_MATCH}/d" ${_YTS_FAVORITES}
			return ${?}
		fi
	else
		return 1
	fi
}

fav_get () {
	local -a C_LIST=()
	local -a R_LIST=()
	local -a Y_LIST=()
	local FTR=''
	local HDR=''
	local HDR_TAG=" <I>(Custom List)<N> "
	local LIST=''
	local MAP="(<w>r<N>)umble, (<w>y<N>)outube, (<w>c<N>)ustom, (<w>d<N>)elete favorite"
	local MENU_LBL=''
	local MENU_TYPE=''
	local OPTS=''
	local O_COLOR=''
	local TAG=''
	local L


	for L in ${(k)_FAV_LIST};do # [DKEY]="QKEY:OPTS"
		OPTS="${${(@s/:/)${_FAV_LIST[${L}]}}[2]}"
		MENU_TYPE=${OPTS[1]:l} # Embedded in OPTS
		case ${MENU_TYPE} in
			c) C_LIST+="${(C)L:gs/_/ /}";;
			r) R_LIST+="${(C)L:gs/_/ /}";;
			y) Y_LIST+="${(C)L:gs/_/ /}";;
		esac
	done

	while true;do
		case ${g_LAST_FAV_TYPE} in
			c) LIST=(${C_LIST})
				MENU_LBL='custom'
				HDR_TAG=${CUSTOM_MSG}
				O_COLOR=${GREEN_FG}
				;;
			r) LIST=(${R_LIST})
				MENU_LBL='rumble'
				HDR_TAG=''
				O_COLOR=${MAGENTA_FG}
				;;
			y) LIST=(${Y_LIST})
				MENU_LBL='youtube'
				HDR_TAG=''
				O_COLOR=${CYAN_FG}
				;;
		esac

		clear

		TAG="${MENU_LBL}.${g_LAST_FAV_TYPE}.query"
		HDR="<B><w>${(C)MENU_LBL}${HDR_TAG} <B>Query<N>"
		FTR="Run <w>${(C)MENU_LBL}<N> query, <w>(<N>s<w>)<N>how keys<N>, or <w>(<N>q<w>)<N>uit<N>"

		sel_set_app_keys d r y c
		sel_set_list ${LIST}

		msg_line_weight heavy
		sel_list -R -S -T${TAG} -O${O_COLOR} -H${HDR} -M${MAP} -F${FTR}
		msg_line_weight light

		if [[ ${_SEL_KEY} == 'd' ]];then
			fav_delete ${_SEL_VAL} ${g_LAST_FAV_TYPE} # Call key delete
			[[ ${?} -eq 0 ]] && fav_load && return 1 # Reload favorites & return
		fi

		[[ ${_SEL_KEY} =~ 'y|r|c' ]] && g_LAST_FAV_TYPE=${_SEL_KEY}
		if [[ ${_SEL_KEY} == '?' ]];then
			_QUERY_OPTS[FKEY]=${_SEL_VAL:l} # Store selected _FAV_LIST key
			break
		fi
	done
	return 0
}

fav_load () {
	local LINE
	local DISPLAY_LABEL
	local Q_KEY
	local Q_OPTS

	_FAV_LIST=()

	[[ ! -f ${_YTS_FAVORITES} ]] && return 1

	while read LINE;do
		DISPLAY_LABEL="${${(@s/|/)LINE}[1]}"
		Q_KEY="${${(@s/|/)LINE}[2]}"
		Q_OPTS="${${(@s/|/)LINE}[3]}"
		_FAV_LIST[${DISPLAY_LABEL}]="${Q_KEY}:${Q_OPTS}"
	done < ${_YTS_FAVORITES}

	[[ -n ${_FAV_LIST} ]] && return 0 || return 1
}

filter_rumble_data () {
	local LINE
	while read -r LINE;do
		[[ -z ${LINE} ]] && continue
		[[ ${LINE} =~ '^[Vv]erified$' ]] && continue
		[[ ${LINE} =~ '^LIVE$' ]] && continue
		LINE=$(tr '\011' ' ' <<< ${LINE}) # Tabs to spaces
		LINE=$(tr -d '\012' <<< ${LINE}) # Line feeds
		LINE=$(tr '|' '#' <<< ${LINE}) # Embedded pipes to hash
		str_trim <<< ${LINE}
	done
}

get_field () {
	local FIELD=${1}
	local NDX=${2}
	local -A FIELD_MAP=("age" 1 "author" 2 "title" 3 "url" 4 "time" 5 "agetime" 6)
	local STR=''
	local TSTR=''

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# TODO: agetime is malformed - investigate
	case ${FIELD} in
		age) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[age]}]}";;
		agetime) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[agetime]}]}";;
		author) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[author]}]}";;
		time) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[time]}]}";;
		title) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[title]}]}";;
		url) STR="${${(@s/|/)${_LIST[${NDX}]}}[${FIELD_MAP[url]}]}";;
	esac

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${0}: Parsed FIELD:${FIELD} STR:${STR}"

	if [[ ${FIELD} == 'agetime' ]];then
		[[ ${STR:l} =~ 'views' ]] && STR=$(sed -E 's/^(.*views )(.*ago)(.*)/(\2)/' <<<${STR})
		[[ ${STR:l} =~ 'live' ]] && STR=$(sed -E 's/(.*ago)( live)(.*)/\1)/I' <<<${STR})
	fi

	if [[ ${FIELD} == 'author' ]];then
		if [[ ${_QUERY_OPTS[QKEY]} =~ ' ' ]];then # Query key contains a space
			STR=$(str_trim <<<${STR})
			[[ -z ${STR} ]] && STR=${(C)_QUERY_OPTS[DKEY]} # Ensure not blank
		else
			STR=${_QUERY_OPTS[DKEY]}
		fi
	fi

	if [[ ${FIELD} == 'title' ]];then
		STR=$(utf_to_iso ${STR})
		STR=$(str_word_clip ${STR} ${_FIELD_LEN[${FIELD}]})
	fi

	if [[ -n ${_FIELD_LEN[${FIELD}]} ]];then
		STR=${STR[1,${_FIELD_LEN[${FIELD}]}]}
	fi

	echo -n ${STR}
}

get_speed () {
	local SPEED=${@}
	local TYPE=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	SPEED=$(sed -E 's/^.*at\s+//' <<<${SPEED:l} | cut -d' ' -f1 | sed 's/[/]s//')
	[[ ${SPEED} =~ 'mib' ]] && TYPE=M || TYPE=K
	SPEED=$(sed 's/.ib//' <<<${SPEED})

	[[ ${SPEED} == '100%' ]] && SPEED=0 # Completed

	if validate_is_number ${SPEED};then
		echo "${SPEED}|${TYPE}"
	else
		echo "0|${TYPE}"
	fi
}

item_decorate () {
	local NDX=${1}
	local STR

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	if [[ ${_DOWNLOADS[${NDX}]} == 'true' ]];then
		STR="Downloaded..."
	elif [[ ${_CANCELLED[${NDX}]} == 'true' ]];then
		STR="Cancelled..."
	elif [[ ${_FAILED[${NDX}]} == 'true' ]];then
		STR="Failed..."
	elif [[ ${_FUTURE[${NDX}]} == 'true' ]];then
		STR="Future: ${g_WHEN:s/minutes/mins/}"
	elif [[ ${_PARTIALS[${NDX}]} == 'true' ]];then
		STR="Partial..."
	else
		STR=$(get_field agetime ${NDX})
	fi

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: STR:${STR}"

	echo -n ${STR}
}

job_kill () {
	local -a PIDS=()
	local PID
	local P

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	g_PRESERVE_LOG=false

	PIDS=("${(f)$(pgrep -n "yt-dlp")}")
	if [[ ${?} -eq 0 ]];then
		for P in ${PIDS};do
			kill -9 ${P} >/dev/null 2>&1
			find ${_DOWNLOAD_DIR} -maxdepth 1 \( -name '*part' -or -name '*ytdl' \) -exec rm -rf {} \;
			logit ${_YT_DBG_LOG} "${0}: Killed ${P}"
		done
	fi

	if [[ ! ${functrace[1]} =~ "job_reset" ]];then # Exit unless called by reset
		trap - INT # Disable trap
		log_clear "job_kill"
		exit_leave $(err_msg_exit "Download Job killed")
	fi
}

job_reset () {
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	job_kill
	logit ${_YT_DBG_LOG} "${0}: Job was reset"
}

job_retry () {
	local URL=${1}
	local TITLE=${2}

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	job_reset
	sleep .1
	job_start ${URL} ${TITLE}
}

job_start () {
	local URL=${1}
	local TITLE=${2}
	local CMD=''
	local K 

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	g_YTS_LOG=$(mktemp ${_CFG_DIR}/yt.log.XXXXXX)
	logit ${_YT_DBG_LOG} "${0}: DOWNLOAD LOG:${g_YTS_LOG}"
	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "Logging to file:${g_YTS_LOG}"

	logit ${g_YTS_LOG} "${0}: DOWNLOADING: ${_QUERY_OPTS[QKEY]} - ${TITLE}"
	CMD="nohup yt -o '%(channel)s - %(title).200s.%(ext)s' ${(qqq)URL}" # Routine download - limit title len

	[[ ! -w ${g_YTS_LOG} ]] && exit_leave $(err_msg_exit "Unable to access log file:${g_YTS_LOG}")
	echo "${0} CMD:${CMD}" >> ${g_YTS_LOG} 2>/dev/null # Log command

	eval "${CMD} >> ${g_YTS_LOG} >/dev/null 2>&1" & # Start background job
	g_PID=$!

	logit ${_YT_DBG_LOG} "${0}: TITLE:${TITLE}"
	logit ${_YT_DBG_LOG} "${0}: CMD:${CMD} PID:${g_PID}"

	echo "${0}: PID:${g_PID}" >> ${g_YTS_LOG} # Log pid

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: CMD:${CMD}"
}

keyword_strip () {
	local LINE=''
	local W

	read LINE

	for W in ${_STRIP_WORDS};do # Scrub keywords
		LINE=$(sed "s/${W}//I" <<<${LINE})
		LINE=$(str_trim <<<${LINE})
	done

	LINE=$(sed -E "s/(^-|-$)//" <<<${LINE})
	echo ${LINE}
}

last_code_update () {
	local MARKER_ARG=${1}
	local LAST_UPD=0
	local LAST_TIME=0

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"
	
	[[ -z ${MARKER_ARG} ]] && exit_leave $(err_msg_exit "Missing argument:<MARKER>")

	if [[ -e ${MARKER_ARG} ]];then
		LAST_UPD="${(z)${(@s/ /)$(/usr/bin/stat -c "%y" ${MARKER_ARG})}[1]}"

		[[ -e ${MARKER_ARG} ]] && LAST_TIME=$(zstat -F "%H:%M" +mtime -- "${MARKER_ARG}")

		echo "$(date_since_today ${_TODAY} ${LAST_UPD}) at ${LAST_TIME}"
	fi
}

last_file_downloaded () {
	local ST=''
	local FN=''
	local IN=''

	ST=$(/usr/bin/stat -c"%W|%i|%n" ${_DOWNLOAD_DIR}/* | sort -t'|' -k1 -r | head -1) # Sort by birth date; grab most recent
	FN="${${(@s/|/)ST}[3]}"
	IN="${${(@s/|/)ST}[2]}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: FN:${FN} INODE:${IN}"

	if [[ -e ${FN} ]];then
		echo "${FN}|${IN}"
		return 0
	else
		return 1
	fi
}

list_reset () {
	_LIST_SELECTED=()
	_MARKED=()
	_SELECTION_LIST=()
}

log_add () {
	local NDX=${1}
	local LF=$(last_file_downloaded) # Filename|Inode
	local FN="${${(@s/|/)LF}[1]}"
	local IN="${${(@s/|/)LF}[2]}"
	local TL=$(get_field title ${NDX}) # Title
	local AT=$(get_field agetime ${NDX}) # Age
	local AU=$(get_field author ${NDX}) # Author
	local TM=$(sed -E 's/^.*ago\s+(.*)\)/\1/' <<<${AT}) # Video length

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	[[ ${FN:e} == 'part' || ${FN:e} == 'temp' ]] && return # No partials in log

	echo "${IN}|${TL}|${FN:t}|${TM}|${AU}" >> ${_YTS_DOWNLOAD_LOG}
}

log_clear () {
	local FROM=${1}

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	[[ ! -e ${g_YTS_LOG} ]] && return

	if [[ ${g_PRESERVE_LOG} == 'false' ]];then
		rm -f ${g_YTS_LOG}
		logit ${_YT_DBG_LOG} "${0}: Temp log file:${g_YTS_LOG} was cleared for:${_QUERY_OPTS[QKEY]} from:${FROM}"
	else
		logit ${_YT_DBG_LOG} "${0}: DEBUG TRIGGERED - log ${g_YTS_LOG} was retained for:${_QUERY_OPTS[QKEY]}"
		msg_box -t3 "<w>Log was preserved<N>"
	fi
}

log_find () { 
	local TOP=${1} # Page top row supplied by LIST.zsh line 108
	local BOT=${2} # Page bot row supplied by LIST.zsh line 108
	local LINE_NUM=''
	local LIST_AU=''
	local LIST_TITLE=''
	local LIST_TM=''
	local LOG_AU=''
	local LOG_FN=''
	local LOG_LINE=''
	local LOG_TITLE=''
	local LOG_TM=''
	local R=0

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# Page callback - scan list to find downloaded items
	 
	_DOWNLOADS=()
	_PARTIALS=()

	for ((R=${TOP}; R <= ${BOT}; R++));do
		LINE_NUM=''

		LIST_TITLE=$(get_field title ${R}) # Title from list
		LIST_AU=$(get_field author ${R}) # Author from list
		LIST_TM=$(sed -E 's/^.*ago\s+(.*)\)/\1/' <<<$(get_field agetime ${R}) | tr -d '[()]' | sed 's/undefined//') # Video length from list

		[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "LIST_NDX:${R} LIST_TITLE:${LIST_TITLE} LIST_AU:${LIST_AU} LIST_TM:${LIST_TM}"

		if [[ -n ${LIST_TITLE[1,50]} ]];then
			[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Attempting TITLE match on:${LIST_TITLE[1,50]}"
			LOG_TITLE=$(grep -F -n -m1 -i -- ${LIST_TITLE[1,50]} ${_YTS_DOWNLOAD_LOG}) # grep -F option needed to ignore any special chars
			if [[ ${?} -eq 0 ]];then
				LINE_NUM="${${(@s/:/)LOG_TITLE}[1]}" # Fetch line number
				LOG_LINE=$(sed -n "${LINE_NUM}p" ${_YTS_DOWNLOAD_LOG}) # Fetch log line
				LOG_AU=$(grep -i -o -m1 "${LIST_AU}$" <<<${LOG_LINE}) # Match author in log line
				LOG_TM=$(grep -o ${LIST_TM} <<<${LOG_LINE}) # Match time in log line

				if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
					dbg "Matched:TITLE:${LOG_TITLE}"
					dbg "Log line:${LOG_LINE}"
					dbg "Author:${LIST_AU} Time:${LIST_TM}"
				fi

				if [[ -n ${LOG_TM} && -n ${LOG_AU} ]];then
					LOG_FN="${${(@s/|/)LOG_LINE}[3]}"
					_DOWNLOADS[${R}]=true

					if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
						dbg "Confirmed match: Marking NDX:${R} as downloaded for file:${LOG_FN}"
						dbg "LOG_AU:${LOG_AU}"
						dbg "LOG_TM:${LOG_TM}"
					fi
				else
					[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Failed to confirm download: LOG_TM:${LOG_TM} LOG_AU:${LOG_AU}"
				fi
			else
				[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "grep failed title match"
			fi
		else
			[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "Skipped title search - blank title"
			logit ${_YT_DBG_LOG} "${0}: Skipped title search - blank title"
		fi
	done
}

log_to_file () { 
	local TOP=${1} # Page top row
	local BOT=${2} # Page bot row
	local FN=''
	local LINE=''
	local LIST_AU=''
	local LIST_TM=''
	local R=0

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# Page callback - pre-process list to populate download status
	 
	_DOWNLOADS=()
	_PARTIALS=()

	for ((R=${TOP}; R <= ${BOT}; R++));do
		LIST_AU=$(get_field author ${R}) # Author from list
		LIST_TM=$(sed -E 's/^.*ago\s+(.*)\)/\1/' <<<$(get_field agetime ${R}) | tr -d '[()]' | sed 's/undefined//') # Video length from list
		LINE=$(grep -i ${LIST_AU} ${_YTS_DOWNLOAD_LOG} 2>/dev/null | grep ${LIST_TM} 2>/dev/null) # Match on author/time
		if [[ -n ${LINE} ]];then 
			FN="${${(@s/|/)LINE}[3]}"
			if [[ -e ${_DOWNLOAD_DIR}/${FN} ]];then
				break
			fi
		fi
	done

	echo ${FN}
}

log_update () {
	local -A SEEN=()
	local FN_HIT=''
	local HAS_NEW_LOG=false
	local INODE=''
	local LINE=''
	local LOG_LINE=''
	local NEW_LOG=${_CFG_DIR}/log.new
	local L

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	{
		[[ -e ${_CFG_DIR}/log.new ]] && /bin/rm -f ${NEW_LOG}
		logit ${_YT_DBG_LOG} "${0}: LOG lines BEFORE update:$(wc -l ${_YTS_DOWNLOAD_LOG})"

		HAS_NEW_LOG=false
		while read -u3 LINE;do
			INODE="${${(@s/|/)LINE}[1]}"
			if [[ ${SEEN[${INODE}]} -eq 1 ]];then
				logit ${_YT_DBG_LOG} "${0}: ERROR Got duplicate inode:${INODE} - skipping duplicates"
				continue
			fi
			SEEN[${INODE}]=1
			FN_HIT=$(find ${_DOWNLOAD_DIR} -maxdepth 1 -inum ${INODE})
			if [[ -n ${FN_HIT} ]];then
				HAS_NEW_LOG=true
				LOG_LINE=$(grep -m1 ${INODE} ${_YTS_DOWNLOAD_LOG} 2>/dev/null)
				[[ ${?} -eq 0 ]] && echo ${LOG_LINE} >> ${NEW_LOG} || logit ${_YT_DBG_LOG} "${0}: ERROR Log line for:${INODE} not found"
			else
				logit ${_YT_DBG_LOG} "${0}: Skipping expired inode:${INODE}"
				SEEN[${INODE}]=1
				continue
			fi
		done 3< ${_YTS_DOWNLOAD_LOG}

		if [[ ${HAS_NEW_LOG} == 'true' ]];then
			cp ${_YTS_DOWNLOAD_LOG} ${_YTS_DOWNLOAD_LOG}.bak
			mv -f ${NEW_LOG} ${_YTS_DOWNLOAD_LOG}
			logit ${_YT_DBG_LOG} "${0}: LOG lines AFTER update:$(wc -l ${_YTS_DOWNLOAD_LOG})"
		else
			/bin/rm -f ${_YTS_DOWNLOAD_LOG} && touch ${_YTS_DOWNLOAD_LOG} # No files present - initialize new log
			logit ${_YT_DBG_LOG} "${0}: Empty log - initializing new log"
		fi
	} 2>/dev/null
}

open_website () {

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${1} in
		y) firefox "https://www.youtube.com/feed/subscriptions" >/dev/null 2>&1 &;;
		r) firefox "https://www.rumble.com/subscriptions" >/dev/null 2>&1 &;;
		*) exit_leave $(err_msg_exit E "Invalid $(opt_type w): Enter y for YouTube, r for Rumble")
	esac
}

parse_err_msg () {
	local ERROR=${@}
	local MSG=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${ERROR:l} in
		*439*) MSG="YouTube - Too Many Requests";;
		*trnsmission*) MSG="Transmission Error";;
		*) MSG=${ERROR[1,50]};;
	esac
	
	echo "|<Z>|${MSG}"
}

parse_rumble () {
	local QRY=${1}
	local -a LIST=()
	local -a QDATA=()
	local -a ROW=()
	local AGE=''
	local AUTHOR=${_QUERY_OPTS[DKEY]}
	local CMD=''
	local DURATION=''
	local ERRS=''
	local LINE=''
	local NDX=0
	local SET=0
	local T3=0
	local TAG=''
	local TCNT=0
	local TNDX=0
	local TEXT=''
	local TITLE=''
	local U=0
	local URL=''
	local K L
	local WGET_OPTS='--user-agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/125.0.0.0 Safari/537.36" --header="Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8" --header="Accept-Language: en-US,en;q=0.5" --header="Referer: https://rumble.com/"'

	# TODO: live broadcasts are seeping in; identify & block

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	# Run query and filter known problem chars
	{
	CMD="wget ${WGET_OPTS} -q -O - "${(qqq)QRY}" | pup '[type="application/json"]' | grep -vw script | jq | sed -e 's/,$//' -e 's/|/#/g'"
	LIST=("${(f)$(eval ${CMD})}")
	} 

	if ! arr_is_populated "${LIST}";then
		logit ${_YT_DBG_LOG} "Command failed: ${CMD} ${LIST}"
		return 1
	fi

	if [[ ${_DEBUG} -ge ${_HIGH_DBG} ]];then
		dbg "CREATED: yts.dbg"
		for L in ${LIST};do
			echo ${L}
		done > "$(date +%s)_yts_rumble.dbg"
	fi
	
	grep -q -m1 'locals_community' <<<${LIST}
	[[ ${?} -eq 0 ]] && TNDX=3 || TNDX=2 # Either sets of 3 titles or sets of 2

	for L in ${LIST};do
		LINE=${L:Q}
		TAG="${LINE%%:*}" # Discard everything past the first colon
		TEXT="${LINE#*:}" # Discard everything before and including the first colon
		case ${LINE} in
			*relative_url:*) continue;;
			*url:*) [[ ${TEXT} =~ "\.html" ]] && QDATA+=${TEXT[2,-1]};; # Skip leading space
			*title:*) (( TCNT++));T3=$(( TCNT % TNDX ));[[ ${T3} -eq 0 ]] && QDATA+=${TEXT[2,-1]};; # Skip leading space
			*duration:*) QDATA+=$(parse_rumble_duration ${TEXT});;
			*upload_date:*) D="${${(@s/T/)TEXT}[1]}";U=$(date -d "${D}" +%s);QDATA+=$(parse_rumble_age ${U});;
		esac
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "--- BEGIN QDATA ---\n$(for K in ${QDATA};do echo ${K};done)\n --- END QDATA ---"

	SET=0
	for L in ${QDATA};do
		(( SET++ ))
		ROW+=${L}
		if [[ $(( SET % 4 )) -eq 0 ]];then # Groups of 4 rows
			[[ ! ${ROW[4]} =~ 'ago' ]] && ROW[2]="PARSE ERROR ${SET}"
			set_rumble_row ${ROW}
			ROW=()
		fi
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: _RUMBLE_ROWS:${#_RUMBLE_ROWS}"

	NDX=0
	for K in ${(onk)_RUMBLE_ROWS};do # Marshall final data
		(( NDX++ ))
		assign_vars 4 ${_RUMBLE_ROWS[${K}]} # URL TITLE DURATION AGE
		_LOCAL_LIST[${NDX}]="${V4}|${AUTHOR}|${V2}|${V1}|${V3}|(${V4} ${V3})"
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}: _LOCAL_LIST:${#_LOCAL_LIST}"
}

parse_rumble_age () {
	local SECS=${1}
	local	DTAG=days
	local	HTAG=hours
	local DAYS=0
	local HOURS=0
	local TODAY=$(date +%s)
	local STAMP=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	DAYS=$(( (TODAY - ${SECS}) / 86400 ))

	if [[ ${DAYS} -eq 0 ]];then
		HOURS=$(( (TODAY - ${SECS}) / 3600 ))
		[[ ${HOURS} -eq 1 ]] && HTAG=hour
		STAMP="${HOURS} ${HTAG} ago"
	else
		[[ ${DAYS} -eq 1 ]] && DTAG=day
		STAMP="${DAYS} ${DTAG} ago"
	fi

	echo ${STAMP}
}

parse_rumble_duration () {
	local SECS=${1}
	local STAMP=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	STAMP=$(strftime "%H:%M:%S" ${SECS})
	[[ ${STAMP} =~ "^00:" ]] && STAMP="${STAMP#*:}" # Discard everything before and including the first colon

	echo ${STAMP}
}

post_process () {
	local -a LIST=()
	local -a PIDS=()
	local -a TEMP_FILES=()
	local FN=''
	local LF=''
	local MSG="Post Processing"
	local NEW_FN=''
	local NDX=0
	local F K

	msg_box -A"${(kv)_INFO_COORDS}" "|<Z>|<g>${MSG}<N>"

	NDX=0
	while true;do
		((NDX++))
		PIDS=("${(f)$(pgrep -n "yt-dlp")}")
		if [[ ${?} -ne 0 ]];then
			sleep 1 && break
		fi
		msg_box -A"${(kv)_INFO_COORDS}" "|<Z>|(<w>${NDX}<N>) Waiting for <c>yt-dlp<N> to finish post-processing..."
		sleep 1
	done

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: Removing any temp.mp4 files"

	TEMP_FILES=("${(f)$(find ${_DOWNLOAD_DIR} -name '*temp.mp4')}")
	for F in ${TEMP_FILES};do
		/bin/rm -f ${F} >/dev/null 2>&1
		[[ ${?} -eq 0 ]] && logit ${_YT_DBG_LOG} "${0}: Deleted ${F}"
	done

	LF=$(last_file_downloaded) # Filename and Inode
	FN="${${(@s/|/)LF}[1]}"
	logit ${_YT_DBG_LOG} "${0}: Last file downloaded:${FN}"

	set_final_fn ${FN}
}

query_rumble () {
	local GEN_SEARCH=''
	local QRY=''
	local QRY_TYPE=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	QRY_TYPE=${_RUMBLE_QTYPES[${_QUERY_OPTS[EOPT]:l}]}
	[[ -z ${QRY_TYPE} ]] && msg_box -p -PK "${0}:Invalid query type:${_QUERY_OPTS[EOPT]}" && return 1

	_QUERY_OPTS[TYPE]=${QRY_TYPE}
	_QUERY_OPTS[QKEY]=${_QUERY_OPTS[QKEY]}

	ping -w1 www.rumble.com >/dev/null 2>&1
	[[ ${?} -ne 0 ]] && msg_box -p -PK "Rumble is down" && return 1

	logit ${_YT_DBG_LOG} "${0}: Creating listing for QKEY:${_QUERY_OPTS[QKEY]} TYPE:${QRY_TYPE}"

	_RUMBLE_ROWS=() # Clear

	# Queries
	if [[ ${QRY_TYPE} == 'live' ]];then
		QRY="https://rumble.com/c/${_QUERY_OPTS[QKEY]}/livestreams"
		msg_box -c "<w>Requesting <c><I>livestream channel<N> <w>search<N>..."
	elif [[ ${QRY_TYPE} == 'channel' ]];then
		QRY="https://rumble.com/c/${_QUERY_OPTS[QKEY]}?page=1"
		msg_box -c "<w>Requesting <c><I>channel<N> <w>search<N>..."
	elif [[ ${QRY_TYPE} == 'user' ]];then
		QRY="https://rumble.com/user/${_QUERY_OPTS[QKEY]}/livestreams"
		msg_box -c "<w>Requesting <c><I>livestream user<N> <w>search<N>..."
	fi

	logit ${_YT_DBG_LOG} "${0}: PARSER:${PARSER}, QUERY:${QRY}"

	if [[ ${_DEBUG} -ge ${_LOW_DBG} ]];then
		dbg "${0}:${LINENO} QKEY:${_QUERY_OPTS[QKEY]}, g_PROXY_CMD:${g_PROXY_CMD}"
	fi

	parse_rumble ${QRY}

	if ! arr_is_populated "${_LOCAL_LIST}";then
		logit ${_YT_DBG_LOG} "${0}: Search returned no rows - QKEY:${_QUERY_OPTS[QKEY]}"
		msg_box -p -PK "Query Returned No Rows"
		return 1
	else
		logit ${_YT_DBG_LOG} "${0}: Listing for QKEY:${_QUERY_OPTS[QKEY]} contains ${#_LOCAL_LIST} rows"
		return 0
	fi
}

query_youtube () {
	local -A FILTER_MSGS=()
	local -A YOUTUBE_MAP=("age" 1 "author" 2 "title" 3 "url" 4 "time" 5)
	local -a LIST=()
	local -a WORK_LIST=()
	local DATA=false
	local DKEY=''
	local HIT=false
	local LINE=''
	local MSG_OUT=false
	local NDX=0
	local PROXY_CMD=''
	local QKEY=''
	local RETRIES=3
	local STR=''
	local STRICT_ARG=''
	local TRY=0
	local AGE AUTHOR TITLE URL TIME AGETIME
	local F L

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	ping -w1 www.youtube.com >/dev/null 2>&1
	[[ ${?} -ne 0 ]] && msg_box -p -PK "YouTube is down" && return 1

	logit ${_YT_DBG_LOG} "${0}: Creating listing for QKEY:${_QUERY_OPTS[QKEY]} STRICT:${_QUERY_OPTS[EOPT]:=null}"
	logit ${_YT_DBG_LOG} "${0}: _QUERY_OPTS: $(for K in ${(ok)_QUERY_OPTS};do printf '%s:%s ' ${K} ${_QUERY_OPTS[${K}]};done)"

	[[ ${_QUERY_OPTS[EOPT]:l} == 's' ]] && STRICT_ARG='-s' || STRICT_ARG=''

	g_PROXY_CMD="node ${_JS_SCRIPT} ${STRICT_ARG} -a ${_QUERY_OPTS[AGE]} ${(qqq)_QUERY_OPTS[QKEY]}" # Quote key
	logit ${_YT_DBG_LOG} "${0}: g_PROXY_CMD:${g_PROXY_CMD}"

	if [[ ${_DEBUG} -ge ${_LOW_DBG} ]];then
		dbg "${0}:${LINENO} YOUTUBE QUERY:${CYAN_FG}_QUERY_OPTS[QKEY]${RESET}:${_QUERY_OPTS[QKEY]}, {CYAN_FG}g_PROXY_CMD${RESET}:${g_PROXY_CMD}"
	fi

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}:${LINENO} ${CYAN_FG}GENERAL SEARCH${RESET}"

	#_YT_OPTS="youtube:lang-en"
	
	while true;do
		(( TRY++ ))
		LIST=("${(f)$(eval ${g_PROXY_CMD} 2>/dev/null)}")
		[[ -n ${LIST} && ${#LIST} -gt 1 ]] && break
		[[ ${TRY} -gt ${RETRIES} ]] && break
		sleep .5
	done

	NDX=0
	for L in ${LIST};do
		((NDX++))

		[[ ${L:l} =~ 'matched' ]] && DATA=true && continue
		[[ ${L:l} =~ 'strict filter' ]] && continue
		[[ ${L:l} =~ 'usage' && ${DATA} != 'true' ]] && exit_leave
		[[ ${L:l} =~ 'error' && ${DATA} != 'true' ]] && exit_leave $(err_msg_exit E "${PROXY_CMD} returned an error")
		[[ ${L:l} =~ 'strict reject' ]] && { _REJECTS[${NDX}]=true && continue } || _REJECTS[${NDX}]=false

		STR=$(str_to_ascii <<<${L}) # Scrub non ascii
		STR=${STR:s/Streamed //} # Strip age of excess text

		# Author verification
		if [[ ${_QUERY_OPTS[EOPT]:l} != 's' && ${g_LAST_FAV_TYPE} != 'c' ]];then # Apply filtering to non strict results unless query is custom
			HIT=false
			AUTHOR="${${(@s/|/)L}[2]}"
			AUTHOR=$(str_to_ascii ${AUTHOR:l})
			QKEY=$(tr -d '[:space:]' <<<${_QUERY_OPTS[QKEY]:l}) # strip spaces for comparison
			DKEY=$(tr -d '[:space:]' <<<${_QUERY_OPTS[DKEY]:l}) # strip spaces for comparison
			if [[ ${AUTHOR} =~ ${QKEY} || ${AUTHOR} =~ ${DKEY} ]];then
				[[ ${MSG_OUT} == 'false' ]] && { msg_box -x4 -t2 "<w>Filtering non-strict query by Author...<N>" && MSG_OUT=true }
				HIT=true
			else
				logit ${_YT_DBG_LOG} "${0}: Rejected:${AUTHOR}"
			fi
		else
			HIT=true
		fi
		 
		if [[ ${DATA} == 'true' && ${_REJECTS[${NDX}]} == 'false' && ${HIT} == 'true' ]];then
			_LOCAL_LIST+=${STR}
		else
			_QUERY_REJECTS+=${STR}
		fi
	done

	if [[ ${#_QUERY_REJECTS} -ne 0 && -n ${AUTHOR} && -n ${QKEY} && -n ${DKEY} ]];then
		msg_box -x3 -t2 "<w>Filtered ${#_QUERY_REJECTS} $(str_pluralize result ${#_QUERY_REJECTS})|<w>${AUTHOR}/<c>${QKEY}/<m>${DKEY}<N>"
	fi

	[[ ${_QUERY_OPTS[EOPT]:l} == 's' ]] && _QUERY_OPTS[SMSG]="$(total_rejects ${#_QUERY_REJECTS})" || _QUERY_OPTS[SMSG]=''

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${0}:${LINENO} _LOCAL_LIST count: ${#_LOCAL_LIST}"

	if ! arr_is_populated "${_LOCAL_LIST}";then
		# Search failed
		if [[ ${#_QUERY_REJECTS} -ne 0 ]];then
			_LOCAL_LIST=(${_QUERY_REJECTS}) # Empty list - show rejects
		else
			[[ ${_QUERY_OPTS[EOPT]:l} == 's' ]] && STR="|<I>Strict filter is active<N>" || STR=''
			msg_box -t2 "<r>Query returned no rows<N>${STR}"
			logit ${_YT_DBG_LOG} "${0}: Search engine returned no rows - QKEY:${_QUERY_OPTS[QKEY]}, STRICT:${_QUERY_OPTS[EOPT]}"
			return 1
		fi
	else
		logit ${_YT_DBG_LOG} "${0}: Query matched ${NDX} lines, _LOCAL_LIST has ${#_LOCAL_LIST} lines"
	fi

	for F in ${_LOCAL_LIST};do
		TITLE="${${(@s/|/)F}[${YOUTUBE_MAP[title]}]}"; TITLE=$(title_scrubber ${TITLE})
		URL="${${(@s/|/)F}[${YOUTUBE_MAP[url]}]}"
		AGE="${${(@s/|/)F}[${YOUTUBE_MAP[age]}]}"
		TIME="${${(@s/|/)F}[${YOUTUBE_MAP[time]}]}"
		AGETIME="(${AGE} ${TIME})"
		AUTHOR="${${(@s/|/)F}[${YOUTUBE_MAP[author]}]}"; AUTHOR=$(keyword_strip <<<${AUTHOR})

		if [[ ${AUTHOR} == 'blancolirio' ]];then # Weird problem workaraound - spanish titles on blancolirio
			if perl -wln -e "if (/\b.*[ae]ntes\b|\bll.*\b|\bel\b|\bya\b|\by\b|\bla\b|\bal\b|\bde\b|\bdel\b|\bque\b|\bpara\b|\bpor\b/) { exit 0 } else { exit 1 }" <<<${TITLE:l};then
				TITLE=$(echo ${TITLE} | trans -brief -no-pager -no-ansi -no-theme es:en 2>/dev/null)
				logit ${_YT_DBG_LOG} "${0}: Translated TITLE:${TITLE}"
			fi
		fi

		WORK_LIST+="${AGE}|${AUTHOR}|${TITLE}|${URL}|${TIME}|${AGETIME}"
	done

	_LOCAL_LIST=(${WORK_LIST})

	logit ${_YT_DBG_LOG} "${0}: Listing for QKEY:${_QUERY_OPTS[QKEY]} contains ${#_LOCAL_LIST} rows"

	return 0
}

set_final_fn () {
	local FN=${1}
	local NEW_FN=''

	logit ${_YT_DBG_LOG} "${0}: FN  IN:${FN}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	NEW_FN=${FN:t:r:gs/_/ /} # Tail, no extension, swap underscore
	NEW_FN=$(clean_title ${NEW_FN}) # Strip problematic chars
	NEW_FN=$(sed "s/${_QUERY_OPTS[QKEY]:l}/${_QUERY_OPTS[DKEY]}/I" <<<${NEW_FN}) # Add creator
	NEW_FN=$(trim_title ${NEW_FN}) # Shorten creator if needed
	NEW_FN=$(perl -pe 's/\.$//g' <<<${NEW_FN}) # Kill any trailing dots
	NEW_FN=$(str_word_clip ${NEW_FN} ${_MAX_FLEN}) # Limit length at word boundary
	NEW_FN="$(str_trim ${FN:h}/${NEW_FN}).${FN:e}" # Restore path and extension

	if [[ ${FN} != ${NEW_FN} ]];then
		[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: Saving changes:${FN:t} -> ${NEW_FN:t}"
		logit ${_YT_DBG_LOG} "${0}: Overwriting file:${FN:t}"
		logit ${_YT_DBG_LOG} "${0}: Clean filename:${NEW_FN:t}"
		mv -f "${FN}" "${NEW_FN}"
		[[ ${?} -ne 0 ]] && logit ${_YT_DBG_LOG} "${0}: Move failed ${FN} to ${NEW_FN}"
	fi

	logit ${_YT_DBG_LOG} "${0}: Directory:${NEW_FN:h}"

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: Cleaned:${FN:t}"
}

set_item_color () {
	local ITEM=${1}

	[[ ${_DEBUG} -ge ${_HIGH_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	case ${ITEM:l} in
		downloaded*) echo ${BOLD}${GREEN_FG};;
		cancelled*) echo ${BOLD}${ITALIC}${RED_FG};;
		failed*) echo ${BOLD}${RED_FG};;
		future*) echo ${BOLD}${CYAN_FG};;
		partial*) echo ${WHITE_ON_GREY};;
		*) echo '';;
	esac
}

set_query_opts () {
	local DKEY=''
	local ENGINE=''
	local ENG_CODE=''
	local ENG_OPT=''
	local FKEY=''
	local FVAL=''
	local MENU_CODE=''
	local OPTS=''
	local QKEY=''
	local QRY_TYPE=''

	FKEY=${_QUERY_OPTS[FKEY]:gs/ /_/} # Normalize FKEY
	FVAL=${_FAV_LIST[${FKEY}]} # _FAV_LIST lookup

	DKEY=${_QUERY_OPTS[FKEY]}
	QKEY="${${(@s/:/)FVAL}[1]}"
	OPTS="${${(@s/:/)FVAL}[2]}"
	MENU_CODE=${OPTS[1]:l}

	if [[ ${MENU_CODE} == 'c' ]];then
		QRY_TYPE=custom # Engine is coded
		ENG_CODE=${OPTS[2]:l}
		ENG_OPT=${OPTS[3]:l}
	else
		QRY_TYPE=standard # Engine matches menu type
		ENG_CODE=${MENU_CODE}
		ENG_OPT=${OPTS[2]:l}
	fi

	case ${ENG_CODE:l} in
		y) ENGINE=youtube;_QUERY_OPTS[EOPT]=${ENG_OPT};;
		r) ENGINE=rumble;_QUERY_OPTS[EOPT]=${ENG_OPT};;
	esac

	_QUERY_OPTS[DKEY]="${(C)DKEY:gs/_/ /}"
	_QUERY_OPTS[QKEY]=${QKEY}
	_QUERY_OPTS[TYPE]=${QRY_TYPE}
	_QUERY_OPTS[ENGINE]=${ENGINE}
}

set_rumble_row () {
	local -a ROW=(${@})
	local AGE=''
	local DURATION=''
	local NDX=0
	local TITLE=''
	local URL=''
	local L

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	for L in ${ROW};do
		(( NDX++ ))
		case ${NDX} in
			1) URL=${L};;
			2) TITLE=${L};;
			3) DURATION=${L};;
			4) AGE=${L};;
		esac

		if [[ $(( NDX % 4 )) -eq 0 ]];then
			(( g_SNDX++ ))
			_RUMBLE_ROWS[${g_SNDX}]="${URL}|${TITLE}|${DURATION}|${AGE}"
		fi
	done
}

total_rejects () {
	local TL_VIDS=${1}
	local TL_RJ=0
	local -F1 RJ_PCT=0
	local K

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	for K in ${(k)_REJECTS};do
		[[ ${_REJECTS[${K}]} == 'true' ]] && ((TL_RJ++))
	done

	TL_VIDS=${TL_VIDS}.00
	TL_RJ=${TL_RJ}.00

	[[ ${TL_RJ} -ne 0 ]] && RJ_PCT=$(( (TL_RJ/TL_VIDS) * 100 ))

	echo "${RJ_PCT}%"
}

trim_title () {
	local STR=${@}
	local AUTHOR="${${(@s/-/)STR}[1]}"
	local TITLE="${${(@s/-/)STR}[2,-1]}"

	if [[ ${#AUTHOR} -le 27 ]];then
		echo ${STR}
	else
		AUTHOR="${${(@s/ /)AUTHOR}[1,2]}"
		echo "${AUTHOR} -${TITLE}"
	fi
}

#--Begin GetOpts--
read -r -d '' DESC<<EOF
Query either Youtube or Rumble for videos.
\tChoose from a list of matching videos. 
EOF

opt_type () {
	local OPT=${1}
	case ${OPT} in
		a) echo "<AGE_FILTER>";;
		s) echo "<SEARCHTERM>";;
		T) echo "<QUERY_TYPE>";;
		w) echo "<SITE_CODE>";;
		u) echo "<URL>";;
	esac
}

parse_opts () {
	local OPTS=${@}
	local -a OPTSTR
	local LETTER_OPT
	local O

	[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "${_SCRIPT:t}->${0}:" "$(dbg_arglist "${@}")"

	for O in {1..${#OPTS}};do
		[[ ${OPTS[${O}]} =~ '[A-Za-z]' ]] && LETTER_OPT=${OPTS[${O}]}
		[[ ${O} -eq 1 && ${OPTS[${O}]} == ":" ]] && continue
		[[ ${O} -gt 1 && ${OPTS[${O}]} == ":" ]] && OPTSTR+=$(opt_type ${LETTER_OPT}) && continue
		OPTSTR+="-${OPTS[${O}]}"
	done
	echo ${OPTSTR}
}

usage () {
	local OPTS=$(parse_opts ${OPTSTR})
	local -a PENDING_MSGS=(${@})

	tabs 5
	[[ ${_SMCUP} == 'true' ]] && do_rmcup

	(
	echo -e "\n${WHITE_FG}Usage${RESET}: ${_SCRIPT} ${OPTS} [$(opt_type s)]\n"
	echo -e "${WHITE_FG}-H${RESET} help"
	echo -e "${WHITE_FG}-D${RESET} debug"
	echo -e "${WHITE_FG}-R${RESET} ${MAGENTA_FG}Rumble${RESET} query [${WHITE_FG}default ${MAGENTA_FG}YouTube${RESET}]"
	echo -e "${WHITE_FG}-T${RESET} $(opt_type T) Rumble query type (l)ive, (c)hannel, (u)ser livestream, (g)eneral [${WHITE_FG}default${RESET}]  (${MAGENTA_FG}Rumble${RESET} only)"
	echo -e "${WHITE_FG}-V${RESET} yt-search version (${MAGENTA_FG}YouTube${RESET} only)"
	echo -e "${WHITE_FG}-a${RESET} $(opt_type a) [all,recent,min,hour,day,week,month,year] (${MAGENTA_FG}YouTube${RESET} only)"
	echo -e "${WHITE_FG}-s${RESET} enable strict filter [author must match query string] (${MAGENTA_FG}YouTube${RESET} only)"
	echo -e "${WHITE_FG}-w${RESET} $(opt_type w) browse website (y)outube (r)umble"
	echo -e "\n${WHITE_FG}DESC${RESET}:${DESC}"
	) >&2

	exit_leave $(err_msg_exit ${PENDING_MSGS})
}

OPTSTR=":HDRT:Va:sw:"
OPTIND=0

ENGINE=youtube
ENG_OPT=''
HELP_OPT=false
SEARCHTERM=''
VERSION_OPT=false
WEB_OPT=''
AGE_OPT=''

while getopts ${OPTSTR} OPTION;do
	case $OPTION in
     H) HELP_OPT=true;;
     D) dbg_set_level;;
     R) ENGINE=rumble;;
     T) ENG_OPT=${OPTARG:l};;
     V) VERSION_OPT=true;;
     a) AGE_OPT=${OPTARG};;
     s) ENG_OPT='s';;
     w) WEB_OPT=${OPTARG};;
     :) print -u2 "${_SCRIPT}: option: -${OPTARG} requires an argument"; usage;;
    \?) print -u2 "${_SCRIPT}: ${BOLD}${RED_FG}Unknown option${RESET} -${OPTARG}"; usage;;
	esac
	[[ ${OPTION} != 'D' ]] && OPTIONS+=${OPTION}
done
shift $(( OPTIND  - 1 ))
#--End GetOpts--

# Execution
if [[ -n ${AGE_OPT} ]];then
	[[ ! ${AGE_OPT} =~ "^(all|recent|min|hour|day|week|month|year)$" ]] && usage "Invalid $(opt_type a):${AGE_OPT}"
else
	[[ ${ENGINE} == 'youtube' ]] && AGE_OPT=recent # Default
fi

[[ -n ${AGE_OPT} ]] && _QUERY_OPTS[AGE]=${AGE_OPT}
[[ -n ${WEB_OPT} ]] && open_website ${WEB_OPT} && exit_leave

[[ ${_DEBUG} -ge ${_LOW_DBG} ]] && dbg "ARGS IN:${@}, ENGINE:${ENGINE}"

CFG_MSG=$(cfg_init)
if [[ ${?} -ne 0 ]];then
	exit_leave $(err_msg_exit "Configuration failed:${CFG_MSG}")
fi

RAWPATH=$(path_get_raw)
FPATH="${${(@s/|/)RAWPATH}[1]}"
FPATH=${FPATH:q}
FGLOB="${${(@s/|/)RAWPATH}[2]}"
PATHLBL=$(path_get_label 40)

# Remove options 
RCL=$(path_get_raw_cmdline | sed "s/${_SCRIPT}//")
for X in ${=RCL};do
	[[ ${X} =~ '[-]' ]] && continue
	_STERMS+=${X}
done

SEARCHTERM=$(str_trim ${_STERMS})
SEARCHTERM=${(Q)SEARCHTERM:l}

# Parse options per engine
if [[ ${ENGINE} == 'youtube' ]];then
   if [[ ${HELP_OPT} == 'true' ]];then
		echo "${MAGE_OPTNTA_FG}$(str_unicode_line 70)${RESET}"
		echo "YouTube backend:${WHITE_ON_GREY}${_JS_SCRIPT}${RESET}\n"
		eval "node ${_JS_SCRIPT} -h" >&2
		echo "\n${MAGE_OPTNTA_FG}$(str_unicode_line 70)${RESET}"
		echo -n "YouTube frontend:${WHITE_ON_GREY}${_SCRIPT}${RESET}\n"
		usage
		exit_leave
	elif [[ ${VERSION_OPT} == 'true'  ]];then
		echo -n "yt-search version:${WHITE_FG}"
		node ${_JS_SCRIPT} --version
		echo ${RESET}
		exit_leave
		[[ ${?} -ne 0 ]] && exit_leave $(err_msg_exit "Invalid argument - valid age arguments:all,min,day,week,month,year")
	elif [[ ${ENG_OPT:l} == 's' ]];then
		SEARCHTERM="-s ${SEARCHTERM}"
	fi
	g_PROXY_CMD="node ${_JS_SCRIPT} ${SEARCHTERM}"
else
	[[ -z ${ENG_OPT} ]] && ENG_OPT=g
	[[ ${_RUMBLE_QRY_OPTS[(i)${ENG_OPT}]} -gt ${#_RUMBLE_QRY_OPTS} ]] && exit_leave $(err_msg_exit "Invalid $(opt_type T): ${ENG_OPT}")
	if [[ ${VERSION_OPT} == 'true'  ]];then
		exit_leave $(err_msg_exit E "Option:-V is a YouTube only option")
	elif [[ -n ${AGE_OPT} ]];then
		exit_leave $(err_msg_exit E "Option:-a is a YouTube only option")
	elif [[ ${ENG_OPT:l} == 's' ]];then
		exit_leave $(err_msg_exit E "Option:-s is a YouTube only option")
	fi
fi

# Check for updates
g_LAST_CODE_UPD=$(last_code_update ${_YTS_UPD_MARKER})
if [[ (! -f ${_YTS_UPD_MARKER}) || (-f ${_YTS_UPD_MARKER} && (! ${g_LAST_CODE_UPD:l} =~ 'today')) ]];then
	clear
	msg_box "Checking for yt-dlp updates..."
	{
		CUR_VER=$(yt-dlp --version)
		yt-dlp -U
		touch ${_YTS_UPD_MARKER}
		UPD_VER=$(yt-dlp --version)
	} >/dev/null 2>&1
	if [[ ${CUR_VER} == ${UPD_VER} ]];then
		MSG="yt-dlp is <g>CURRENT<N> at version:<r>${CUR_VER}<N>"
		msg_box -c -t2 ${MSG}
	else
		MSG="yt-dlp was <w>Updated<N> from: <r>${CUR_VER}<N> to <g>${UPD_VER}<N>"
		msg_box -c -t2 ${MSG}
	fi
fi

# Set callbacks
log_update # Update the log
clear

# Load favorites
if ! fav_load;then
	exit_leave "Unable to load favorites"
fi

# Run Query
[[ ${_DEBUG} -eq 0 ]] && do_smcup

if [[ ${#} -eq 0 ]];then # NO args passed - select from menu
	while true;do
		if fav_get;then
			set_query_opts
			if [[ -n ${_QUERY_OPTS[QKEY]} ]];then
				MSG="Querying <w>${_QUERY_OPTS[ENGINE]}<N> for <B><I><c>${_QUERY_OPTS[DKEY]}<N>..."
				_OB=($(sel_get_interior_coords))
				msg_box -y${_OB[Y]} -w${_OB[W]} ${MSG} # Set msg relative position and width
				[[ ${ENGINE} == 'rumble' ]] && _QUERY_OPTS[EXTRA]=' --impersonate chrome'
				query_${_QUERY_OPTS[ENGINE]} # Call the extractor
				if [[ ${?} -eq 0 ]];then
					download_select ${_QUERY_OPTS[QKEY]}
				fi
			else
				msg_box -p -PK "Failed to get query options|$(msg_list_data $(for K in ${(k)_QUERY_OPTS};do echo "${K}:${_QUERY_OPTS[${K}]}";done))"
			fi
		fi
	done
else # Args passed
	g_CMDLINE_ARGS=true
	_QUERY_OPTS[ENGINE]=${ENGINE:l}
	_QUERY_OPTS[EOPT]=${ENG_OPT:l}
	_QUERY_OPTS[QKEY]=${SEARCHTERM}
	_QUERY_OPTS[DKEY]="${@:gs/_/ /}"
	_QUERY_OPTS[TYPE]=standard
	_QUERY_OPTS[ECODE]=${_ENG_CODES[${ENGINE}]}

	logit ${_YT_DBG_LOG} "_QUERY_OPTS: $(for K in ${(ok)_QUERY_OPTS};do printf '%s:%s ' ${K} ${_QUERY_OPTS[${K}]};done)"
	query_${_QUERY_OPTS[ENGINE]} # Call query

	if [[ ${?} -eq 0 ]];then # Inspect query status
		download_select ${_QUERY_OPTS[QKEY]}
		[[ ${g_CMDLINE_ARGS} == 'true' ]] && fav_add
	else
		exit_leave $(err_msg_exit "Query failed for:${_QUERY_OPTS[QKEY]}")
	fi
fi

log_clear "normal exit"

exit_leave
