#!/usr/bin/zsh

# Imports
[[ -z ${ZSH_LIB_DIR} ]] && _LIB_DIR=/usr/local/lib || _LIB_DIR=${ZSH_LIB_DIR}
source ${_LIB_DIR}/LIB_INIT.zsh
_DEPS+=()
source ${_LIB_DIR}/LIB_DEPS.zsh

# Declarations & Constants
typeset -a AUDIO=()
typeset -a VIDEO=()
typeset -a LIST=()
typeset -a YT_DLP_OPTS=()
typeset -a OPTIONS=()

# Constants
_DOWNLOAD_DIR=~/Downloads/Torrents/Library/Web
_YT_CFG=~/.local/share/yts
_YT_DBG_LOG=${_YT_CFG}/yt.dbg.log
_YT_DLP='/usr/local/bin/yt-dlp'
_YT_URL_LOG=${_YT_CFG}/yt.url.log

_YT_DLP_OPTS+=(
--config-locations ${(qqq)_YT_CFG}
)

# Functions
last_file_downloaded () {
	local ST=''
	local FN=''
	local IN=''

	ST=$(stat -c"%W|%i|%n" ${_DOWNLOAD_DIR}/* | sort -t'|' -k1 -r | head -1) # Sort by birth date; grab most recent
	IN="${${(@s/|/)ST}[2]}"
	FN="${${(@s/|/)ST}[3]}"

	if [[ ${FN:e} == 'mp4' ]];then
		echo "${FN}|${IN}"
		return 0
	else
		return 1
	fi
}

#--Begin GetOpts--
read -r -d '' DESC<<EOF
Manage download from YouTube and Rumble.
\tUse option -p to prepend a label to the filename
EOF

OPTION=''
OPTSTR=''
parse_opts () {
	local OPTS=${@}
	local -a OPTSTR
	local LETTER_OPT
	local O

	for O in {1..${#OPTS}};do
		[[ ${OPTS[${O}]} =~ '[A-Za-z]' ]] && LETTER_OPT=${OPTS[${O}]}
		[[ ${O} -eq 1 && ${OPTS[${O}]} == ":" ]] && continue
		[[ ${O} -gt 1 && ${OPTS[${O}]} == ":" ]] && OPTSTR+=$(opt_type ${LETTER_OPT}) && continue
		OPTSTR+="-${OPTS[${O}]}"
	done
	echo ${OPTSTR}
}

opt_exists () {
	local OPT=${1}
	[[ $(( $OPTIONS[(Ie)${OPT}] )) -ne 0 ]] && return 0 || return 1
}

opt_type () {
	local OPT=${1}
	case ${OPT} in
		a) echo "<AGE_FILTER>";;
		d) echo "<DIR>";;
		f) echo "<FILE>";;
		p) echo "<TEXT>";;
		u) echo "<URL>";;
	esac
}

usage () {
	local -a PENDING_MSGS=(${@})
	local OPTS=$(parse_opts ${OPTSTR})

	[[ ${_SMCUP} == 'true' ]] && do_rmcup

	tabs 5
	(
	echo -e "\n${WHITE_FG}\nUsage${RESET}: ${_SCRIPT} ${WHITE_FG}[${RESET}${OPTS}${WHITE_FG}]${RESET} $(opt_type u)\n"
	echo -e "${WHITE_FG}-H${RESET} help"
	echo -e "${WHITE_FG}-D${RESET} debug (repeats increase level)"
	echo -e "${WHITE_FG}-p $(opt_type t)${RESET}prepend text to filename"
	echo -e "\n${WHITE_FG}DESC${RESET}:${DESC}"
	) >&2

	exit_leave $(err_msg_exit ${PENDING_MSGS})
}
#--End GetOpts--

[[ -t 0 ]] && CMDLINE=true || CMDLINE=false

if [[ ${CMDLINE} == 'true' ]];then
	OPTSTR=":HDp:"
	OPTIND=0
	PREPEND=''

	EXEC_SRC="command line"

	while getopts ${OPTSTR} OPTION;do
		case $OPTION in
		  H) usage;;
		  D) dbg_set_level;;
		  p) PREPEND=${OPTARG} && CMDLINE=true;;
		  :) print -u2 "${_SCRIPT_TAG} ${BOLD}${RED_FG}Option error${RESET}: -${OPTARG} requires an argument"; usage;;
		 \?) print -u2 "${_SCRIPT_TAG} ${BOLD}${RED_FG}Unknown option${RESET} - ${OPTARG}"; usage;;
		esac
		[[ ${OPTION} != 'D' ]] && OPTIONS+=${OPTION}
	done
	shift $((OPTIND -1))
	[[ ${#} -eq 0 ]] && usage 
	ARGS="${(qqq)1}" # Enclose url
else
	EXEC_SRC="script"
	ARGS="${@}"
fi

logit ${_YT_DBG_LOG} "${0:t} Executed from: ${EXEC_SRC}"

CMD="${_YT_DLP} ${_YT_DLP_OPTS} ${ARGS}"

logit ${_YT_DBG_LOG} "${0:t} CMD:${CMD}"
eval "${CMD}"

FN=$(last_file_downloaded)
if [[ ${?} -eq 0 ]];then
	if [[ ${CMDLINE} == 'true' ]];then # CMDLINE processing
		FN="${${(@s/|/)FN}[1]}"
		if [[ -n ${FN} ]];then
			logit ${_YT_DBG_LOG} "${0:t} Cleaning file name:${FN:t}"
			fsub -y -Y ${FN}
			FN="${${(@s/|/)$(last_file_downloaded)}[1]}"
			if [[ -n ${PREPEND} ]];then
				logit ${_YT_DBG_LOG} "Prepending:${PREPEND} to ${FN:t}"
				fsub -y -p ${(C)PREPEND} ${FN}
			fi
		fi
	fi
fi

URL=$(grep -o -E 'http.*' <<<${(qqq)@})
logit ${_YT_URL_LOG} "${0:t} Downloaded URL:${URL[1,-2]} to ${FN:t}"

exit_leave
