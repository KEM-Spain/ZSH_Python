#!/usr/bin/env python
import os
import sys

# Early bootstrap error logger to catch import or startup crashes before logging initializes
def _bootstrap_log(message):
    try:
        log_dir = os.path.expanduser('~/.local/share/ts')
        os.makedirs(log_dir, exist_ok=True)
        with open(os.path.join(log_dir, 'debug.log'), 'a') as f:
            f.write(f"{message}\n")
    except Exception:
        pass

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, Gio, GLib
    from gi.repository.Gtk import ListStore
    from bs4 import BeautifulSoup as Soup
    from bs4 import SoupStrainer as Strainer
    from datetime import datetime
    from logging import handlers
    import getopt
    import logging
    import numpy as np
    import re
    import requests
    import subprocess
    import threading
    import time
except Exception as e:
    _bootstrap_log(f"[FATAL] Import error during startup: {e}")
    raise

# Constants
BOLD = "\033[1m"
DEFAULT_ENGINE = "pb"
ITALIC = "\033[3m"
RED = "\033[0;31m"
RESET = "\033[0m"
REVERSE = "\033[7m"
SCRIPT = os.path.basename(sys.argv[0])
TORRENT_CLIENT = "/usr/bin/deluge"
WHITE = "\033[0;37m"

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
}

SUPPORTED_ENGINES = {
    "pb": "The Pirate Bay",
    "lime": "Lime Torrents",
    "eztv": "Eztv Torrents"
}

ENGINE_URLS = {
    "pb": "https://thepiratebay10.info",
    "lime": "https://www.limetorrents.fun",
    "eztv": "https://eztv.re"
}

USAGE_TXT = """
Usage: {} [-h] [-e <ENGINE>] [<TITLE>]

Options:-h: help
        -e: <ENGINE>

DESC: Search engine for {}
      Enter <TITLE> via gui or on the command line

SUPPORTED ENGINES:
    pb   : The Pirate Bay (default)
    lime : Lime Torrents
    eztv : Eztv Torrents

""".format(SCRIPT, os.path.basename(TORRENT_CLIENT).title())


def app_exit(exit_code=0):
    sys.exit(exit_code)


def ascii_only(string):
    return ''.join(char for char in string if ord(char) < 128)


def get_cmdline():
    try:
        opts, args = getopt.getopt(sys.argv[1:], "he:", ["engine="])
    except getopt.GetoptError as err:
        sys.stderr.write(str(err) + "\n")
        sys.stderr.flush()
        usage()
        return {}, []

    set_opts = {"engine": DEFAULT_ENGINE}
    for o, a in opts:
        if o in ("-h", "--help"):
            usage()
        elif o in ("-e", "--engine"):
            set_opts["engine"] = a
        else:
            assert False, "unhandled option"

    return set_opts, args


def init_logging():
    sys_logger = logging.getLogger("ts_logger")
    sys_logger.setLevel(logging.DEBUG)
    
    log_path = os.path.expanduser('~/.local/share/ts')
    os.makedirs(log_path, exist_ok=True)
    log_file = os.path.join(log_path, 'debug.log')
    
    file_handler = logging.FileHandler(log_file)
    file_handler.setLevel(logging.DEBUG)
    formatter = logging.Formatter('%(asctime)s [%(levelname)s] %(message)s')
    file_handler.setFormatter(formatter)
    sys_logger.addHandler(file_handler)
    
    sys_logger.debug("--- Logging Initialized Successfully ---")
    return sys_logger


def is_number(str_int):
    try:
        float(str_int)
        return True
    except ValueError:
        return False


def set_gtk_theme(gtk_theme):
    settings = Gtk.Settings.get_default()
    settings.set_property("gtk-theme-name", gtk_theme)


def usage():
    sys.stderr.write(USAGE_TXT + "\n")
    sys.stderr.flush()
    app_exit()


class SearchWin(Gtk.Window):
    def __init__(self, engine_key=None, search_term=None):
        super().__init__(title="Torrent Search")
        self.set_modal(True)

        self.engine_key = engine_key or DEFAULT_ENGINE
        self.search_term = search_term
        self.torrent_list = None
        self.model_class = None

        self.set_border_width(15)
        self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
        self.set_resizable(False)
        self.set_default_size(450, 180)

        model_map = {
            "pb": PBModel,
            "lime": LimeModel,
            "eztv": EztvModel
        }
        self.model_class = model_map.get(self.engine_key, PBModel)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        # Header / Engine Switcher
        engine_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        engine_label = Gtk.Label(label="Search Engine:")
        engine_label.set_alignment(0, 0.5)
        
        self.engine_combo = Gtk.ComboBoxText()
        for key, name in SUPPORTED_ENGINES.items():
            self.engine_combo.append(key, name)
        self.engine_combo.set_active_id(self.engine_key)
        self.engine_combo.connect("changed", self.on_engine_changed)

        engine_box.pack_start(engine_label, False, False, 0)
        engine_box.pack_start(self.engine_combo, True, True, 0)

        # Search Entry with Auto-Completion
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Enter search phrase...")
        self.entry.connect("activate", self.on_search)

        self.hist_file = self.init_history_file()
        self.hist_model = Gtk.ListStore(str)
        self.load_history()

        completion = Gtk.EntryCompletion()
        completion.set_model(self.hist_model)
        completion.set_text_column(0)
        completion.set_inline_completion(True)
        self.entry.set_completion(completion)

        # Spinner
        self.spinner = Gtk.Spinner()

        # Action Buttons
        bbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_search = Gtk.Button(label="Search")
        btn_search.connect("clicked", self.on_search)
        
        btn_clear = Gtk.Button(label="Clear History")
        btn_clear.connect("clicked", self.on_clear_history)

        btn_quit = Gtk.Button(label="Quit")
        btn_quit.connect("clicked", lambda w: app_exit())

        bbox.pack_start(btn_search, True, True, 0)
        bbox.pack_start(btn_clear, True, True, 0)
        bbox.pack_start(btn_quit, True, True, 0)

        vbox.pack_start(engine_box, False, False, 0)
        vbox.pack_start(self.entry, False, False, 0)
        vbox.pack_start(self.spinner, False, False, 0)
        vbox.pack_start(bbox, False, False, 0)

        self.add(vbox)
        self.connect("delete-event", lambda w, e: app_exit())

        self.show_all()
        if self.search_term:
            self.entry.set_text(self.search_term)
            self.do_query(self.search_term)
        Gtk.main()

    def init_history_file(self):
        hist_path = os.path.expanduser('~/.ts')
        os.makedirs(hist_path, exist_ok=True)
        hist_file = os.path.join(hist_path, 'hist.txt')
        if not os.path.exists(hist_file):
            with open(hist_file, 'w'):
                pass
        return hist_file

    def load_history(self):
        self.hist_model.clear()
        if os.path.exists(self.hist_file):
            with open(self.hist_file, "r") as fh:
                for line in fh:
                    val = line.strip()
                    if val:
                        self.hist_model.append([val])

    def save_history_item(self, term):
        term = term.strip()
        if not term:
            return
        existing = [row[0] for row in self.hist_model]
        if term in existing:
            existing.remove(term)
        existing.insert(0, term)

        self.hist_model.clear()
        with open(self.hist_file, "w") as fh:
            for item in existing:
                self.hist_model.append([item])
                fh.write(item + "\n")

    def on_engine_changed(self, combo):
        self.engine_key = combo.get_active_id()
        model_map = {
            "pb": PBModel,
            "lime": LimeModel,
            "eztv": EztvModel
        }
        self.model_class = model_map.get(self.engine_key, PBModel)
        self.set_title(f"Torrent Search - {SUPPORTED_ENGINES[self.engine_key]}")

    def on_clear_history(self, button):
        self.hist_model.clear()
        if os.path.exists(self.hist_file):
            os.remove(self.hist_file)
        self.init_history_file()
        self.entry.grab_focus()

    def on_search(self, widget):
        term = self.entry.get_text().strip()
        if not term:
            return
        self.save_history_item(term)
        self.do_query(term)

    def do_query(self, term):
        self.search_term = term
        self.spinner.start()
        self.entry.set_sensitive(False)

        def query_thread():
            try:
                ret, t_list = self.model_class.get_list(term)
            except Exception as e:
                logging.getLogger("ts_logger").exception("Exception occurred during query thread:")
                ret, t_list = 1, None
            GLib.idle_add(self.thread_complete, ret, t_list)

        threading.Thread(target=query_thread, daemon=True).start()

    def thread_complete(self, return_val, torrent_list):
        self.spinner.stop()
        self.entry.set_sensitive(True)
        if return_val == 1 or not torrent_list:
            self.entry.set_text("")
            self.entry.set_placeholder_text("No results found. Try another term.")
        else:
            self.torrent_list = torrent_list
            self.destroy()
            Gtk.main_quit()


class ListingWin(Gtk.Window):
    def __init__(self, torrent_list, engine_key):
        super().__init__(title=f"Torrent Listing - {SUPPORTED_ENGINES[engine_key]}")
        self.torrent_list = torrent_list
        self.engine = engine_key

        self.cancel = False
        self.new_engine = False
        self.download = False
        self.popup_entry = None
        self.selected_titles = None

        self.set_border_width(10)
        self.set_default_size(1050, 450)
        self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)

        titles = [L[0] for L in self.torrent_list]
        magnets = [L[-1] for L in self.torrent_list]
        self.magnet_dict = dict(zip(titles, magnets))

        post_list = np.array(self.torrent_list)
        store_data = post_list[:, :5].tolist()

        self.torrent_list_store = Gtk.ListStore(str, str, int, int, str, float)
        for torrent_ref in store_data:
            f1, f2, f3, f4, f5 = torrent_ref[0], torrent_ref[1], int(torrent_ref[2]), int(torrent_ref[3]), torrent_ref[4]
            if "N/A" in f5:
                s5 = 0
            elif "G" in f5:
                c5 = f5.replace('G', '')
                s5 = float(c5) * 1024 if is_number(c5) else 0
            elif "M" in f5:
                c5 = f5.replace('M', '')
                s5 = float(c5) if is_number(c5) else 0
            elif "K" in f5:
                c5 = f5.replace('KiB', '').replace('KB', '')
                s5 = float(c5) if is_number(c5) else 0
            else:
                s5_clean = re.sub(r'[^0-9.]', '', f5)
                s5 = float(s5_clean) if is_number(s5_clean) else 0

            self.torrent_list_store.append([f1, f2, f3, f4, f5, s5])

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        # Top Control Bar (Engine Switcher & Actions)
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        engine_label = Gtk.Label(label="Engine:")
        self.engine_combo = Gtk.ComboBoxText()
        for key, name in SUPPORTED_ENGINES.items():
            self.engine_combo.append(key, name)
        self.engine_combo.set_active_id(self.engine)
        self.engine_combo.connect("changed", self.on_engine_combo_changed)

        top_bar.pack_start(engine_label, False, False, 0)
        top_bar.pack_start(self.engine_combo, False, False, 0)

        # TreeView Setup
        self.treeview = Gtk.TreeView(model=self.torrent_list_store)
        self.treeview.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        self.treeview.set_cursor(0)
        self.treeview.connect("row-activated", lambda tv, path, col: self.on_download(None))

        renderer_left = Gtk.CellRendererText()
        renderer_right = Gtk.CellRendererText()
        renderer_right.set_property("xalign", 1)

        columns = [
            ("Title", renderer_left, 0, 0),
            ("Date", renderer_right, 1, 1),
            ("Seeds", renderer_right, 2, 2),
            ("Leeches", renderer_right, 3, 3),
            ("Size", renderer_right, 4, 5)
        ]
        for title, renderer, col_idx, sort_idx in columns:
            col = Gtk.TreeViewColumn(title, renderer, text=col_idx)
            col.set_sort_column_id(sort_idx)
            self.treeview.append_column(col)

        scrollable = Gtk.ScrolledWindow()
        scrollable.set_vexpand(True)
        scrollable.add(self.treeview)

        # Bottom Buttons
        bbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_download = Gtk.Button(label="Download Selected")
        btn_download.connect("clicked", self.on_download)
        btn_cancel = Gtk.Button(label="New Search / Cancel")
        btn_cancel.connect("clicked", self.on_cancel)

        bbox.pack_start(btn_download, True, True, 0)
        bbox.pack_start(btn_cancel, True, True, 0)

        vbox.pack_start(top_bar, False, False, 0)
        vbox.pack_start(scrollable, True, True, 0)
        vbox.pack_start(bbox, False, False, 0)

        self.add(vbox)
        self.connect("delete-event", lambda w, e: app_exit())
        self.show_all()
        Gtk.main()

    def on_engine_combo_changed(self, combo):
        new_key = combo.get_active_id()
        if new_key != self.engine:
            self.popup_entry = new_key
            self.new_engine = True
            self.destroy()
            Gtk.main_quit()

    def on_download(self, button):
        self.selected_titles = []
        _, paths = self.treeview.get_selection().get_selected_rows()
        for path in paths:
            p_iter = self.torrent_list_store.get_iter(path)
            if p_iter is not None:
                self.selected_titles.append(self.torrent_list_store.get_value(p_iter, 0))
        if self.selected_titles:
            self.download = True
            self.destroy()
            Gtk.main_quit()

    def on_cancel(self, button):
        self.cancel = True
        self.destroy()
        Gtk.main_quit()


class EztvModel:
    myUrl = ENGINE_URLS["eztv"]

    @staticmethod
    def get_list(search_term):
        log = logging.getLogger("ts_logger")
        url = f"{EztvModel.myUrl}/search/{search_term.replace(' ', '%20')}"
        log.debug(f"[Eztv] Requesting URL: {url}")
        try:
            page = requests.get(url, headers=HEADERS, timeout=10)
            log.debug(f"[Eztv] Response status: {page.status_code}, Length: {len(page.content)}")
        except requests.RequestException as e:
            log.error(f"[Eztv] Request failed: {e}")
            return 1, None

        detail = Strainer('tr', {'class': 'forum_header_border'})
        soup = Soup(page.content.decode('ISO-8859-1', errors='ignore'), features="html.parser", parse_only=detail)
        tds = soup.find_all("td", attrs={"class": "forum_thread_post", "align": "center"})
        log.debug(f"[Eztv] Found {len(tds)} matching tds.")

        a_tags = [td.find_all("a", attrs={"class": "magnet"})[0] for td in tds if td.find_all("a", attrs={"class": "magnet"})]
        links = [a["href"] for a in a_tags]
        raw_titles = [a["title"] for a in a_tags]

        if not raw_titles or all(search_term.lower() not in rt.lower() for rt in raw_titles):
            log.debug("[Eztv] No matching titles found.")
            return 1, None

        titles = [ascii_only(re.sub(r'\[eztv\]|\(.*\)', '', rt.replace('Magnet Link', ''))) for rt in raw_titles]
        sz_age = [str(tag.get_text()).strip() for tag in soup.find_all("td", attrs={"class": "forum_thread_post", "align": "center"}) if not tag.find('a') and len(tag.attrs) == 2]
        
        ages, raw_sizes = [], []
        for i, val in enumerate(sz_age):
            (raw_sizes if i % 2 == 0 else ages).append(val)

        sizes = [sz.replace('GB', 'G').replace('MB', 'M').replace('KB', 'K') for sz in raw_sizes]
        seeds = [sd.get_text().strip() if sd.get_text().strip().isdigit() else 0 for sd in soup.find_all("td", attrs={"align": "center", "class": "forum_thread_post_end"})]
        leeches = [0] * len(seeds)

        torrent_list = [(titles[i], ages[i], seeds[i], leeches[i], sizes[i], links[i]) for i in range(min(len(titles), len(links), len(ages), len(seeds), len(sizes)))]
        log.debug(f"[Eztv] Parsed {len(torrent_list)} torrent items.")
        return 0, torrent_list


class LimeModel:
    myUrl = ENGINE_URLS["lime"]

    @staticmethod
    def get_list(search_term):
        log = logging.getLogger("ts_logger")
        url = f"{LimeModel.myUrl}/search/all/{search_term.replace(' ', '%20')}"
        log.debug(f"[Lime] Requesting URL: {url}")
        try:
            page = requests.get(url, headers=HEADERS, timeout=10)
            log.debug(f"[Lime] Response status: {page.status_code}, Length: {len(page.content)}")
        except requests.RequestException as e:
            log.error(f"[Lime] Request failed: {e}")
            return 1, None

        detail = Strainer('table', {'class': 'table2'})
        soup = Soup(page.content.decode('ISO-8859-1', errors='ignore'), features="html.parser", parse_only=detail)

        divs = soup.find_all("div", attrs={"class": "tt-name"})
        log.debug(f"[Lime] Found {len(divs)} divs with class 'tt-name'.")
        if not divs:
            return 1, None

        titles = [str(div.get_text()).strip() for div in divs]
        age_size = [str(td.get_text()).strip() for td in soup.find_all("td", attrs={"class": "tdnormal"})]
        leeches = [int(lr) if lr.isdigit() else 0 for lr in [str(td.get_text()).strip() for td in soup.find_all("td", attrs={"class": "tdleech"})]]
        seeds = [int(sr) if sr.isdigit() else 0 for sr in [str(td.get_text()).strip() for td in soup.find_all("td", attrs={"class": "tdseed"})]]
        links = [div.a['href'] for div in divs if div.a and 'href' in div.a]

        raw_ages, raw_sizes = [], []
        for i, val in enumerate(age_size):
            (raw_ages if i % 2 == 0 else raw_sizes).append(val)

        ages = [re.sub(r'\s[-]\s.*$', '', ra) for ra in raw_ages]
        sizes = [rs.replace('GB', 'G').replace('MB', 'M').replace('KB', 'K') for rs in raw_sizes]

        torrent_list = [(ascii_only(titles[i]), ages[i], seeds[i], leeches[i], sizes[i], links[i]) for i in range(min(len(titles), len(ages), len(seeds), len(leeches), len(sizes), len(links)))]
        log.debug(f"[Lime] Parsed {len(torrent_list)} torrent items.")
        return 0, torrent_list


class PBModel:
    myUrl = ENGINE_URLS["pb"]

    @staticmethod
    def size_cleaner(sz):
        return sz.replace(u'\xa0', ' ').replace('GiB', 'G').replace('MiB', 'M')

    @staticmethod
    def date_cleaner(dt):
        today = datetime.now()
        dt_text = ascii_only(dt.text.strip())
        date_sects = re.search(r'(\d\d-\d\d)(.*)', dt_text)
        if date_sects:
            d_year = date_sects.group(2).strip()
            d_year = str(today.year) if ":" in d_year or not d_year else d_year
            return d_year + "-" + date_sects.group(1)
        return None

    @staticmethod
    def get_list(search_term):
        log = logging.getLogger("ts_logger")
        url = f"{PBModel.myUrl}/search/{search_term.replace(' ', '%20')}/1/99/0"
        log.debug(f"[PB] Requesting URL: {url}")
        try:
            page = requests.get(url, headers=HEADERS, timeout=10)
            log.debug(f"[PB] Response status: {page.status_code}, Length: {len(page.content)}")
        except requests.RequestException as e:
            log.error(f"[PB] Request failed: {e}")
            return 1, None

        detail = Strainer('table', {'id': 'searchResult'})
        soup = Soup(page.content.decode('ISO-8859-1', errors='ignore'), features="html.parser", parse_only=detail)

        titles, dates = [], []
        for t in soup.find_all("tr"):
            if t.find("td", attrs={"class": "vertTh"}):
                t_list = t.find_all()
                if len(t_list) > 4:
                    titles.append(ascii_only(t_list[2].text.strip()))
                    dates.append(PBModel.date_cleaner(t_list[4]))

        log.debug(f"[PB] Extracted {len(titles)} raw titles.")
        if not titles:
            return 1, None

        links = soup.find_all("a", attrs={"title": re.compile('^Download')})
        tds = soup.find_all("td", attrs={"align": "right"})

        sizes, seeds, leeches = [], [], []
        a, b, c = 0, 1, 2
        while c < len(tds):
            sizes.append(PBModel.size_cleaner(tds[a].text))
            seeds.append(tds[b].text.strip())
            leeches.append(tds[c].text.strip())
            a, b, c = a + 3, b + 3, c + 3

        magnets = [link['href'] for link in links if 'href' in link]
        torrent_list = [(titles[i], dates[i], seeds[i], leeches[i], sizes[i], magnets[i]) for i in range(min(len(titles), len(dates), len(seeds), len(leeches), len(sizes), len(magnets)))]
        log.debug(f"[PB] Parsed {len(torrent_list)} torrent items.")
        return 0, torrent_list


class TorrentRequest:
    def __init__(self, engine_key=None, search_term=None):
        self.engine_key = engine_key
        self.search_term = search_term

        while True:
            search_win = SearchWin(self.engine_key, self.search_term)
            self.engine_key = search_win.engine_key
            self.search_term = search_win.search_term

            if not search_win.torrent_list:
                break

            listing_win = ListingWin(search_win.torrent_list, self.engine_key)

            if listing_win.cancel:
                self.search_term = None
                continue
            elif listing_win.new_engine:
                self.engine_key = listing_win.popup_entry
                continue
            elif listing_win.download:
                for title in listing_win.selected_titles:
                    magnet = listing_win.magnet_dict.get(title)
                    if magnet:
                        subprocess.Popen([TORRENT_CLIENT, magnet], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        time.sleep(1.2)
                app_exit()


if __name__ == "__main__":
    try:
        logger = init_logging()
        sys.excepthook = lambda t, v, tb: logger.error("Uncaught exception", exc_info=(t, v, tb))

        if not os.path.exists(TORRENT_CLIENT):
            sys.stderr.write(f"{BOLD}{RED}Error{RESET}: Torrent client not found at {TORRENT_CLIENT}\n")
            sys.stderr.flush()
            app_exit(1)

        option_dict, CmdLineSearch = get_cmdline()
        CmdLineSearch = ' '.join(CmdLineSearch) if CmdLineSearch else None
        CmdLineEngine = option_dict.get("engine", DEFAULT_ENGINE)

        if CmdLineEngine not in SUPPORTED_ENGINES:
            sys.stderr.write(f"{BOLD}{RED}Error{RESET}: Unsupported engine \"{CmdLineEngine}\"\n")
            sys.stderr.flush()
            app_exit(1)

        set_gtk_theme("Yaru-viridian-dark")
        TorrentRequest(CmdLineEngine, CmdLineSearch)
    except Exception as e:
        _bootstrap_log(f"[FATAL] Uncaught top-level exception: {e}")
        raise