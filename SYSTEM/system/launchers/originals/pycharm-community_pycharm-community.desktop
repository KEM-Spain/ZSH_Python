[Desktop Entry]
X-SnapInstanceName=pycharm-community
Version=1.0
Type=Application
Name=PyCharm
Icon=/snap/pycharm-community/current/bin/pycharm.png
X-SnapAppName=pycharm-community
Exec=/usr/local/bin/system/launchers/run_pycharm-community_pycharm-community %f
Comment=The Only Python IDE you need
Categories=Development;IDE;
Terminal=false
StartupWMClass=jetbrains-pycharm
StartupNotify=true
