  echo "Is partition? $(test -f /sys/class/block/$node/partition && echo YES || echo NO)"\
  echo "Readlink device: $(readlink -f /sys/class/block/$node/device 2>/dev/null)"\
  echo "Readlink parent device: $(readlink -f /sys/class/block/$node/../device 2>/dev/null)"\
done
