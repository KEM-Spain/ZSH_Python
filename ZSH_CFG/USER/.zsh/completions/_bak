#compdef bak

_bak() {
    _arguments -s \
        '-H[help]' \
        '-D[debug]' \
        '-B[diff <DEVELOPMENT> <> <BACKUP>]' \
        '-P[diff <DEVELOPMENT> <> <PRODUCTION>]' \
        '-b[copy <DEVELOPMENT>]' \
        '-i[show the target directories]' \
        '-r[release <DEVELOPMENT>]' \
        '-s[save <PRODUCTION>]' \

        _files -W ${PWD} ${0}
}

