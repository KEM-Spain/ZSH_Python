#compdef vut

_vut() {
    local context curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '-H[help]' \
        '-D[debug]' \
        '1: :->cmds' \
        '*::arg:->args'

    case "$state" in
        cmds)
            _values "Commands:" \
                "info[Display video information]" \
                "length[Display video length]" \
                "merge[Merge videos]" \
                "rescale[Rescale videos]" \
                "dts2ac3[Convert DTS audio to AC3]" \
                "volume[Increase volume by 3db]"
            ;;
        args)
            case ${line[1]} in
                info) _do_info ;;
                length) _do_length ;;
                merge) _do_merge ;;
                rescale) _do_rescale ;;
                dts2ac3) _do_dts2ac3 ;;
                volume) _do_volume ;;
            esac
            ;;
    esac
}

_do_info() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}

_do_length() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}

_do_merge() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}

_do_rescale() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}

_do_dts2ac3() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}

_do_volume() {
    _arguments -s \
        '-H[help]' \
        '*:file:_files -W ${PWD}'
}
