: 1792173695:0;	local TITLE=${@}
: 1792173695:0;	local -A SEEN=()
: 1792173695:0;	local -a UCASE_WORDS=()
: 1792173695:0;	local STR="${TITLE}"
: 1792173695:0;	local UCASE_LIMIT=4
: 1792173695:0;	local PLURAL=''
: 1792173695:0;	local W U
: 1792173695:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${functrace[1]} called ${0}:${LINENO}: TITLE:${TITLE}"
: 1792173696:0;	STR="$(fix_mojibake "${STR}")"
: 1792173696:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${0}: fix_mojibake STR:${STR}"
: 1792173696:0;	UCASE_WORDS=("${(f)$(grep -E -o -- '\b([[:upper:]]|[0-9])+\b' <<<${STR})}")
: 1792173696:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${0}: UCASE_WORDS:${UCASE_WORDS}"
: 1792173696:0;	STR=${(C)STR} # Proper case
: 1792173696:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${0}: Proper case STR:${STR}"
: 1792173697:0;	# Fix Zsh capitalization forcing letters after apostrophes to uppercase (e.g., Trump'S -> Trump's)
: 1792173697:0;	STR=$(echo "${STR}" | perl -pe "s/'([A-Z])/'\L\$1/g" 2>/dev/null)
: 1792173697:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${0}: Lowercase post-apostrophe STR:${STR}"
: 1792173697:0;	# Structural formatting (underscores, braces, dots) - explicitly keeping apostrophes safe
: 1792173697:0;	STR=$(echo "${STR}" | perl -pe 's/_/ /g' 2>/dev/null)
: 1792173697:0;	STR=$(echo "${STR}" | perl -pe 's/\-?\[.*//' | str_trim 2>/dev/null)
: 1792173697:0;	STR=$(echo "${STR}" | perl -pe 's/\.{2,}$//g' 2>/dev/null)
: 1792173697:0;	[[ ${_DEBUG} -ge ${_MID_DBG} ]] && dbg "${0}: uscore, brace, dots STR:${STR}"
